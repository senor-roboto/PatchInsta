+/** Instagram 439 has a full rounded/clipping dispatch with an R8 handler, not
+ * the old four-instruction helper call. Do not interpret that obfuscated CFG.
+ * Instead, when the already-scoped runtime lease asks for a clean cover card,
+ * jump to Instagram's own plain fallback: super.dispatchDraw(Canvas); return.
+ * Every unleased instance executes Instagram's original method byte-for-byte. */
+internal fun installRoundedCardEntryBypass(draw: MutableMethod, superclass: String) {
+    val body = requireNotNull(draw.implementation) { "Fold: rounded card has no draw implementation" }
+    val code = body.instructions.toList()
+    require(draw.definingClass == ROUNDED_CARD && draw.name == "dispatchDraw"
+            && draw.parameterTypes == listOf(CANVAS) && draw.returnType == "V"
+            && draw.accessFlags and AccessFlags.STATIC.value == 0) {
+        "Fold: unsupported RoundedCornerFrameLayout dispatchDraw identity"
+    }
+    val self = body.registerCount - 2
+    require(self > 0) { "Fold: RoundedCornerFrameLayout has no local register for entry guard" }
+    val fallback = code.withIndex().filter { (index, insn) ->
+        if (!isInvoke(insn.opcode, Opcode.INVOKE_SUPER, Opcode.INVOKE_SUPER_RANGE)) false
+        else {
+            val ref = (insn as? ReferenceInstruction)?.reference as? MethodReference
+            val next = code.drop(index + 1).firstOrNull { it.opcode != Opcode.NOP }
+            ref?.definingClass == superclass && ref.name == "dispatchDraw"
+                && ref.parameterTypes == listOf(CANVAS) && ref.returnType == "V"
+                && invokeRegisters(insn) == listOf(self, self + 1)
+                && next?.opcode == Opcode.RETURN_VOID
+        }
+    }
+    require(fallback.size == 1) {
+        "Fold: RoundedCornerFrameLayout plain dispatch fallback changed; " +
+            "candidates=${fallback.size}; opcodes=${code.map { it.opcode }}"
+    }
+    draw.addInstructionsWithLabels(0, """
+        invoke-static/range {p0 .. p0}, Lapp/morphe/extension/instagram/patches/reels/FoldReels;->skipRoundedCardDecoration(Landroid/view/View;)Z
+        move-result v0
+        if-nez v0, :fold_plain_rounded_dispatch
+    """, app.morphe.patcher.util.smali.ExternalLabel(
+        "fold_plain_rounded_dispatch", fallback.single().value))
+}
