+/** Instagram 439 no longer has the old four-instruction dispatchDraw body. The
+ * real method performs rounded clipping/setup, calls super, restores the canvas,
+ * and paints the rounded edge under an R8 handler. For a leased cover wrapper,
+ * bypass the whole RoundedCornerFrameLayout override and call its superclass
+ * directly; for every other instance execute Instagram's method byte-for-byte.
+ * This avoids guessing obfuscated helper calls while still preserving children. */
+internal fun installRoundedCardEntryBypass(draw: MutableMethod, superclass: String) {
+    val body = requireNotNull(draw.implementation) { "Fold: rounded card has no draw implementation" }
+    val code = body.instructions.toList()
+    require(draw.definingClass == ROUNDED_CARD && draw.name == "dispatchDraw"
+            && draw.parameterTypes == listOf(CANVAS) && draw.returnType == "V"
+            && draw.accessFlags and AccessFlags.STATIC.value == 0) {
+        "Fold: unsupported RoundedCornerFrameLayout dispatchDraw identity"
+    }
+    val self = body.registerCount - 2
+    require(self > 0 && code.any {
+        isInvoke(it.opcode, Opcode.INVOKE_SUPER, Opcode.INVOKE_SUPER_RANGE)
+    }) { "Fold: RoundedCornerFrameLayout has no usable local/super dispatch" }
+
+    // v0 is a local register (parameters are the final two registers). The
+    // native path immediately resumes at the original first instruction, so
+    // Instagram initializes its locals exactly as before.
+    draw.addInstructionsWithLabels(0, """
+        invoke-static/range {p0 .. p0}, Lapp/morphe/extension/instagram/patches/reels/FoldReels;->skipRoundedCardDecoration(Landroid/view/View;)Z
+        move-result v0
+        if-eqz v0, :fold_native_rounded_dispatch
+        invoke-super/range {p0 .. p1}, $superclass->dispatchDraw($CANVAS)V
+        return-void
+        :fold_native_rounded_dispatch
+        nop
+    """)
+}
