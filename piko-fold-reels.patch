+        @Override protected void onBoundsChange(Rect bounds) { drawing.setBounds(bounds); }
+        @Override public Rect getDirtyBounds() { Rect result = new Rect(dirty); result.union(getBounds()); return result; }
+        @Override public boolean getPadding(Rect padding) { return nativeDrawable.getPadding(padding); }
+        @Override public int getIntrinsicWidth() { return nativeDrawable.getIntrinsicWidth(); }
+        @Override public int getIntrinsicHeight() { return nativeDrawable.getIntrinsicHeight(); }
+        @Override public int getMinimumWidth() { return nativeDrawable.getMinimumWidth(); }
+        @Override public int getMinimumHeight() { return nativeDrawable.getMinimumHeight(); }
+        @Override public boolean isStateful() { return drawing.isStateful(); }
+        @Override protected boolean onStateChange(int[] state) { return drawing != null && drawing.setState(state); }
+        @Override protected boolean onLevelChange(int level) { return drawing.setLevel(level); }
+        @Override public void draw(Canvas canvas) {
+            Rect b = getBounds(); if (b.width() == 0 || b.height() == 0 || target.isEmpty()) return;
+            draws++; canvas.getClipBounds(lastCanvasClip); lastDrawTarget.set(target);
+            int edges = FoldReelsContrast.edges(nativeDrawable);
+            // Translation and horizontal expansion only: retain the native distance over
+            // which contrast fades. For a two-edge composite, retain each native half;
+            // additional space between the transparent halves stays transparent.
+            if (edges == FoldReelsContrast.BOTH) {
+                float half = Math.min(target.height(), b.height())/2f;
+                paint(canvas, b, target.top, target.top + half, target.top - b.top);
+                paint(canvas, b, target.bottom-half, target.bottom, target.bottom-b.bottom);
+            } else {
+                float y = edges == FoldReelsContrast.BOTTOM ? target.bottom-b.bottom : target.top-b.top;
+                paint(canvas, b, target.top, target.bottom, y);
+            }
+        }
+        private void paint(Canvas canvas, Rect b, float top, float bottom, float y) {
+            if (bottom <= top) return;
+            int save = canvas.save();
+            try { canvas.clipRect(target.left, top, target.right, bottom);
+                canvas.translate(target.left, y); canvas.scale(target.width()/b.width(), 1);
+                canvas.translate(-b.left, 0); drawing.draw(canvas);
+            } finally { canvas.restoreToCount(save); }
+        }
+        @Override public void setAlpha(int alpha) { drawing.setAlpha(alpha); invalidateSelf(); }
+        @Override public int getAlpha() { return drawing.getAlpha(); }
+        @Override public void setColorFilter(android.graphics.ColorFilter filter) { drawing.setColorFilter(filter); invalidateSelf(); }
+        @Override public int getOpacity() { return android.graphics.PixelFormat.TRANSLUCENT; }
+        @Override public void invalidateDrawable(Drawable who) { invalidateSelf(); }
+        @Override public void scheduleDrawable(Drawable who, Runnable what, long when) { scheduleSelf(what, when); }
+        @Override public void unscheduleDrawable(Drawable who, Runnable what) { unscheduleSelf(what); }
+    }
+}
