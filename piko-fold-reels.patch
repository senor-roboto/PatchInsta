+package com.instagram.ui.widget.roundedcornerlayout;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.widget.FrameLayout;
+import app.morphe.extension.instagram.patches.reels.FoldReels;
+
+/** Synthetic painter with the observed native class name. No Instagram implementation/media. */
+public class RoundedCornerFrameLayout extends FrameLayout {
+    public final Paint stroke = new Paint();
+    public int childrenDraws, decorationDraws;
+    public RoundedCornerFrameLayout(Context context) { super(context); stroke.setColor(0xffff0000); stroke.setStyle(Paint.Style.STROKE); stroke.setStrokeWidth(2); }
+    @Override protected void dispatchDraw(Canvas canvas) {
+        super.dispatchDraw(canvas); childrenDraws++;
+        if (!FoldReels.skipRoundedCardDecoration(this)) {
+            decorationDraws++; canvas.drawRect(1,1,getWidth()-1,getHeight()-1,stroke);
+        }
+    }
+}
