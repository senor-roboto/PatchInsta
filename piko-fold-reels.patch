+    FoldReels.Watcher.Tracker start() { FoldReels.attachViewer(viewer); FoldReels.Watcher.Tracker t=FoldReels.watcher.trackers.get(activity); t.onPreDraw(); return t; }
+    String state(FoldReels.Watcher.Tracker t) {
