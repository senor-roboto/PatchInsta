+                .append(FoldReelsChrome.resourceName(view)).append(' ').append(view.getWidth()).append('x')
+                .append(view.getHeight()).append('@').append(xy[0]).append(',').append(xy[1])
+                .append(" vis=").append(view.getVisibility())
+                .append(" scale=").append(view.getScaleX()).append(',').append(view.getScaleY())
+                .append(" bg=").append(view.getBackground() == null ? "none" : view.getBackground().getClass().getSimpleName())
+                .append(" clip=").append(view.getClipBounds()).append('\n');
