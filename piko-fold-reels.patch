@@ -0,0 +1,42 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.view.View;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.WeakHashMap;
+
+/** Reversible INVISIBLE leases. No view is retained by its state; detach restores immediately. */
+final class FoldReelsVisibility implements View.OnAttachStateChangeListener {
+    private final WeakHashMap<View, State> states = new WeakHashMap<>();
+    private long frame;
+    void begin() { frame++; }
+    void hide(View view) {
+        if (view == null || !view.isAttachedToWindow()) return;
+        State state = states.get(view);
+        if (state == null) {
+            state = new State(); state.nativeVisibility = view.getVisibility();
+            states.put(view, state); view.addOnAttachStateChangeListener(this);
+        } else if (view.getVisibility() != View.INVISIBLE) state.nativeVisibility = view.getVisibility();
+        state.used = frame;
+        // A native GONE remains GONE. We never create a layout-changing GONE transition.
+        if (view.getVisibility() == View.VISIBLE) view.setVisibility(View.INVISIBLE);
+    }
+    void end() {
+        for (Iterator<Map.Entry<View, State>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, State> entry = it.next();
+            if (entry.getValue().used != frame || !entry.getKey().isAttachedToWindow()) {
+                release(entry.getKey(), entry.getValue()); it.remove();
+            }
+        }
+    }
+    int size() { return states.size(); }
+    void restore() { for (Map.Entry<View, State> entry : states.entrySet()) release(entry.getKey(), entry.getValue()); states.clear(); }
+    private void release(View view, State state) {
+        if (view.getVisibility() == View.INVISIBLE) view.setVisibility(state.nativeVisibility);
+        view.removeOnAttachStateChangeListener(this);
+    }
+    @Override public void onViewAttachedToWindow(View view) {}
+    @Override public void onViewDetachedFromWindow(View view) { State state = states.remove(view); if (state != null) release(view, state); }
+    private static final class State { int nativeVisibility; long used; }
+}
