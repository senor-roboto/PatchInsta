+            for (WeakReference<View> ref : extras) { View v=ref.get(); if(v!=null && FoldReelsViews.descendant(v,row)) visibility.hide(v); }
+        }
+        void restore() { avatar.restore(); name.restore(); follow.restore(); }
+    }
+    private static final class Part implements View.OnAttachStateChangeListener {
+        final WeakReference<View> view; final State state=new State(); final RectF bounds=new RectF(); final Matrix matrix=new Matrix();
+        boolean observing;
+        Part(View v) { view=new WeakReference<>(v); }
+        void move(float left, float top) {
+            View v=view.get(); if (!observing) { v.addOnAttachStateChangeListener(this); observing=true; }
+            state.capture(v); FoldReelsViews.bounds(v,bounds,matrix);
+            bounds.offset(state.x-v.getTranslationX(),state.y-v.getTranslationY());
+            state.ax=state.x+left-bounds.left; state.ay=state.y+top-bounds.top;
+            if(Math.abs(v.getTranslationX()-state.ax)>.01f)v.setTranslationX(state.ax);
+            if(Math.abs(v.getTranslationY()-state.ay)>.01f)v.setTranslationY(state.ay); state.moved=true;
+        }
+        void restore() { View v=view.get(); if(v!=null) { state.restore(v); v.removeOnAttachStateChangeListener(this); } observing=false; }
+        @Override public void onViewAttachedToWindow(View v) {}
+        @Override public void onViewDetachedFromWindow(View v) { restore(); }
+    }
+}
