+++ b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReels.java
@@ -0,0 +1,106 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.app.Activity;
+import android.app.Application;
+import android.content.ComponentCallbacks;
+import android.content.Context;
+import android.content.res.Configuration;
+import android.os.Bundle;
+import android.view.View;
+import java.lang.ref.WeakReference;
+import java.util.HashMap;
+import java.util.Map;
+import app.morphe.extension.crimera.sharedPreference.SharedPref;
+import app.morphe.extension.instagram.settings.Settings;
+import app.morphe.extension.shared.Utils;
+
+/**
+ * Observes window configuration on the UI thread. Flag reads use a volatile enum:
+ * no Activity/View access on Instagram's background configuration threads.
+ * A flag already cached by Instagram may require reopening the Reels viewer.
+ */
+public final class FoldReels {
+    private static volatile boolean installed;
+    private static volatile FoldReelsPolicy.WindowKind kind = FoldReelsPolicy.WindowKind.UNKNOWN;
+    private static final Watcher watcher = new Watcher();
+
+    private FoldReels() {}
+
+    public static synchronized void install() {
+        if (installed) return; // Piko currently invokes HookFlags.load twice.
+        Context context = Utils.getContext();
+        if (context == null) return;
+        Context app = context.getApplicationContext();
+        if (!(app instanceof Application)) return;
+        ((Application) app).registerActivityLifecycleCallbacks(watcher);
+        installed = true;
+    }
+
+    public static Boolean override(String key) {
+        if (!installed) return null; // Bundling the sources does not activate the patch.
+        return FoldReelsPolicy.override(key, kind,
+                SharedPref.getBooleanPref(Settings.ADAPTIVE_FOLD_REELS),
+                SharedPref.getBooleanPref(Settings.FOLD_REELS_COVER_CROP));
+    }
+
+    private static final class Watcher implements Application.ActivityLifecycleCallbacks {
+        private final Map<Activity, Tracker> trackers = new HashMap<>();
+        private WeakReference<Activity> foreground = new WeakReference<>(null);
+
+        private void activate(Activity activity) {
+            foreground = new WeakReference<>(activity);
+            Tracker tracker = trackers.get(activity);
+            if (tracker == null) {
+                tracker = new Tracker(activity);
+                trackers.put(activity, tracker);
+                activity.registerComponentCallbacks(tracker);
+                activity.getWindow().getDecorView().addOnLayoutChangeListener(tracker);
+            }
+            tracker.capture();
+        }
+
+        // Available on Android 10+: provides geometry before Activity.onCreate reads flags.
+        @Override public void onActivityPreCreated(Activity activity, Bundle state) { activate(activity); }
+        @Override public void onActivityCreated(Activity activity, Bundle state) { activate(activity); }
+        @Override public void onActivityPreResumed(Activity activity) { activate(activity); }
+        @Override public void onActivityResumed(Activity activity) { activate(activity); }
+        @Override public void onActivityStarted(Activity activity) {}
+        @Override public void onActivityPaused(Activity activity) {
+            if (foreground.get() == activity) {
+                foreground.clear();
+                kind = FoldReelsPolicy.WindowKind.UNKNOWN;
+            }
+        }
+        @Override public void onActivityStopped(Activity activity) {}
+        @Override public void onActivitySaveInstanceState(Activity activity, Bundle state) {}
+        @Override public void onActivityDestroyed(Activity activity) {
+            Tracker tracker = trackers.remove(activity);
+            if (tracker != null) {
+                activity.unregisterComponentCallbacks(tracker);
+                activity.getWindow().getDecorView().removeOnLayoutChangeListener(tracker);
+            }
+            if (foreground.get() == activity) {
+                foreground.clear();
+                kind = FoldReelsPolicy.WindowKind.UNKNOWN;
+            }
+        }
+
+        private final class Tracker implements ComponentCallbacks, View.OnLayoutChangeListener {
+            private final WeakReference<Activity> owner;
+            Tracker(Activity activity) { owner = new WeakReference<>(activity); }
+            void capture() {
+                Activity activity = owner.get();
+                if (activity == null || foreground.get() != activity) return;
+                Configuration configuration = activity.getResources().getConfiguration();
+                // Activity resources reflect this app window, including split-screen and density.
+                // Do not use smallestScreenWidthDp: that cannot distinguish the two Fold windows.
+                kind = FoldReelsPolicy.classify(configuration.screenWidthDp, configuration.screenHeightDp);
+            }
+            @Override public void onConfigurationChanged(Configuration configuration) { capture(); }
+            @Override public void onLowMemory() {}
+            @Override public void onLayoutChange(View v, int l, int t, int r, int b,
+                    int oldL, int oldT, int oldR, int oldB) { capture(); }
+        }
+    }
+}
