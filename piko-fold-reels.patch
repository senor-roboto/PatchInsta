+    /** Recovery at the actual viewer draw boundary, even if a constructor/attach
+     * notification used an incomplete Context or a replaced ViewTreeObserver.
+     * Steady state is O(ancestors), with no tree scan, relayout or second render. */
+    public static void beforeViewerDraw(View view) {
+        if (!view.isAttachedToWindow()) return;
+        try {
+            Activity a = activityOf(view);
+            Watcher.Tracker t = watcher.trackers.get(a);
+            if (t == null || !t.hasViewer(view) || !t.observerCurrent()) {
+                attachViewer(view);
+                t = watcher.trackers.get(activityOf(view));
+                if (t != null) t.onPreDraw(); // First drawn frame, not a reload.
+            }
+        } catch (RuntimeException error) {
+            Logger.printException(() -> "PatchInsta: viewer bootstrap deferred", error);
+        }
+    }
+
+    /** Injected into dispatchTouchEvent of the known Reels viewer only. */
+    public static boolean routeTouch(View viewer, MotionEvent event) {
+        if (Build.VERSION.SDK_INT < 29 || !isEnabled()) return false;
+        beforeViewerDraw(viewer);
