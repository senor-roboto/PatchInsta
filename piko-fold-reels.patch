+            transparent |= Color.alpha(color) == 0;
+            if (Color.alpha(color) > 0 && (Color.red(color) > 64 || Color.green(color) > 64 || Color.blue(color) > 64)) return -1;
+        }
+        if (!transparent) return -1;
+        int result = (Color.alpha(colors[0]) > 0 ? TOP : 0) | (Color.alpha(colors[colors.length-1]) > 0 ? BOTTOM : 0);
+        if (g.getOrientation() == GradientDrawable.Orientation.BOTTOM_TOP) result = ((result & TOP) << 1) | ((result & BOTTOM) >> 1);
+        return result == 0 ? -1 : result;
+    }
+    static boolean rounded(GradientDrawable g) {
+        if (g.getCornerRadius() > 0) return true;
+        try { float[] radii = g.getCornerRadii(); if (radii != null) for (float r : radii) if (r > 0) return true; }
+        catch (NullPointerException unsetOnApi29) { /* An unset array means no individual radii. */ }
+        return false;
+    }
+    static Drawable copy(Drawable nativeDrawable, boolean square) {
+        if (nativeDrawable.getConstantState() == null) return null;
+        Drawable result = nativeDrawable.getConstantState().newDrawable().mutate();
+        if (square) square(result, 0);
