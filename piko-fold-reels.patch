--- /dev/null
+++ b/patches/src/main/kotlin/app/crimera/patches/instagram/misc/reels/AdaptiveFoldReelsPatch.kt
@@ -0,0 +1,117 @@
+/*
+ * Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE.
+ */
+package app.crimera.patches.instagram.misc.reels
+
+import app.crimera.patches.instagram.misc.settings.settingsPatch
+import app.crimera.patches.instagram.misc.overflowMenuButton.reels.hookReelOverflowMenuButton
+import app.crimera.patches.instagram.utils.Constants.COMPATIBILITY_INSTAGRAM
+import app.crimera.patches.instagram.utils.addFlags
+import app.crimera.patches.instagram.utils.enableSettings
+import app.morphe.patcher.patch.bytecodePatch
+import app.morphe.patcher.extensions.InstructionExtensions.addInstructionsWithLabels
+import app.morphe.patcher.util.proxy.mutableTypes.MutableMethod
+import app.morphe.patcher.util.smali.toInstruction
+import app.morphe.util.findFreeRegister
+import com.android.tools.smali.dexlib2.AccessFlags
+import com.android.tools.smali.dexlib2.builder.MethodImplementationBuilder
+import com.android.tools.smali.dexlib2.immutable.ImmutableMethod
+import com.android.tools.smali.dexlib2.immutable.ImmutableMethodParameter
+import app.morphe.patcher.Fingerprint
+import app.morphe.patcher.extensions.InstructionExtensions.addInstruction
+import app.morphe.patcher.extensions.InstructionExtensions.instructions
+import com.android.tools.smali.dexlib2.Opcode
+
+private object FoldReelsViewerConstructors : Fingerprint(
+    definingClass = "Linstagram/features/clips/viewer/ui/ClipsSwipeRefreshLayout;",
+    name = "<init>",
+    returnType = "V",
+)
+
+@Suppress("unused")
+val adaptiveFoldReelsPatch = bytecodePatch(
+    name = "Adaptive Fold Reels",
+    description = "Adds live video framing, a one-tap crop toggle and optional immersive cover display. " +
+        "Cold-start bootstrap, per-screen presentation presets and reversible native controls.",
+    default = false,
+) {
+    // Deliberately inherits the pinned Piko target, 439.0.0.37.89 / arm64.
+    // Do not broaden compatibility without auditing the MobileConfig mappings.
+    compatibleWith(COMPATIBILITY_INSTAGRAM)
+    dependsOn(settingsPatch, hookReelOverflowMenuButton)
+    execute {
+        enableSettings("adaptiveFoldReels")
+        addFlags("adaptiveFoldReelsFlags")
+        // Reuse the exact viewer class already targeted by Piko's Disable Reels scrolling patch.
+        // A constructor hook detects actual Reels without guessing resource IDs or traversing the app.
+        val constructors = FoldReelsViewerConstructors.matchAll(1..Int.MAX_VALUE).toList()
+        constructors.forEach { match ->
+            match.method.apply {
+                val returns = instructions.withIndex()
+                    .filter { it.value.opcode == Opcode.RETURN_VOID }
+                    .map { it.index }
+                returns.asReversed().forEach { index ->
+                    addInstruction(index,
+                        "invoke-static/range {p0 .. p0}, " +
+                            "Lapp/morphe/extension/instagram/patches/reels/FoldReels;->attachViewer(Landroid/view/View;)V")
+                }
+            }
+        }
+        // Route moved controls at the real viewer dispatch boundary. Native sheets above the
+        // viewer retain priority; unrelated gestures use the original implementation.
+        val viewerClass = mutableClassDefBy(constructors.first().method.definingClass)
+        // The actual first draw is an independent bootstrap opportunity. The extension
+        // repairs a missed registration/window observer, then is a cheap no-op per frame.
+        var draw = viewerClass.methods.firstOrNull {
+            it.name == "dispatchDraw" && it.parameterTypes == listOf("Landroid/graphics/Canvas;") && it.returnType == "V"
+        }
+        if (draw == null) {
+            val body = MethodImplementationBuilder(2).apply {
+                addInstruction("invoke-super {v0, v1}, ${viewerClass.superclass}->dispatchDraw(Landroid/graphics/Canvas;)V".toInstruction())
+                addInstruction("return-void".toInstruction())
+            }.methodImplementation
+            draw = MutableMethod(ImmutableMethod(viewerClass.type, "dispatchDraw",
+                listOf(ImmutableMethodParameter("Landroid/graphics/Canvas;", emptySet(), null)),
+                "V", AccessFlags.PROTECTED.value, emptySet(), emptySet(), body))
+            viewerClass.methods.add(draw)
+        }
+        draw.addInstruction(0,
+            "invoke-static/range {p0 .. p0}, Lapp/morphe/extension/instagram/patches/reels/FoldReels;->beforeViewerDraw(Landroid/view/View;)V")
+        // The device report identifies this native page class. Its border is custom
+        // post-children drawing, invisible to background/foreground inspection.
+        val rounded = mutableClassDefBy(ROUNDED_CARD)
+        val roundedDraw = rounded.methods.single { it.name == "dispatchDraw"
+            && it.parameterTypes == listOf("Landroid/graphics/Canvas;") && it.returnType == "V" }
+        val helperRef = roundedCardHelper(roundedDraw, rounded.superclass!!)
+        val helper = mutableClassDefBy(helperRef.definingClass).methods.single { it.name == helperRef.name
+            && it.parameterTypes == helperRef.parameterTypes && it.returnType == helperRef.returnType }
+        installRoundedCardHook(roundedDraw, rounded.superclass!!, helper)
+        var dispatch = viewerClass.methods.firstOrNull {
+            it.name == "dispatchTouchEvent" && it.parameterTypes == listOf("Landroid/view/MotionEvent;") && it.returnType == "Z"
+        }
+        if (dispatch == null) {
+            val body = MethodImplementationBuilder(3).apply {
+                addInstruction("invoke-super {v1, v2}, ${viewerClass.superclass}->dispatchTouchEvent(Landroid/view/MotionEvent;)Z".toInstruction())
+                addInstruction("move-result v0".toInstruction())
+                addInstruction("return v0".toInstruction())
+            }.methodImplementation
+            dispatch = MutableMethod(ImmutableMethod(viewerClass.type, "dispatchTouchEvent",
+                listOf(ImmutableMethodParameter("Landroid/view/MotionEvent;", emptySet(), null)),
+                "Z", AccessFlags.PUBLIC.value, emptySet(), emptySet(), body))
+            viewerClass.methods.add(dispatch)
+        }
+        dispatch.apply {
+            val viewerRegister = implementation!!.registerCount - 2
+            val eventRegister = implementation!!.registerCount - 1
+            val free = findFreeRegister(0, viewerRegister, eventRegister)
+            addInstructionsWithLabels(0, """
+                invoke-static/range {p0 .. p1}, Lapp/morphe/extension/instagram/patches/reels/FoldReels;->routeTouch(Landroid/view/View;Landroid/view/MotionEvent;)Z
+                move-result v$free
+                if-eqz v$free, :fold_native_touch
+                return v$free
+                :fold_native_touch
+                nop
+            """)
+        }
+    }
+}
diff --git a/patches/src/main/kotlin/app/crimera/patches/instagram/misc/reels/RoundedCardHook.kt b/patches/src/main/kotlin/app/crimera/patches/instagram/misc/reels/RoundedCardHook.kt
new file mode 100644
index 0000000..43dd2c8
--- /dev/null
+++ b/patches/src/main/kotlin/app/crimera/patches/instagram/misc/reels/RoundedCardHook.kt
@@ -0,0 +1,80 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.crimera.patches.instagram.misc.reels
+
+import app.morphe.patcher.extensions.InstructionExtensions.addInstructionsWithLabels
+import app.morphe.patcher.util.proxy.mutableTypes.MutableMethod
+import com.android.tools.smali.dexlib2.Opcode
+import com.android.tools.smali.dexlib2.AccessFlags
+import com.android.tools.smali.dexlib2.iface.Method
+import com.android.tools.smali.dexlib2.iface.instruction.ReferenceInstruction
+import com.android.tools.smali.dexlib2.iface.instruction.TwoRegisterInstruction
+import com.android.tools.smali.dexlib2.iface.instruction.FiveRegisterInstruction
+import com.android.tools.smali.dexlib2.iface.reference.FieldReference
+import com.android.tools.smali.dexlib2.iface.reference.MethodReference
+
+internal const val ROUNDED_CARD = "Lcom/instagram/ui/widget/roundedcornerlayout/RoundedCornerFrameLayout;"
+private const val CANVAS = "Landroid/graphics/Canvas;"
+
+/** Verify the actual APK, not obfuscated helper names copied from another Instagram build.
+ * Only super.dispatchDraw; load helper; helper.draw(Canvas); return is accepted.
+ * Never skip super.dispatchDraw (the native player, metadata and listeners). */
+internal fun roundedCardHelper(draw: Method, superclass: String): MethodReference {
+    val body = requireNotNull(draw.implementation) { "Fold: rounded card has no draw implementation" }
+    val code = body.instructions.toList()
+    require(draw.definingClass == ROUNDED_CARD && draw.name == "dispatchDraw"
+            && draw.parameterTypes == listOf(CANVAS) && draw.returnType == "V"
+            && draw.accessFlags and AccessFlags.STATIC.value == 0
+            && body.tryBlocks.isEmpty()
+            && code.map { it.opcode } == listOf(Opcode.INVOKE_SUPER, Opcode.IGET_OBJECT, Opcode.INVOKE_VIRTUAL, Opcode.RETURN_VOID)) {
+        "Fold: unsupported RoundedCornerFrameLayout dispatchDraw; refusing to bypass unknown native drawing"
+    }
+    val self = body.registerCount - 2
+    val superCall = code[0] as FiveRegisterInstruction
+    val superRef = (code[0] as ReferenceInstruction).reference as MethodReference
+    val field = code[1] as TwoRegisterInstruction
+    val fieldRef = (code[1] as ReferenceInstruction).reference as FieldReference
+    val call = code[2] as FiveRegisterInstruction
+    val target = (code[2] as ReferenceInstruction).reference as MethodReference
+    require(superCall.registerCount == 2 && superCall.registerC == self && superCall.registerD == self + 1
+            && superRef.definingClass == superclass && superRef.name == "dispatchDraw"
+            && superRef.parameterTypes == listOf(CANVAS) && superRef.returnType == "V"
+            && field.registerB == self && field.registerA < self && fieldRef.definingClass == ROUNDED_CARD
+            && call.registerCount == 2 && call.registerC == field.registerA && call.registerD == self + 1
+            && target.definingClass == fieldRef.type && target.parameterTypes == listOf(CANVAS) && target.returnType == "V") {
+        "Fold: rounded card draw dataflow changed"
+    }
+    return target
+}
+
+internal fun installRoundedCardHook(draw: MutableMethod, superclass: String, helper: Method) {
+    val ref = roundedCardHelper(draw, superclass)
+    require(helper.definingClass == ref.definingClass && helper.name == ref.name
+            && helper.parameterTypes == ref.parameterTypes && helper.returnType == "V")
+    val code = requireNotNull(helper.implementation).instructions.toList()
+    // This helper draws the corner mask and the stroke using Paint/Path. Reject side effects,
+    // text/image drawing, nested helper calls or a future player implementation here.
+    val readsAndBranches = setOf(Opcode.IGET, Opcode.IGET_OBJECT, Opcode.CONST_4, Opcode.CONST_16,
+        Opcode.CONST, Opcode.CMPL_FLOAT, Opcode.CMPG_FLOAT, Opcode.IF_LEZ, Opcode.IF_GEZ,
+        Opcode.IF_LTZ, Opcode.IF_GTZ, Opcode.IF_EQZ, Opcode.IF_NEZ, Opcode.GOTO, Opcode.GOTO_16,
+        Opcode.RETURN_VOID, Opcode.NOP, Opcode.INVOKE_VIRTUAL)
+    require(code.all { it.opcode in readsAndBranches } && helper.implementation!!.tryBlocks.isEmpty()) {
+        "Fold: rounded card helper is no longer a read-only corner/stroke painter"
+    }
+    val calls = code.filter { it.opcode == Opcode.INVOKE_VIRTUAL }
+    require(calls.size == 2 && calls.all {
+        val method = (it as ReferenceInstruction).reference as? MethodReference
+        method?.definingClass == CANVAS && method.name == "drawPath"
+            && method.parameterTypes == listOf("Landroid/graphics/Path;", "Landroid/graphics/Paint;") && method.returnType == "V"
+    }) { "Fold: rounded card helper does not exclusively draw the corner mask and stroke" }
+    // Reuse the helper register immediately BEFORE its native iget initializes it.
+    // Both branches are type-safe; parameters and the children's draw are untouched.
+    val local = (draw.implementation!!.instructions.toList()[1] as TwoRegisterInstruction).registerA
+    draw.addInstructionsWithLabels(1, """
+        invoke-static/range {p0 .. p0}, Lapp/morphe/extension/instagram/patches/reels/FoldReels;->skipRoundedCardDecoration(Landroid/view/View;)Z
+        move-result v$local
+        if-eqz v$local, :fold_native_corners
+        return-void
+        :fold_native_corners
+        nop
+    """)
+}
diff --git a/patches/src/main/kotlin/app/morphe/util/VerifyFoldBundle.kt b/patches/src/main/kotlin/app/morphe/util/VerifyFoldBundle.kt
