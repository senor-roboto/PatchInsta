+        int seen; Drawable bg, fg; float elevation; boolean background, foreground, shadow;
+        void apply(View v) {
+            if (background && v.getBackground() != null) { background = false; bg = null; }
+            if (foreground && v.getForeground() != null) { foreground = false; fg = null; }
+            if (rounded(v.getBackground(), 0)) { bg = v.getBackground(); v.setBackground(null); background = true; }
+            if (rounded(v.getForeground(), 0)) { fg = v.getForeground(); v.setForeground(null); foreground = true; }
+            if (!background && !foreground && shadow) {
+                if (v.getElevation() == 0) v.setElevation(elevation);
+                shadow = false;
+            }
+            if ((background || foreground) && v.getElevation() != 0) { elevation = v.getElevation(); v.setElevation(0); shadow = true; }
+        }
+        void restore(View v) {
+            if (background && v.getBackground() == null) v.setBackground(bg);
+            if (foreground && v.getForeground() == null) v.setForeground(fg);
+            if (shadow && v.getElevation() == 0) v.setElevation(elevation);
+            bg = fg = null; background = foreground = shadow = false;
+        }
+    }
+}
