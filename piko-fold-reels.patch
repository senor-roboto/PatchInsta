+                    View view = it.next().get();
+                    if (view == null) { it.remove(); continue; }
+                    if (view.isAttachedToWindow() && view.isShown() && view.getWidth() > 0 && view.getHeight() > 0
+                            && view.getGlobalVisibleRect(bounds)
+                            && FoldReelsGeometry.mostlyVisible((float) view.getWidth() * view.getHeight(),
+                                    (float) bounds.width() * bounds.height())) {
