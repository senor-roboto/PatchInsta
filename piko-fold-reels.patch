+        Watcher.Tracker tracker = watcher.trackers.get(activityOf(viewer.getContext()));
+        if (tracker == null || !tracker.presentable(viewer) || tracker.failures.containsKey("controls")) return false;
+        try { return tracker.controls.routeTouch(viewer, event); }
+        catch (RuntimeException error) {
+            tracker.controls.restore(); tracker.failures.put("controls", error.getClass().getName());
+            Logger.printException(() -> "PatchInsta 4.1: native control routing restored after an error", error);
+            return false;
+        }
+    }
