+import org.robolectric.annotation.GraphicsMode;
+import static org.junit.Assert.*;
+
+/** Actual Android Canvas/Skia rasterization of synthetic Views, not Samsung HWUI/SurfaceFlinger. */
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=29, manifest=Config.NONE, qualifiers="w1000dp-h1600dp-mdpi")
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+public class FoldReelsDrawingTest extends FoldReelsTestFixture {
+    final FoldReelsScrim scrim=new FoldReelsScrim(FoldReelsTestFixture::name);
+    @After public void restoreScrims(){scrim.restore();}
+    GradientDrawable gradient(int...colors){return new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,colors);}
+    void apply(){renderer.discover(viewer);scrim.discover(renderer,viewer);clipping.beginFrame();clipping.openBoundary(content);scrim.frame(viewer,bounds(content),content,true,clipping);clipping.endFrame();}
+    Bitmap draw(){content.setBackgroundColor(Color.WHITE);for(View video:videos)video.setVisibility(View.INVISIBLE);
+        Bitmap bitmap=Bitmap.createBitmap(1000,1600,Bitmap.Config.ARGB_8888);content.draw(new Canvas(bitmap));return bitmap;}
+    @Test public void headerBackgroundActuallyPaintsToTheTopAndSidesWithoutTintingItsNativeButton(){
+        FrameLayout row=new FrameLayout(activity);row.setBackground(gradient(0xAA000000,Color.TRANSPARENT));add(viewer,row,106,100,788,200);
+        View button=new View(activity);button.setBackgroundColor(Color.GREEN);button.setClickable(true);add(row,button,40,40,60,60);
+        apply();Bitmap bitmap=draw();assertTrue(Color.red(bitmap.getPixel(20,5))<200);assertTrue(Color.red(bitmap.getPixel(980,5))<200);
+        RectF b=bounds(button),root=bounds(content);assertEquals(Color.GREEN,bitmap.getPixel(Math.round(b.centerX()-root.left),Math.round(b.centerY()-root.top)));
+        scrim.restore();clipping.restore();Bitmap nativeImage=draw();assertEquals(Color.WHITE,nativeImage.getPixel(20,5));
+    }
+    @Test public void bottomForegroundPaintsBelowTheOldCardAndDoesNotLeaveAVerticalSeam(){
+        FrameLayout row=new FrameLayout(activity);GradientDrawable original=gradient(Color.TRANSPARENT,0xAA000000);original.setCornerRadius(18);original.setStroke(1,Color.RED);
+        row.setForeground(original);add(pages.get(1),row,106,1100,788,220);add(row,new View(activity),0,0,20,20);
+        apply();Bitmap bitmap=draw();assertTrue(Color.red(bitmap.getPixel(20,1590))<220);assertTrue(Color.red(bitmap.getPixel(980,1590))<220);
+        assertEquals(bitmap.getPixel(104,1250),bitmap.getPixel(108,1250));assertEquals(bitmap.getPixel(892,1250),bitmap.getPixel(896,1250));
+        scrim.restore();assertSame(original,row.getForeground());assertEquals(18,original.getCornerRadius(),.01f);
+    }
+    @Test public void adjacentForegroundsKeepPaintingThroughOldPageClipsDuringASwipe(){
+        for(FrameLayout page:pages){FrameLayout card=new FrameLayout(activity);card.setForeground(gradient(0xAA000000,Color.TRANSPARENT,0xAA000000));
+            add(page,card,106,70,788,1260);add(card,new View(activity),0,0,10,10);}
+        swipe(700);apply();Bitmap bitmap=draw();
+        // Current card's native bottom is 630; its visual bottom is 800. Next native top is 770; visual top is 800.
+        assertTrue(Color.red(bitmap.getPixel(20,750))<200);assertTrue(Color.red(bitmap.getPixel(20,850))<200);
