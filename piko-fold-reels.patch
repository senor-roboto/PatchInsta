+    static final class Watcher implements Application.ActivityLifecycleCallbacks {
+        final Map<Activity, Tracker> trackers = new WeakHashMap<>();
+        WeakReference<Activity> foreground = new WeakReference<>(null);
+        Tracker tracker(Activity activity) {
+            Tracker result = trackers.get(activity);
+            if (result == null) { result = new Tracker(activity); trackers.put(activity, result); }
+            return result;
+        }
+        void captureForeground() { Activity a = foreground.get(); if (a != null) tracker(a).capture(); }
