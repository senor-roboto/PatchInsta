@@ -0,0 +1,33 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.util
+
+import app.morphe.patcher.patch.loadPatchesFromJar
+import com.google.gson.GsonBuilder
+import java.io.File
+import java.util.jar.JarFile
+
+/** Load the actual compiled bundle with Morphe's loader, before advertising it to Manager. */
+fun main(args: Array<String>) {
+    val bundle = File("build/libs").listFiles { file -> file.extension == "mpp" }!!.single()
+    val version = JarFile(bundle).use { it.manifest.mainAttributes.getValue("Version") }
+    check(version == args.single()) { "Bundle manifest version does not match Gradle" }
+    val patches = loadPatchesFromJar(setOf(bundle))
+    val fold = patches.single { it.name == "Adaptive Fold Reels" }
+    val instagram = fold.compatibility!!.single { it.packageName == "com.instagram.android" }
+    check(instagram.targets.single().version == "439.0.0.37.89")
+    check(instagram.targets.single().versionCodes!!.values.single() == 384510827)
+    check(fold.dependencies.isNotEmpty())
+    val list = patches.filter { it.name != null }.sortedBy { it.name }.map { patch ->
+        mapOf(
+            "name" to patch.name, "description" to patch.description, "default" to patch.default,
+            "compatiblePackages" to patch.compatibility?.map { compat ->
+                mapOf("packageName" to compat.packageName, "name" to compat.name,
+                    "apkFileType" to compat.apkFileType?.name,
+                    "targets" to compat.targets.map { target ->
+                        mapOf("version" to target.version, "versionCodes" to target.versionCodes?.mapKeys { it.key.name })
+                    })
+            })
+    }
+    File("../patches-list.json").writeText(GsonBuilder().setPrettyPrinting().create().toJson(mapOf("version" to version, "patches" to list)))
+    println("Morphe loader verified ${patches.size} patches, Adaptive Fold Reels and Instagram 439.0.0.37.89 / 384510827")
+}
