@@ -0,0 +1,59 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.graphics.Matrix;
+import android.graphics.RectF;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewParent;
+
+final class FoldReelsViews {
+    private FoldReelsViews() {}
+    static void bounds(View view, RectF out, Matrix matrix) {
+        out.set(0, 0, view.getWidth(), view.getHeight());
+        matrix.reset(); view.transformMatrixToGlobal(matrix); matrix.mapRect(out);
+    }
+    static boolean descendant(View view, View ancestor) {
+        for (View v = view; v != null; v = v.getParent() instanceof View ? (View) v.getParent() : null)
+            if (v == ancestor) return true;
+        return false;
+    }
+    static boolean unitParents(View view, View boundary) {
+        for (View v = view; v != null; v = v.getParent() instanceof View ? (View) v.getParent() : null) {
+            if (Math.abs(v.getRotation()) > .01f || Math.abs(v.getRotationX()) > .01f || Math.abs(v.getRotationY()) > .01f) return false;
+            if (v != view && (Math.abs(v.getScaleX() - 1) > .001f || Math.abs(v.getScaleY() - 1) > .001f)) return false;
+            if (v == boundary) return true;
+        }
+        return false;
+    }
+    static float pageOffset(View page, View viewer, float height, RectF work, Matrix matrix) {
+        if (page.getHeight() <= 0) return Float.NaN;
+        bounds(page, work, matrix); float top = work.top;
+        View parent = page.getParent() instanceof View ? (View) page.getParent() : viewer;
+        if (classIs(parent, "androidx.recyclerview.widget.RecyclerView")
+                || classIs(parent, "androidx.viewpager.widget.ViewPager")) {
+            bounds(parent, work, matrix);
+            return FoldReelsGeometry.pageOffset(top - work.top - parent.getPaddingTop(), page.getHeight(), height);
+        }
+        bounds(viewer, work, matrix);
+        return FoldReelsGeometry.pageOffset(top - work.top, page.getHeight(), height);
+    }
+    static boolean classIs(View view, String name) {
+        for (Class<?> c = view.getClass(); c != null; c = c.getSuperclass()) if (c.getName().equals(name)) return true;
+        return false;
+    }
+    /** Prefer an actual pager item over a video wrapper that merely has a similar height. */
+    static View page(View surface, View viewer) {
+        View fallback = null;
+        for (View child = surface; child != viewer && child.getParent() instanceof View; ) {
+            View parent = (View) child.getParent();
+            if (classIs(parent, "androidx.recyclerview.widget.RecyclerView")
+                    || classIs(parent, "androidx.viewpager.widget.ViewPager")) return child;
+            if (fallback == null && child instanceof ViewGroup
+                    && Math.abs(child.getHeight() - viewer.getHeight()) <= viewer.getHeight() * .08f)
+                fallback = child; // Never promote this to a shared pager container farther up the tree.
+            child = parent;
+        }
+        return fallback;
+    }
+}
