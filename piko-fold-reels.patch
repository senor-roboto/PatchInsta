+++ b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReels.java
@@ -0,0 +1,308 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import static app.morphe.extension.instagram.utils.IgStr.str;
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.app.Application;
+import android.content.ComponentCallbacks;
+import android.content.Context;
+import android.content.ContextWrapper;
+import android.content.res.Configuration;
+import android.graphics.Rect;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.view.View;
+import android.widget.Toast;
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.WeakHashMap;
+import app.morphe.extension.crimera.sharedPreference.SharedPref;
+import app.morphe.extension.instagram.settings.Settings;
+import app.morphe.extension.shared.Utils;
+import app.morphe.extension.shared.Logger;
+
+/** Native flags plus a scoped, debounced recreation of the Activity hosting visible Reels. */
+public final class FoldReels {
+    private static volatile boolean installed;
+    private static volatile FoldReelsPolicy.WindowKind kind = FoldReelsPolicy.WindowKind.UNKNOWN;
+    private static final Watcher watcher = new Watcher();
+    private static final WeakHashMap<View, Boolean> observedViewers = new WeakHashMap<>();
+
+    private FoldReels() {}
+
+    public static synchronized void install() {
+        if (installed) return; // Piko invokes HookFlags.load twice.
+        Context context = Utils.getContext();
+        if (context == null) return;
+        Context app = context.getApplicationContext();
+        if (!(app instanceof Application)) return;
+        ((Application) app).registerActivityLifecycleCallbacks(watcher);
+        installed = true;
+    }
+
+    public static boolean isEnabled() {
+        return installed && SharedPref.getBooleanPref(Settings.ADAPTIVE_FOLD_REELS);
+    }
+
+    public static Boolean override(String key) {
+        if (!installed || !FoldReelsPolicy.handles(key)) return null;
+        // UI-thread flag queries can happen before our layout/configuration callback.
+        // Refresh before returning the flag; background callers only read the volatile snapshot.
+        if (Looper.myLooper() == Looper.getMainLooper()) watcher.captureForeground();
+        return FoldReelsPolicy.override(key, kind, isEnabled(),
+                SharedPref.getBooleanPref(Settings.FOLD_REELS_COVER_CROP),
+                SharedPref.getBooleanPref(Settings.FOLD_REELS_INNER_CROP));
+    }
+
+    private static Activity activityOf(Context context) {
+        for (int depth = 0; context != null && depth < 20; depth++) {
+            if (context instanceof Activity) return (Activity) context;
+            if (!(context instanceof ContextWrapper)) return null;
+            Context next = ((ContextWrapper) context).getBaseContext();
+            if (next == context) return null;
+            context = next;
+        }
+        return null;
+    }
+
+    /** Injected only into constructors of Instagram's known ClipsSwipeRefreshLayout. */
+    public static void attachViewer(View view) {
+        if (Looper.myLooper() != Looper.getMainLooper()) {
+            view.post(() -> attachViewer(view));
+            return;
+        }
+        if (observedViewers.containsKey(view)) return; // Constructor chaining.
+        observedViewers.put(view, true);
+        view.addOnAttachStateChangeListener(new View.OnAttachStateChangeListener() {
+            @Override public void onViewAttachedToWindow(View v) { watcher.addViewer(v); }
+            @Override public void onViewDetachedFromWindow(View v) { watcher.removeViewer(v); }
+        });
+        if (view.isAttachedToWindow()) watcher.addViewer(view);
+    }
+
+    public static void showLayoutOptions(Context context) {
+        Activity activity = activityOf(context);
+        if (activity == null) activity = watcher.foreground.get();
+        if (activity == null || activity.isFinishing() || activity.isDestroyed() || !isEnabled()) return;
+        final Activity owner = activity;
+        CharSequence[] options = {
+                str("piko_fold_reels_inner_fit"), str("piko_fold_reels_inner_crop")
+        };
+        new AlertDialog.Builder(owner)
+                .setTitle(str("piko_fold_reels_menu_title"))
+                .setSingleChoiceItems(options,
+                        SharedPref.getBooleanPref(Settings.FOLD_REELS_INNER_CROP) ? 1 : 0,
+                        (dialog, which) -> {
+                            boolean saved = SharedPref.setBooleanPref(
+                                    Settings.FOLD_REELS_INNER_CROP.key, which == 1);
+                            dialog.dismiss();
+                            if (saved) watcher.manualRefresh(owner);
+                        })
+                .setNeutralButton(str("piko_fold_reels_refresh_now"),
+                        (dialog, which) -> watcher.manualRefresh(owner))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static final class Watcher implements Application.ActivityLifecycleCallbacks {
+        private final Map<Activity, Tracker> trackers = new HashMap<>();
+        private WeakReference<Activity> foreground = new WeakReference<>(null);
+        private final Handler handler = new Handler(Looper.getMainLooper());
+
+        private Tracker tracker(Activity activity) {
+            Tracker tracker = trackers.get(activity);
+            if (tracker == null) {
+                tracker = new Tracker(activity);
+                trackers.put(activity, tracker);
+            }
+            return tracker;
+        }
+
+        private void activate(Activity activity, boolean attachObservers) {
+            foreground = new WeakReference<>(activity);
+            Tracker tracker = tracker(activity);
+            if (attachObservers) tracker.attachObservers();
+            tracker.capture();
+        }
+
+        private void captureForeground() {
+            Activity activity = foreground.get();
+            if (activity != null) {
+                Tracker tracker = trackers.get(activity);
+                if (tracker != null) tracker.capture();
+            }
+        }
+
+        private void addViewer(View view) {
+            Activity activity = activityOf(view.getContext());
+            if (activity == null) return;
+            Tracker tracker = tracker(activity);
+            for (WeakReference<View> ref : tracker.viewers) if (ref.get() == view) return;
+            tracker.viewers.add(new WeakReference<>(view));
+            tracker.capture();
+        }
+
+        private void removeViewer(View view) {
+            Activity activity = activityOf(view.getContext());
+            Tracker tracker = trackers.get(activity);
+            if (tracker == null) return;
+            tracker.viewers.removeIf(ref -> ref.get() == null || ref.get() == view);
+            // A detach/reattach may be part of a fold: do not reset the pending transition here.
+        }
+
+        private void manualRefresh(Activity activity) {
+            // Let Instagram's overflow menu and the options dialog dismiss before recreating.
+            handler.postDelayed(() -> {
+                Tracker tracker = trackers.get(activity);
+                if (tracker != null && tracker.resumed && foreground.get() == activity
+                        && !activity.isFinishing() && !activity.isDestroyed() && isEnabled()) {
+                    tracker.recreate();
+                }
+            }, 300);
+        }
+
+        @Override public void onActivityPreCreated(Activity activity, Bundle state) {
+            // Never create decor before Instagram requests its window features/theme.
+            activate(activity, false);
+        }
+        @Override public void onActivityCreated(Activity activity, Bundle state) { activate(activity, true); }
+        @Override public void onActivityPreResumed(Activity activity) { activate(activity, true); }
+        @Override public void onActivityResumed(Activity activity) {
+            activate(activity, true);
+            tracker(activity).resumed = true;
+            tracker(activity).capture();
+        }
+        @Override public void onActivityStarted(Activity activity) {}
+        @Override public void onActivityPaused(Activity activity) {
+            Tracker tracker = trackers.get(activity);
+            if (tracker != null) {
+                tracker.resumed = false;
+                tracker.cancelCheck();
+            }
+            // Keep the latest known geometry. Pausing during a fold must not restore native defaults.
+        }
+        @Override public void onActivityStopped(Activity activity) {}
+        @Override public void onActivitySaveInstanceState(Activity activity, Bundle state) {}
+        @Override public void onActivityDestroyed(Activity activity) {
+            Tracker tracker = trackers.remove(activity);
+            if (tracker != null) tracker.dispose();
+            if (foreground.get() == activity) foreground.clear();
+            // Preserve the last valid snapshot until the replacement Activity supplies its own.
+        }
+
+        private final class Tracker implements ComponentCallbacks, View.OnLayoutChangeListener {
+            private final WeakReference<Activity> owner;
+            private final ArrayList<WeakReference<View>> viewers = new ArrayList<>();
+            private final FoldReelsRefreshGate gate = new FoldReelsRefreshGate();
+            private boolean observersAttached;
+            private boolean resumed;
+            private boolean checkPosted;
+            private boolean recreating;
+            private boolean seenViewer;
+            private final Rect visibleBounds = new Rect();
+            private final Runnable check = this::checkTransition;
+
+            private void checkTransition() {
+                checkPosted = false;
+                capture();
+                Activity activity = owner.get();
+                if (activity == null || foreground.get() != activity || recreating) return;
+                View focus = activity.getCurrentFocus();
+                if (focus != null && focus.onCheckIsTextEditor()) {
+                    // Do not automatically disrupt a comment/message being typed.
+                    cancelCheck();
+                    return;
+                }
+                if (gate.ready(SystemClock.uptimeMillis(), resumed, hasVisibleViewer(),
+                        isEnabled() && SharedPref.getBooleanPref(Settings.FOLD_REELS_AUTO_REFRESH))) {
+                    recreate();
+                }
+            }
+
+            Tracker(Activity activity) { owner = new WeakReference<>(activity); }
+
+            void attachObservers() {
+                Activity activity = owner.get();
+                if (activity == null || observersAttached) return;
+                activity.registerComponentCallbacks(this);
+                activity.getWindow().getDecorView().addOnLayoutChangeListener(this);
+                observersAttached = true;
+            }
+
+            void capture() {
+                Activity activity = owner.get();
+                if (activity == null || foreground.get() != activity || recreating) return;
+                Configuration config = activity.getResources().getConfiguration();
+                FoldReelsPolicy.WindowKind next =
+                        FoldReelsPolicy.classify(config.screenWidthDp, config.screenHeightDp);
+                if (next == FoldReelsPolicy.WindowKind.UNKNOWN) return;
+                kind = next;
+                boolean visible = hasVisibleViewer();
+                if (visible) seenViewer = true;
+                // Preserve the mode used by a viewer that was temporarily detached during a fold.
+                gate.observe(next, SystemClock.uptimeMillis(), seenViewer);
+                if (gate.pending() && resumed && visible && isEnabled()
+                        && SharedPref.getBooleanPref(Settings.FOLD_REELS_AUTO_REFRESH)) {
+                    if (!checkPosted) {
+                        checkPosted = true;
+                        handler.postDelayed(check, FoldReelsRefreshGate.SETTLE_MS);
+                    }
+                } else cancelCheck();
+            }
+
+            boolean hasVisibleViewer() {
+                for (Iterator<WeakReference<View>> it = viewers.iterator(); it.hasNext();) {
+                    View v = it.next().get();
+                    if (v == null) { it.remove(); continue; }
+                    if (v.isAttachedToWindow() && v.isShown() && v.getWidth() > 0 && v.getHeight() > 0
+                            && v.getGlobalVisibleRect(visibleBounds)
+                            && visibleBounds.width() >= v.getWidth() / 2
+                            && visibleBounds.height() >= v.getHeight() / 2) return true;
+                }
+                return false;
+            }
+
+            void recreate() {
+                Activity activity = owner.get();
+                if (activity == null || recreating || activity.isFinishing() || activity.isDestroyed()) return;
+                recreating = true;
+                gate.markRequested();
+                cancelCheck();
+                try {
+                    // Standard Android recreation; no process kill, fake rotation or navigation.
+                    // Whether the same Reel resumes depends on Instagram's saved-state handling.
+                    activity.recreate();
+                } catch (RuntimeException error) {
+                    Logger.printException(() -> "Fold Reels: Activity recreation failed", error);
+                    Toast.makeText(activity, str("piko_fold_reels_refresh_failed"), Toast.LENGTH_LONG).show();
+                }
+            }
+
+            void cancelCheck() {
+                if (checkPosted) handler.removeCallbacks(check);
+                checkPosted = false;
+            }
+
+            void dispose() {
+                cancelCheck();
+                Activity activity = owner.get();
+                if (activity != null && observersAttached) {
+                    activity.unregisterComponentCallbacks(this);
+                    activity.getWindow().getDecorView().removeOnLayoutChangeListener(this);
+                }
+                viewers.clear();
+            }
+
+            @Override public void onConfigurationChanged(Configuration config) { capture(); }
+            @Override public void onLowMemory() {}
+            @Override public void onLayoutChange(View v, int l, int t, int r, int b,
+                    int oldL, int oldT, int oldR, int oldB) { capture(); }
+        }
+    }
+}
