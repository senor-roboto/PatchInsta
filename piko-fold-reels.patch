+    @Test public void nativeGradientMovesToActualTopWithoutStretchingItsFalloff() {
+        viewer.layout(0,100,1000,1500); View v=gradient(pages.get(1)); Object original=v.getBackground(); float height=bounds(v).height();
+        renderer.discover(viewer); scrim.discover(renderer,viewer); apply(true);
+        assertSame(original,v.getBackground()); assertEquals(bounds(content).top,bounds(v).top,.01f);
+        assertEquals(bounds(content).left,bounds(v).left,.01f); assertEquals(bounds(content).right,bounds(v).right,.01f); assertEquals(height,bounds(v).height(),.01f);
+        RectF once=bounds(v); for(int i=0;i<200;i++)apply(true); assertEquals(once,bounds(v));
+        apply(false); assertEquals(1,v.getScaleX(),.001f); assertEquals(1,v.getScaleY(),.001f); assertEquals(0,v.getTranslationY(),.001f);
+    }
+    @Test public void preloadedPageGradientsUseTheSameSwipeSpacingAsThePlayers() {
+        View previous=gradient(pages.get(0)), current=gradient(pages.get(1)), next=gradient(pages.get(2));
+        renderer.discover(viewer); scrim.discover(renderer,viewer); apply(true);
+        assertEquals(bounds(content).top+1600,bounds(next).top,.01f);
+        swipe(700); apply(true);
+        assertEquals(bounds(content).top-800,bounds(current).top,.01f); assertEquals(bounds(content).top+800,bounds(next).top,.01f);
+        assertTrue(bounds(previous).bottom<bounds(current).top);
+    }
