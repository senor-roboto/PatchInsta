+++ b/tests/fold-reels/FoldReelsPolicyTest.java
@@ -0,0 +1,53 @@
+import app.morphe.extension.instagram.patches.reels.FoldReelsPolicy;
+import static app.morphe.extension.instagram.patches.reels.FoldReelsPolicy.WindowKind.*;
+
+/** JVM regression tests. These do not simulate Instagram's native rendering engine. */
+public final class FoldReelsPolicyTest {
+    private static int checks;
+    private static void eq(Object expected, Object actual) {
+        checks++;
+        if (!java.util.Objects.equals(expected, actual))
+            throw new AssertionError("Expected " + expected + ", got " + actual);
+    }
+    public static void main(String[] args) {
+        // Example window sizes in dp, NOT claimed Galaxy Z Fold8 hardware dimensions.
+        eq(COMPACT_PORTRAIT, FoldReelsPolicy.classify(420, 900));
+        eq(WIDE, FoldReelsPolicy.classify(840, 900));
+        eq(COMPACT_PORTRAIT, FoldReelsPolicy.classify(599, 900));
+        eq(WIDE, FoldReelsPolicy.classify(600, 900));
+        eq(WIDE, FoldReelsPolicy.classify(900, 420));
+        eq(OTHER, FoldReelsPolicy.classify(500, 400));
+        eq(OTHER, FoldReelsPolicy.classify(500, 500));
+        eq(UNKNOWN, FoldReelsPolicy.classify(0, 900));
+        eq(UNKNOWN, FoldReelsPolicy.classify(-1, 900));
+        eq(UNKNOWN, FoldReelsPolicy.classify(Float.NaN, 900));
+        eq(UNKNOWN, FoldReelsPolicy.classify(900, Float.POSITIVE_INFINITY));
+        eq(null, FoldReelsPolicy.override("83325::1", UNKNOWN, true, true));
+        eq(null, FoldReelsPolicy.override("83325::1", null, true, true));
+        eq(null, FoldReelsPolicy.override(null, WIDE, true, true));
+        eq(null, FoldReelsPolicy.override("83325::1", WIDE, false, true));
+        eq(null, FoldReelsPolicy.override("83325", WIDE, true, true));
+        eq(null, FoldReelsPolicy.override("83325::0", WIDE, true, true)); // numeric threshold
+        eq(null, FoldReelsPolicy.override("111584::29", WIDE, true, true)); // numeric width
+        eq(null, FoldReelsPolicy.override("111584::30", WIDE, true, true)); // unrelated DMs
+        eq(null, FoldReelsPolicy.override("999999::1", WIDE, true, true));
+        eq(true, FoldReelsPolicy.override("83325::1", COMPACT_PORTRAIT, true, true));
+        eq(false, FoldReelsPolicy.override("83325::1", COMPACT_PORTRAIT, true, false));
+        eq(false, FoldReelsPolicy.override("83325::1", WIDE, true, true));
+        eq(false, FoldReelsPolicy.override("83325::1", OTHER, true, true));
+        eq(true, FoldReelsPolicy.override("83325::3", COMPACT_PORTRAIT, true, true));
+        eq(false, FoldReelsPolicy.override("83325::4", COMPACT_PORTRAIT, true, true));
+        eq(null, FoldReelsPolicy.override("83325::3", WIDE, true, true));
+        eq(true, FoldReelsPolicy.override("111584::9", WIDE, true, true));
+        eq(false, FoldReelsPolicy.override("111584::9", COMPACT_PORTRAIT, true, true));
+        eq(true, FoldReelsPolicy.override("111584::27", WIDE, true, true));
+        // Fold -> unfold -> narrow split screen: policy never caches the initial window kind.
+        float[][] windows = {{420, 900}, {840, 900}, {420, 900}};
+        Boolean[] crop = {true, false, true};
+        for (int i = 0; i < windows.length; i++) {
+            eq(crop[i], FoldReelsPolicy.override("83325::1",
+                    FoldReelsPolicy.classify(windows[i][0], windows[i][1]), true, true));
+        }
+        System.out.println(checks + " policy checks passed (no Android/device validation).");
+    }
+}
