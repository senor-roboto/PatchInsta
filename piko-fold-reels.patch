+    final FoldReelsScrim scrim=new FoldReelsScrim(FoldReelsTestFixture::name);
+    GradientDrawable gradient() { return new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,new int[]{0xAA000000,Color.TRANSPARENT}); }
+    View gradient(FrameLayout page) { View v=new View(activity); v.setBackground(gradient()); add(page,v,106,80,788,200); return v; }
+    void apply(boolean enabled) { clipping.beginFrame(); scrim.frame(viewer,bounds(content),content,enabled,clipping); clipping.endFrame(); }
+    @Test public void nativeGradientExtendsToActualTopAndWidthWithoutMovingItsBottom() {
+        viewer.layout(0,100,1000,1500); View v=gradient(pages.get(1)); Object original=v.getBackground(); float bottom=bounds(v).bottom;
+        renderer.discover(viewer); scrim.discover(renderer,viewer); apply(true);
+        assertSame(original,v.getBackground()); assertEquals(bounds(content).top,bounds(v).top,.01f);
+        assertEquals(bounds(content).left,bounds(v).left,.01f); assertEquals(bounds(content).right,bounds(v).right,.01f); assertEquals(bottom,bounds(v).bottom,.01f);
+        RectF once=bounds(v); for(int i=0;i<200;i++)apply(true); assertEquals(once,bounds(v));
+        apply(false); assertEquals(1,v.getScaleX(),.001f); assertEquals(1,v.getScaleY(),.001f); assertEquals(0,v.getTranslationY(),.001f);
+    }
+    @Test public void preloadedPageGradientsUseTheSameSwipeSpacingAsThePlayers() {
+        View previous=gradient(pages.get(0)), current=gradient(pages.get(1)), next=gradient(pages.get(2));
+        renderer.discover(viewer); scrim.discover(renderer,viewer); apply(true);
+        assertEquals(bounds(content).top+1600,bounds(next).top,.01f);
+        swipe(700); apply(true);
+        assertEquals(bounds(content).top-800,bounds(current).top,.01f); assertEquals(bounds(content).top+800,bounds(next).top,.01f);
+        assertTrue(bounds(previous).bottom<bounds(current).top);
+    }
+    @Test public void interactiveHeaderUnknownDecorationAndOtherScreensStayNative() {
+        View clickable=gradient(pages.get(1)); clickable.setClickable(true);
+        View unknown=new View(activity); unknown.setBackgroundColor(Color.BLACK); add(pages.get(1),unknown,106,80,788,200);
+        View outside=gradient(content);
+        FrameLayout header=new FrameLayout(activity); header.setBackground(gradient()); add(pages.get(1),header,106,80,788,200); add(header,new View(activity),0,0,50,50);
+        renderer.discover(viewer); scrim.discover(renderer,viewer); apply(true);
+        for(View v:new View[]{clickable,unknown,outside,header}) { assertEquals(1,v.getScaleX(),.001f); assertEquals(0,v.getTranslationY(),.001f); }
+    }
+    @Test public void detachmentAndNewNativeTranslationsAreRestoredWithoutDrift() {
+        View v=gradient(pages.get(1)); renderer.discover(viewer); scrim.discover(renderer,viewer); apply(true);
