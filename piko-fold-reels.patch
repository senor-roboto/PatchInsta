+/** Live presentation of the existing player. Folding and framing never recreate an Activity. */
+public final class FoldReels {
+    private static volatile boolean installed;
+    private static volatile FoldReelsPolicy.WindowKind kind = FoldReelsPolicy.WindowKind.UNKNOWN;
+    static final Watcher watcher = new Watcher();
+    static FoldReelsPreferences prefs;
+    private static boolean noTwoPane;
+    private static WeakReference<Application> application = new WeakReference<>(null);
+    private static final View.OnAttachStateChangeListener VIEWER_LISTENER = new View.OnAttachStateChangeListener() {
+        @Override public void onViewAttachedToWindow(View v) { watcher.addViewer(v); }
+        @Override public void onViewDetachedFromWindow(View v) { watcher.removeViewer(v); }
+    };
+    private static final WeakHashMap<View, Boolean> observedViewers = new WeakHashMap<>();
+    private FoldReels() {}
+
+    public static synchronized void install() {
+        if (installed) return;
+        Context context = Utils.getContext();
+        if (context == null || !(context.getApplicationContext() instanceof Application)) return;
+        install((Application) context.getApplicationContext());
+    }
+    static synchronized void install(Application app) {
+        if (installed) return;
+        prefs = new FoldReelsPreferences(app);
+        noTwoPane = prefs.string("fold_reels_native_policy", "v4").equals("no_two_pane"); // Latched for the whole process.
+        Configuration config = app.getResources().getConfiguration();
+        kind = FoldReelsPolicy.classify(config.screenWidthDp, config.screenHeightDp);
+        app.registerActivityLifecycleCallbacks(watcher); application = new WeakReference<>(app); installed = true;
+    }
+    public static boolean isEnabled() { return installed && prefs != null && prefs.enabled(); }
+    public static Boolean override(String key) {
+        if (!installed || !FoldReelsPolicy.handles(key)) return null;
+        if (Looper.myLooper() == Looper.getMainLooper()) watcher.captureForeground();
+        return FoldReelsPolicy.override(key, kind, isEnabled(), true, false, noTwoPane);
+    }
+    // Package-private lifecycle teardown also used by the real watcher tests; no fake presentation engine.
+    static void resetForTests() {
+        for (Watcher.Tracker tracker : watcher.trackers.values()) tracker.dispose();
+        watcher.trackers.clear(); watcher.foreground.clear();
+        for (View v : observedViewers.keySet()) v.removeOnAttachStateChangeListener(VIEWER_LISTENER);
+        observedViewers.clear();
+        Application app = application.get(); if (app != null) app.unregisterActivityLifecycleCallbacks(watcher);
+        application.clear(); installed = false; prefs = null; kind = FoldReelsPolicy.WindowKind.UNKNOWN;
+    }
+
+    private static Activity activityOf(Context context) {
+        for (int depth = 0; context != null && depth < 20; depth++) {
+            if (context instanceof Activity) return (Activity) context;
+            if (!(context instanceof ContextWrapper)) break;
+            Context next = ((ContextWrapper) context).getBaseContext();
+            if (context == next) break;
+            context = next;
+        }
+        return null;
+    }
+
+    public static void attachViewer(View view) {
+        if (Looper.myLooper() != Looper.getMainLooper()) { view.post(() -> attachViewer(view)); return; }
+        Context app = view.getContext().getApplicationContext();
+        if (app instanceof Application) install((Application) app);
+        if (!observedViewers.containsKey(view)) {
