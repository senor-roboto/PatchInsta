+            State s = e.getValue();
+            out.append("card ").append(FoldReelsDiagnostics.id(e.getKey())).append(" reason=rounded-decoration-on-player-path")
+                    .append(" bg=").append(FoldReelsDiagnostics.type(s.bg)).append(" fg=").append(FoldReelsDiagnostics.type(s.fg))
+                    .append(" cleared=").append(s.background).append(',').append(s.foreground)
+                    .append(" elevationRemoved=").append(s.shadow).append('\n');
+        }
