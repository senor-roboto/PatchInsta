+            if (depth > 20 || all.size() > 200) return;
+            all.add(v); if (v instanceof ViewGroup) for (int i=0;i<((ViewGroup)v).getChildCount();i++) collect(((ViewGroup)v).getChildAt(i), all, depth+1);
