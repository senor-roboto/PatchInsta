+/** Live presentation of the existing player. Folding and framing never recreate an Activity. */
+public final class FoldReels {
+    private static volatile boolean installed;
+    private static volatile FoldReelsPolicy.WindowKind kind = FoldReelsPolicy.WindowKind.UNKNOWN;
+    static final Watcher watcher = new Watcher();
+    static FoldReelsPreferences prefs;
+    private static boolean noTwoPane;
+    private static WeakReference<Application> application = new WeakReference<>(null);
+    private static final View.OnAttachStateChangeListener VIEWER_LISTENER = new View.OnAttachStateChangeListener() {
+        @Override public void onViewAttachedToWindow(View v) { watcher.addViewer(v); }
+        @Override public void onViewDetachedFromWindow(View v) { watcher.removeViewer(v); }
+    };
+    private static final WeakHashMap<View, Boolean> observedViewers = new WeakHashMap<>();
+    private FoldReels() {}
