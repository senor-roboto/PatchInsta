--- /dev/null
+++ b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsScrim.java
@@ -0,0 +1,133 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.graphics.Color;
+import android.graphics.Matrix;
+import android.graphics.RectF;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.WeakHashMap;
+import java.util.function.Function;
+
+/** Extends a native decorative top gradient, never the interactive header or the video. */
+final class FoldReelsScrim implements View.OnAttachStateChangeListener {
+    private final WeakHashMap<View, State> states = new WeakHashMap<>();
+    private final Function<View, String> names;
+    private int generation, nodes;
+    private final RectF box = new RectF(), anchor = new RectF();
+    private final Matrix matrix = new Matrix();
+    FoldReelsScrim() { this(FoldReelsChrome::resourceName); }
+    FoldReelsScrim(Function<View, String> names) { this.names = names; }
+    void discover(FoldReelsRenderer renderer, View viewer) {
+        generation++; nodes = 0;
+        ArrayList<View> pages = new ArrayList<>();
+        renderer.visitPlayers((surface, page) -> { if (!pages.contains(page)) pages.add(page); });
+        scan(viewer, viewer, pages, 0);
+        for (Iterator<Map.Entry<View, State>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, State> e = it.next();
+            if (e.getValue().seen != generation) { release(e.getKey(), e.getValue()); it.remove(); }
+        }
+    }
+    private void scan(View v, View viewer, ArrayList<View> pages, int depth) {
+        if (++nodes > 1600 || depth > 40 || v instanceof android.view.TextureView || v instanceof android.view.SurfaceView) return;
+        if (v instanceof ViewGroup && ((ViewGroup) v).getChildCount() != 0) {
+            ViewGroup group = (ViewGroup) v;
+            for (int i = 0; i < group.getChildCount(); i++) scan(group.getChildAt(i), viewer, pages, depth + 1);
+            return; // Never scale the header's text, avatar or buttons with its background.
+        }
+        if (v.isClickable() || v.isLongClickable() || v.getWidth() < viewer.getWidth() * .5f
+                || v.getHeight() <= 0 || v.getHeight() > viewer.getHeight() * .45f) return;
+        String name = names.apply(v);
+        Drawable drawable = v.getBackground();
+        if (drawable == null && v instanceof ImageView) drawable = ((ImageView) v).getDrawable();
+        boolean shape = topGradient(drawable);
+        boolean named = (name.contains("top") || name.contains("header")) && (name.contains("scrim") || name.contains("gradient"));
+        if (!shape && !(named && drawable != null)) return;
+        View page = null;
+        for (View candidate : pages) if (FoldReelsViews.descendant(v, candidate)) { page = candidate; break; }
+        FoldReelsViews.bounds(page == null ? viewer : page, anchor, matrix);
+        State state = states.get(v);
+        if (state == null) { FoldReelsViews.bounds(v, box, matrix); }
+        else { state.capture(v); state.nativeBounds(v, box, matrix); }
+        float top = box.top - anchor.top;
+        if (top < -2 || top > viewer.getHeight() * .25f) return;
+        if (state == null) { state = new State(); states.put(v, state); v.addOnAttachStateChangeListener(this); }
+        state.seen = generation; state.page = new WeakReference<>(page); state.reason = shape ? "native-dark-top-gradient" : "named-top-decoration";
+    }
+    private static boolean topGradient(Drawable drawable) {
+        if (!(drawable instanceof GradientDrawable)) return false;
+        GradientDrawable d = (GradientDrawable) drawable;
+        if (d.getOrientation() != GradientDrawable.Orientation.TOP_BOTTOM) return false;
+        int[] colors = d.getColors();
+        if (colors == null || colors.length < 2 || Color.alpha(colors[0]) == 0 || Color.alpha(colors[colors.length-1]) != 0) return false;
+        for (int color : colors) if (Color.alpha(color) > 0 && (Color.red(color) > 64 || Color.green(color) > 64 || Color.blue(color) > 64)) return false;
+        return true;
+    }
+    void frame(View viewer, RectF viewport, View boundary, boolean enabled, FoldReelsClipping clipping) {
+        for (Iterator<Map.Entry<View, State>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, State> e = it.next(); View v = e.getKey(); State s = e.getValue();
+            if (!v.isAttachedToWindow() || !FoldReelsViews.descendant(v, viewer)) { release(v, s); it.remove(); continue; }
+            if (!enabled || !FoldReelsViews.unitParents(v, boundary) || v.getClipBounds() != null) { s.restore(v); continue; }
+            s.capture(v); s.nativeBounds(v, box, matrix);
+            View page = s.page.get(); float offset = 0, nativeOffset = 0;
+            if (page != null) {
+                offset = FoldReelsViews.pageOffset(page, viewer, viewport.height(), anchor, matrix);
+                FoldReelsViews.bounds(page, anchor, matrix); nativeOffset = anchor.top;
+                FoldReelsViews.bounds(viewer, anchor, matrix); nativeOffset -= anchor.top;
+            }
+            s.target.set(viewport.left, viewport.top + offset, viewport.right, box.bottom + offset - nativeOffset);
+            if (!Float.isFinite(offset) || box.width() <= 0 || box.height() <= 0
+                    || s.target.height() < box.height() * .8f || s.target.height() > viewport.height() * .65f) { s.restore(v); continue; }
+            s.apply(v, box, matrix); clipping.openPath(v, boundary);
+        }
+    }
+    void diagnostics(StringBuilder out) {
+        out.append("scrim candidates=").append(states.size()).append(" inspected=").append(nodes).append('\n');
+        for (Map.Entry<View, State> e : states.entrySet()) out.append("scrim ").append(FoldReelsDiagnostics.id(e.getKey()))
+                .append(" reason=").append(e.getValue().reason).append(" extended=").append(e.getValue().applied)
+                .append(" target=").append(e.getValue().target).append('\n');
+    }
+    void restore() { for (Map.Entry<View, State> e : states.entrySet()) release(e.getKey(), e.getValue()); states.clear(); }
+    private void release(View v, State s) { s.restore(v); v.removeOnAttachStateChangeListener(this); }
+    @Override public void onViewAttachedToWindow(View v) {}
+    @Override public void onViewDetachedFromWindow(View v) { State s = states.remove(v); if (s != null) release(v, s); }
+    private static final class State {
+        WeakReference<View> page = new WeakReference<>(null);
+        int seen; String reason; boolean applied;
+        float sx, sy, x, y, asx, asy, ax, ay;
+        final RectF target = new RectF(); final float[] pivot = new float[2];
+        static boolean same(float a, float b) { return Math.abs(a-b) < .001f; }
+        void capture(View v) {
+            if (!applied || !same(v.getScaleX(), asx)) sx = v.getScaleX();
+            if (!applied || !same(v.getScaleY(), asy)) sy = v.getScaleY();
+            if (!applied || !same(v.getTranslationX(), ax)) x = v.getTranslationX();
+            if (!applied || !same(v.getTranslationY(), ay)) y = v.getTranslationY();
+        }
+        void nativeBounds(View v, RectF out, Matrix matrix) {
+            v.getMatrix(); float px = v.getPivotX(), py = v.getPivotY(); View p = (View) v.getParent();
+            out.set(px-px*sx+x, py-py*sy+y, px+(v.getWidth()-px)*sx+x, py+(v.getHeight()-py)*sy+y);
+            out.offset(v.getLeft()-p.getScrollX(), v.getTop()-p.getScrollY()); matrix.reset(); p.transformMatrixToGlobal(matrix); matrix.mapRect(out);
+        }
+        void apply(View v, RectF source, Matrix matrix) {
+            View p = (View) v.getParent(); pivot[0] = v.getPivotX()+v.getLeft()-p.getScrollX(); pivot[1] = v.getPivotY()+v.getTop()-p.getScrollY();
+            matrix.reset(); p.transformMatrixToGlobal(matrix); matrix.mapPoints(pivot);
+            float fx = target.width()/source.width(), fy = target.height()/source.height(); asx = sx*fx; asy = sy*fy;
+            ax = FoldReelsGeometry.translation(target.centerX(), pivot[0], source.centerX()-x, fx);
+            ay = FoldReelsGeometry.translation(target.centerY(), pivot[1], source.centerY()-y, fy);
+            if (!same(v.getScaleX(), asx)) v.setScaleX(asx); if (!same(v.getScaleY(), asy)) v.setScaleY(asy);
+            if (!same(v.getTranslationX(), ax)) v.setTranslationX(ax); if (!same(v.getTranslationY(), ay)) v.setTranslationY(ay); applied = true;
+        }
+        void restore(View v) {
+            if (!applied) return;
+            if (same(v.getScaleX(), asx)) v.setScaleX(sx); if (same(v.getScaleY(), asy)) v.setScaleY(sy);
+            if (same(v.getTranslationX(), ax)) v.setTranslationX(x); if (same(v.getTranslationY(), ay)) v.setTranslationY(y); applied = false;
+        }
+    }
+}
