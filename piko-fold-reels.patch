@@ -0,0 +1,61 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/** Uses Piko's existing preferences file; no Activity reference and no eager global-context dependency. */
+final class FoldReelsPreferences {
+    static final String COVER_CROP = "fold_reels_cover_crop", INNER_CROP = "fold_reels_inner_crop";
+    static final String IMMERSIVE = "fold_reels_cover_immersive_v3", TABS = "fold_reels_cover_hide_tabs_v4";
+    static final String LEGACY_MINIMAL = "fold_reels_cover_minimal_v3", LEGACY_EDGES = "fold_reels_edge_controls_v4";
+    final SharedPreferences storage;
+    FoldReelsPreferences(Context context) {
+        storage = context.getApplicationContext().getSharedPreferences("piko_settings", Context.MODE_PRIVATE);
+        // Migrate an explicitly saved v3 choice once. An absent legacy boolean uses the new clean default.
+        String key = key(false, "actions");
+        if (!storage.contains(key) && storage.contains(LEGACY_MINIMAL))
+            put(key, bool(LEGACY_MINIMAL, false) ? "COMMENT_ONLY" : "ALL");
+    }
+    static String key(boolean inner, String option) { return "fold_reels_" + (inner ? "inner_" : "cover_") + option; }
+    boolean enabled() { return bool("adaptive_fold_reels", true); }
+    boolean bool(String key, boolean fallback) { try { return storage.getBoolean(key, fallback); } catch (ClassCastException e) { return fallback; } }
+    String string(String key, String fallback) { try { return storage.getString(key, fallback); } catch (ClassCastException e) { return fallback; } }
+    void put(String key, String value) { storage.edit().putString(key, value).apply(); }
+    void put(String key, boolean value) { storage.edit().putBoolean(key, value).apply(); }
+    void crop(boolean inner, boolean value) {
+        storage.edit().putBoolean(inner ? INNER_CROP : COVER_CROP, value)
+                .putString(key(inner, "zoom_v3"), "1").apply();
+    }
+    Profile read(boolean inner) {
+        float zoom = 1;
+        try { zoom = Float.parseFloat(string(key(inner, "zoom_v3"), "1")); } catch (NumberFormatException ignored) {}
+        if (!Float.isFinite(zoom)) zoom = 1;
+        return new Profile(bool(inner ? INNER_CROP : COVER_CROP, !inner), Math.max(1, Math.min(2.5f, zoom)),
+                !inner && bool(IMMERSIVE, true), !inner && bool(TABS, true),
+                bool(key(inner, "edges"), bool(LEGACY_EDGES, true)),
+                choice(FoldReelsControls.Actions.class, string(key(inner, "actions"), inner ? "ALL" : "COMMENT_ONLY"), FoldReelsControls.Actions.ALL),
+                choice(FoldReelsMetadata.Mode.class, string(key(inner, "metadata"), inner ? "FULL" : "COMPACT"), FoldReelsMetadata.Mode.FULL),
+                !inner && bool(key(false, "card"), true), bool(key(inner, "shortcut"), true));
+    }
+    void preset(boolean clean) {
+        storage.edit().putBoolean(COVER_CROP, clean).putString(key(false, "zoom_v3"), "1")
+                .putBoolean(IMMERSIVE, clean).putBoolean(TABS, clean).putBoolean(key(false, "edges"), clean)
+                .putString(key(false, "actions"), clean ? "COMMENT_ONLY" : "ALL")
+                .putString(key(false, "metadata"), clean ? "COMPACT" : "FULL")
+                .putBoolean(key(false, "card"), clean).putBoolean(key(false, "shortcut"), true).apply();
+    }
+    private static <T extends Enum<T>> T choice(Class<T> type, String value, T fallback) {
+        try { return Enum.valueOf(type, value); } catch (IllegalArgumentException | NullPointerException e) { return fallback; }
+    }
+    static final class Profile {
+        final boolean crop, immersive, tabs, edges, card, shortcut; final float zoom;
+        final FoldReelsControls.Actions actions; final FoldReelsMetadata.Mode metadata;
+        Profile(boolean crop, float zoom, boolean immersive, boolean tabs, boolean edges,
+                FoldReelsControls.Actions actions, FoldReelsMetadata.Mode metadata, boolean card, boolean shortcut) {
+            this.crop=crop; this.zoom=zoom; this.immersive=immersive; this.tabs=tabs; this.edges=edges;
+            this.actions=actions; this.metadata=metadata; this.card=card; this.shortcut=shortcut;
+        }
+        int discoveryKey() { return (crop ? 1 : 0) | (tabs ? 2 : 0) | (card ? 4 : 0) | (edges ? 8 : 0) | actions.ordinal()<<4 | metadata.ordinal()<<6; }
+    }
+}
diff --git a/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsRenderer.java b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsRenderer.java
new file mode 100644
index 0000000..1cf5ae7
--- /dev/null
+++ b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsRenderer.java
@@ -0,0 +1,207 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.graphics.Matrix;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.os.Build;
+import android.view.SurfaceView;
+import android.view.TextureView;
+import android.view.View;
+import android.view.ViewParent;
+import android.view.ViewGroup;
+import java.lang.ref.WeakReference;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.Objects;
+import java.util.WeakHashMap;
+
+/** Discovery is event driven; every known pager surface is framed before each draw, including neighbours. */
+final class FoldReelsRenderer implements View.OnLayoutChangeListener, View.OnAttachStateChangeListener {
+    private final WeakHashMap<View, SurfaceState> states = new WeakHashMap<>();
+    private final Runnable changed;
+    private final RectF viewerBounds = new RectF();
+    private final Matrix matrix = new Matrix();
+    private int generation, nodes, framed, unanchored;
+    private long discoveries, frames;
+    FoldReelsRenderer(Runnable changed) { this.changed = changed; }
+
+    String status() { return "surfaces=" + states.size() + " framed=" + framed + " unanchored=" + unanchored
+            + " discoveries=" + discoveries + " frames=" + frames; }
+    int surfaceCount() { return states.size(); }
+    long discoveryCount() { return discoveries; }
+    void visitPlayers(java.util.function.BiConsumer<View, View> visitor) {
+        for (Map.Entry<View, SurfaceState> entry : states.entrySet()) {
+            View page = entry.getValue().page.get();
+            if (page != null) visitor.accept(entry.getKey(), page);
+        }
+    }
+    void diagnostics(StringBuilder out) {
+        out.append("renderer ").append(status()).append('\n');
+        for (Map.Entry<View, SurfaceState> entry : states.entrySet()) {
+            out.append("player ").append(FoldReelsDiagnostics.id(entry.getKey()))
+                    .append(" page=").append(FoldReelsDiagnostics.id(entry.getValue().page.get()))
+                    .append(" target=").append(entry.getValue().target).append('\n');
+        }
+    }
+
+    void discover(View viewer) {
+        generation++; discoveries++; nodes = 0;
+        collect(viewer, viewer, 0);
+        for (Iterator<Map.Entry<View, SurfaceState>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, SurfaceState> e = it.next();
+            if (e.getValue().seen != generation) { release(e.getKey(), e.getValue()); it.remove(); }
+        }
+    }
+    private void collect(View view, View viewer, int depth) {
+        if (++nodes > 1600 || depth > 40) return;
+        if (view instanceof TextureView || view instanceof SurfaceView) {
+            if (!view.isAttachedToWindow()) return;
+            SurfaceState state = states.get(view);
+            if (state == null) {
+                state = new SurfaceState(view); states.put(view, state);
+                view.addOnLayoutChangeListener(this); view.addOnAttachStateChangeListener(this);
+            }
+            state.seen = generation;
+            state.page = new WeakReference<>(FoldReelsViews.page(view, viewer));
+            return; // Visibility and intersection are deliberately NOT discovery gates.
+        }
+        if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) collect(group.getChildAt(i), viewer, depth + 1);
+        }
+    }
+
+    boolean frame(View viewer, RectF viewport, View boundary, boolean crop, float zoom, FoldReelsClipping clipping) {
+        if (Build.VERSION.SDK_INT < 29) return false;
+        frames++; framed = 0; unanchored = 0;
+        FoldReelsViews.bounds(viewer, viewerBounds, matrix);
+        for (Iterator<Map.Entry<View, SurfaceState>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, SurfaceState> e = it.next(); View view = e.getKey(); SurfaceState state = e.getValue();
+            if (!view.isAttachedToWindow() || !FoldReelsViews.descendant(view, viewer)) {
+                release(view, state); it.remove(); continue;
+            }
+            // Register zero-sized players during discovery; frame them as soon as their first layout is ready.
+            if (view.getWidth() <= 0 || view.getHeight() <= 0) continue;
+            if (!crop && zoom <= 1f) { state.restore(view); framed++; continue; }
+            state.capture(view);
+            View page = state.page.get();
+            if (page == null || page.getHeight() < viewer.getHeight() * .75f || !FoldReelsViews.descendant(view, page)) {
+                // Unknown page boundaries must not let an offscreen renderer paint over another Reel.
+                state.restore(view); unanchored++; continue;
+            }
+            if (!FoldReelsViews.unitParents(view, boundary)) { state.restore(view); continue; }
+            state.bounds(view);
+            float factor = FoldReelsGeometry.scale(state.source.width(), state.source.height(),
+                    viewport.width(), viewport.height(), crop, zoom);
+            if (!Float.isFinite(factor) || factor <= 0 || factor > 12
+                    || view.getWidth() < viewer.getWidth() * .15f || view.getHeight() < viewer.getHeight() * .25f) {
+                state.restore(view); continue; // Reject thumbnails by size, never by how far they have entered the screen.
+            }
+            state.target.set(viewport);
+            float offset = FoldReelsViews.pageOffset(page, viewer, viewport.height(), state.work, state.matrix);
+            if (!Float.isFinite(offset)) { state.restore(view); continue; }
+            state.target.offset(0, offset);
+            clipping.openPath(view, boundary);
+            state.apply(view, factor);
+            framed++;
+        }
+        return framed > 0;
+    }
+
+    void restore() {
+        for (Map.Entry<View, SurfaceState> e : states.entrySet()) release(e.getKey(), e.getValue());
+        states.clear(); framed = 0;
+    }
+    private void release(View view, SurfaceState state) {
+        state.restore(view); view.removeOnLayoutChangeListener(this); view.removeOnAttachStateChangeListener(this);
+    }
+    @Override public void onViewAttachedToWindow(View view) { changed.run(); }
+    @Override public void onViewDetachedFromWindow(View view) {
+        SurfaceState state = states.remove(view); if (state != null) release(view, state);
+        changed.run();
+    }
+    @Override public void onLayoutChange(View v, int l, int t, int r, int b, int ol, int ot, int or, int ob) { changed.run(); }
+
+    /** Values contain no strong View references, so the weak-key map cannot retain recycled pages. */
+    private static final class SurfaceState {
+        WeakReference<View> page = new WeakReference<>(null);
+        int seen;
+        float sx, sy, tx, ty, asx, asy, atx, aty;
+        boolean applied, clipped;
+        Rect nativeClip, lastClip;
+        final RectF source = new RectF(), target = new RectF(), work = new RectF();
+        final Matrix matrix = new Matrix(), inverse = new Matrix();
+        final float[] pivot = new float[2];
+        SurfaceState(View view) { read(view); }
+        static boolean same(float a, float b) { return Math.abs(a - b) < .0001f; }
+        void read(View v) {
+            sx = v.getScaleX(); sy = v.getScaleY(); tx = v.getTranslationX(); ty = v.getTranslationY();
+            nativeClip = v.getClipBounds();
+        }
+        void capture(View v) {
+            if (!applied) { read(v); return; }
+            if (!same(v.getScaleX(), asx)) sx = v.getScaleX();
+            if (!same(v.getScaleY(), asy)) sy = v.getScaleY();
+            if (!same(v.getTranslationX(), atx)) tx = v.getTranslationX();
+            if (!same(v.getTranslationY(), aty)) ty = v.getTranslationY();
+            Rect current = v.getClipBounds();
+            if (!Objects.equals(current, lastClip)) nativeClip = current;
+        }
+        void bounds(View v) {
+            // Resolve Android's implicit centre pivot after layout before reading it. A newly
+            // attached/re-sized player may not have had its render matrix evaluated yet.
+            v.getMatrix();
+            source.set(0, 0, v.getWidth(), v.getHeight());
+            if (v instanceof TextureView) {
+                ((TextureView) v).getTransform(matrix); matrix.mapRect(source);
+                if (!source.intersect(0, 0, v.getWidth(), v.getHeight())) { source.setEmpty(); return; }
+            }
+            if (nativeClip != null && !source.intersect(nativeClip.left, nativeClip.top, nativeClip.right, nativeClip.bottom)) {
+                source.setEmpty(); return;
+            }
+            float px = v.getPivotX(), py = v.getPivotY();
+            source.set(px + (source.left - px) * sx + tx, py + (source.top - py) * sy + ty,
+                    px + (source.right - px) * sx + tx, py + (source.bottom - py) * sy + ty);
+            View parent = (View) v.getParent();
+            source.offset(v.getLeft() - parent.getScrollX(), v.getTop() - parent.getScrollY());
+            matrix.reset(); parent.transformMatrixToGlobal(matrix); matrix.mapRect(source);
+        }
+        void apply(View v, float factor) {
+            View parent = (View) v.getParent();
+            pivot[0] = v.getPivotX() + v.getLeft() - parent.getScrollX();
+            pivot[1] = v.getPivotY() + v.getTop() - parent.getScrollY();
+            matrix.reset(); parent.transformMatrixToGlobal(matrix); matrix.mapPoints(pivot);
+            asx = sx * factor; asy = sy * factor;
+            atx = FoldReelsGeometry.translation(target.centerX(), pivot[0], source.centerX() - tx, factor);
+            aty = FoldReelsGeometry.translation(target.centerY(), pivot[1], source.centerY() - ty, factor);
+            if (!same(v.getScaleX(), asx)) v.setScaleX(asx);
+            if (!same(v.getScaleY(), asy)) v.setScaleY(asy);
+            if (!same(v.getTranslationX(), atx)) v.setTranslationX(atx);
+            if (!same(v.getTranslationY(), aty)) v.setTranslationY(aty);
+            applied = true;
+            // Each page has its own crop window: neighbouring enlarged videos never overlap.
+            matrix.reset(); v.transformMatrixToGlobal(matrix);
+            if (!matrix.invert(inverse)) return;
+            work.set(target); inverse.mapRect(work);
+            int left = Math.max(0, (int) Math.ceil(work.left - .001f));
+            int top = Math.max(0, (int) Math.ceil(work.top - .001f));
+            int right = Math.min(v.getWidth(), (int) Math.floor(work.right + .001f));
+            int bottom = Math.min(v.getHeight(), (int) Math.floor(work.bottom + .001f));
+            if (lastClip == null) lastClip = new Rect();
+            lastClip.set(left, top, Math.max(left, right), Math.max(top, bottom));
+            if (!lastClip.equals(v.getClipBounds())) v.setClipBounds(lastClip);
+            clipped = true;
+        }
+        void restore(View v) {
+            if (applied) {
+                if (same(v.getScaleX(), asx)) v.setScaleX(sx);
+                if (same(v.getScaleY(), asy)) v.setScaleY(sy);
+                if (same(v.getTranslationX(), atx)) v.setTranslationX(tx);
+                if (same(v.getTranslationY(), aty)) v.setTranslationY(ty);
+            }
+            if (clipped && Objects.equals(v.getClipBounds(), lastClip)) v.setClipBounds(nativeClip);
+            applied = clipped = false; lastClip = null;
+        }
+    }
+}
diff --git a/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsScrim.java b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsScrim.java
new file mode 100644
index 0000000..2177a8e
--- /dev/null
+++ b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsScrim.java
@@ -0,0 +1,133 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.graphics.Color;
+import android.graphics.Matrix;
+import android.graphics.RectF;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.WeakHashMap;
+import java.util.function.Function;
+
+/** Extends a native decorative top gradient, never the interactive header or the video. */
+final class FoldReelsScrim implements View.OnAttachStateChangeListener {
+    private final WeakHashMap<View, State> states = new WeakHashMap<>();
+    private final Function<View, String> names;
+    private int generation, nodes;
+    private final RectF box = new RectF(), anchor = new RectF();
+    private final Matrix matrix = new Matrix();
+    FoldReelsScrim() { this(FoldReelsChrome::resourceName); }
+    FoldReelsScrim(Function<View, String> names) { this.names = names; }
+    void discover(FoldReelsRenderer renderer, View viewer) {
+        generation++; nodes = 0;
+        ArrayList<View> pages = new ArrayList<>();
+        renderer.visitPlayers((surface, page) -> { if (!pages.contains(page)) pages.add(page); });
+        scan(viewer, viewer, pages, 0);
+        for (Iterator<Map.Entry<View, State>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, State> e = it.next();
+            if (e.getValue().seen != generation) { release(e.getKey(), e.getValue()); it.remove(); }
+        }
+    }
+    private void scan(View v, View viewer, ArrayList<View> pages, int depth) {
+        if (++nodes > 1600 || depth > 40 || v instanceof android.view.TextureView || v instanceof android.view.SurfaceView) return;
+        if (v instanceof ViewGroup && ((ViewGroup) v).getChildCount() != 0) {
+            ViewGroup group = (ViewGroup) v;
+            for (int i = 0; i < group.getChildCount(); i++) scan(group.getChildAt(i), viewer, pages, depth + 1);
+            return; // Never scale the header's text, avatar or buttons with its background.
+        }
+        if (v.isClickable() || v.isLongClickable() || v.getWidth() < viewer.getWidth() * .5f
+                || v.getHeight() <= 0 || v.getHeight() > viewer.getHeight() * .45f) return;
+        String name = names.apply(v);
+        Drawable drawable = v.getBackground();
+        if (drawable == null && v instanceof ImageView) drawable = ((ImageView) v).getDrawable();
+        boolean shape = topGradient(drawable);
+        boolean named = (name.contains("top") || name.contains("header")) && (name.contains("scrim") || name.contains("gradient"));
+        if (!shape && !(named && drawable != null)) return;
+        View page = null;
+        for (View candidate : pages) if (FoldReelsViews.descendant(v, candidate)) { page = candidate; break; }
+        FoldReelsViews.bounds(page == null ? viewer : page, anchor, matrix);
+        State state = states.get(v);
+        if (state == null) { FoldReelsViews.bounds(v, box, matrix); }
+        else { state.capture(v); state.nativeBounds(v, box, matrix); }
+        float top = box.top - anchor.top;
+        if (top < -2 || top > viewer.getHeight() * .25f) return;
+        if (state == null) { state = new State(); states.put(v, state); v.addOnAttachStateChangeListener(this); }
+        state.seen = generation; state.page = new WeakReference<>(page); state.reason = shape ? "native-dark-top-gradient" : "named-top-decoration";
+    }
+    private static boolean topGradient(Drawable drawable) {
+        if (!(drawable instanceof GradientDrawable)) return false;
+        GradientDrawable d = (GradientDrawable) drawable;
+        if (d.getOrientation() != GradientDrawable.Orientation.TOP_BOTTOM) return false;
+        int[] colors = d.getColors();
+        if (colors == null || colors.length < 2 || Color.alpha(colors[0]) == 0 || Color.alpha(colors[colors.length-1]) != 0) return false;
+        for (int color : colors) if (Color.alpha(color) > 0 && (Color.red(color) > 64 || Color.green(color) > 64 || Color.blue(color) > 64)) return false;
+        return true;
+    }
+    void frame(View viewer, RectF viewport, View boundary, boolean enabled, FoldReelsClipping clipping) {
+        for (Iterator<Map.Entry<View, State>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, State> e = it.next(); View v = e.getKey(); State s = e.getValue();
+            if (!v.isAttachedToWindow() || !FoldReelsViews.descendant(v, viewer)) { release(v, s); it.remove(); continue; }
+            if (!enabled || !FoldReelsViews.unitParents(v, boundary) || v.getClipBounds() != null) { s.restore(v); continue; }
+            s.capture(v); s.nativeBounds(v, box, matrix);
+            View page = s.page.get(); float offset = 0, nativeOffset = 0;
+            if (page != null) {
+                offset = FoldReelsViews.pageOffset(page, viewer, viewport.height(), anchor, matrix);
+                FoldReelsViews.bounds(page, anchor, matrix); nativeOffset = anchor.top;
+                FoldReelsViews.bounds(viewer, anchor, matrix); nativeOffset -= anchor.top;
+            }
+            s.target.set(viewport.left, viewport.top + offset, viewport.right, box.bottom + offset - nativeOffset);
+            if (!Float.isFinite(offset) || box.width() <= 0 || box.height() <= 0
+                    || s.target.height() < box.height() * .8f || s.target.height() > viewport.height() * .65f) { s.restore(v); continue; }
+            s.apply(v, box, matrix); clipping.openPath(v, boundary);
+        }
+    }
+    void diagnostics(StringBuilder out) {
+        out.append("scrim candidates=").append(states.size()).append(" inspected=").append(nodes).append('\n');
+        for (Map.Entry<View, State> e : states.entrySet()) out.append("scrim ").append(FoldReelsDiagnostics.id(e.getKey()))
+                .append(" reason=").append(e.getValue().reason).append(" extended=").append(e.getValue().applied)
+                .append(" target=").append(e.getValue().target).append('\n');
+    }
+    void restore() { for (Map.Entry<View, State> e : states.entrySet()) release(e.getKey(), e.getValue()); states.clear(); }
+    private void release(View v, State s) { s.restore(v); v.removeOnAttachStateChangeListener(this); }
+    @Override public void onViewAttachedToWindow(View v) {}
+    @Override public void onViewDetachedFromWindow(View v) { State s = states.remove(v); if (s != null) release(v, s); }
+    private static final class State {
+        WeakReference<View> page = new WeakReference<>(null);
+        int seen; String reason; boolean applied;
+        float sx, sy, x, y, asx, asy, ax, ay;
+        final RectF target = new RectF(); final float[] pivot = new float[2];
+        static boolean same(float a, float b) { return Math.abs(a-b) < .001f; }
+        void capture(View v) {
+            if (!applied || !same(v.getScaleX(), asx)) sx = v.getScaleX();
+            if (!applied || !same(v.getScaleY(), asy)) sy = v.getScaleY();
+            if (!applied || !same(v.getTranslationX(), ax)) x = v.getTranslationX();
+            if (!applied || !same(v.getTranslationY(), ay)) y = v.getTranslationY();
+        }
+        void nativeBounds(View v, RectF out, Matrix matrix) {
+            v.getMatrix(); float px = v.getPivotX(), py = v.getPivotY(); View p = (View) v.getParent();
+            out.set(px-px*sx+x, py-py*sy+y, px+(v.getWidth()-px)*sx+x, py+(v.getHeight()-py)*sy+y);
+            out.offset(v.getLeft()-p.getScrollX(), v.getTop()-p.getScrollY()); matrix.reset(); p.transformMatrixToGlobal(matrix); matrix.mapRect(out);
+        }
+        void apply(View v, RectF source, Matrix matrix) {
+            View p = (View) v.getParent(); pivot[0] = v.getPivotX()+v.getLeft()-p.getScrollX(); pivot[1] = v.getPivotY()+v.getTop()-p.getScrollY();
+            matrix.reset(); p.transformMatrixToGlobal(matrix); matrix.mapPoints(pivot);
+            float fx = target.width()/source.width(), fy = target.height()/source.height(); asx = sx*fx; asy = sy*fy;
+            ax = FoldReelsGeometry.translation(target.centerX(), pivot[0], source.centerX()-x, fx);
+            ay = FoldReelsGeometry.translation(target.centerY(), pivot[1], source.centerY()-y, fy);
+            if (!same(v.getScaleX(), asx)) v.setScaleX(asx); if (!same(v.getScaleY(), asy)) v.setScaleY(asy);
+            if (!same(v.getTranslationX(), ax)) v.setTranslationX(ax); if (!same(v.getTranslationY(), ay)) v.setTranslationY(ay); applied = true;
+        }
+        void restore(View v) {
+            if (!applied) return;
+            if (same(v.getScaleX(), asx)) v.setScaleX(sx); if (same(v.getScaleY(), asy)) v.setScaleY(sy);
+            if (same(v.getTranslationX(), ax)) v.setTranslationX(x); if (same(v.getTranslationY(), ay)) v.setTranslationY(y); applied = false;
+        }
+    }
+}
