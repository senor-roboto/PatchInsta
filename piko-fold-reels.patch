+            if (!background && !foreground && shadow) {
+                if (v.getElevation() == 0) v.setElevation(elevation);
+                shadow = false;
+            }
+            if ((background || foreground) && v.getElevation() != 0) { elevation = v.getElevation(); v.setElevation(0); shadow = true; }
+        }
+        void restore(View v) {
+            if (background && v.getBackground() == null) v.setBackground(bg);
+            if (foreground && v.getForeground() == null) v.setForeground(fg);
+            if (shadow && v.getElevation() == 0) v.setElevation(elevation);
+            bg = fg = null; background = foreground = shadow = false;
+        }
+    }
+}
