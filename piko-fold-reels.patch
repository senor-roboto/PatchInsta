+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.graphics.Color;
+import android.graphics.Rect;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.Drawable;
+import android.util.SparseArray;
+import android.view.SurfaceView;
+import android.view.TextureView;
+import android.view.View;
+import android.view.ViewGroup;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.WeakHashMap;
+import java.util.function.Function;
+
+/** Discovery-only hierarchy walks. Navigation, optional actions and pane backgrounds have independent ownership. */
+final class FoldReelsChrome {
+    private static final SparseArray<String> resourceNames = new SparseArray<>();
+    private final WeakHashMap<View, State> states = new WeakHashMap<>();
+    private final Function<View, String> names;
+    private int nodes, generation;
+    private boolean tabsHidden;
+    FoldReelsChrome() { this(FoldReelsChrome::resourceName); }
+    FoldReelsChrome(Function<View, String> names) { this.names = names; }
+
+    void discover(View viewer, View content, boolean hideBottomTabs, boolean minimalActions, boolean clearPanes) {
+        generation++; nodes = 0;
+        scan(viewer, viewer, minimalActions, false, clearPanes, 0);
+        if (hideBottomTabs) { nodes = 0; scan(content, viewer, false, true, false, 0); }
+        for (Iterator<Map.Entry<View, State>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, State> e = it.next();
+            if (e.getValue().seen != generation) { e.getValue().restore(e.getKey()); it.remove(); }
+        }
+    }
+    private void scan(View view, View viewer, boolean clean, boolean tabsOnly, boolean panes, int depth) {
+        if (++nodes > 1800 || depth > 40 || view instanceof TextureView || view instanceof SurfaceView) return;
+        if (view.getVisibility() == View.GONE) return;
+        if (tabsOnly && view == viewer) return;
+        String name = names.apply(view);
+        if (tabsOnly && isBottomTabs(view, viewer, name)) { remember(view, true, false, true); return; }
+        if (!tabsOnly) {
+            boolean pane = panes && view.getHeight() > viewer.getHeight() * .6f && view.getWidth() > 0
+                    && view.getWidth() < viewer.getWidth() * .35f
+                    && (dark(view.getBackground()) || states.containsKey(view));
+            boolean reelName = name.startsWith("clips_") || name.startsWith("reel_") || name.startsWith("reels_");
+            boolean optional = name.contains("like_button") || name.contains("like_count")
+                    || name.contains("share_button") || name.contains("share_count")
+                    || name.contains("reshare") || name.contains("repost")
+                    || name.contains("save_button") || name.contains("save_count")
+                    || name.contains("audio_button") || name.contains("caption") || name.equals("clips_viewer_header");
+            boolean hide = clean && reelName && optional && !name.contains("comment")
+                    && view.getHeight() < viewer.getHeight() * .35f && !containsComment(view, 0);
+            if (pane || hide) remember(view, hide, pane, false);
+            if (hide) return;
+        }
+        if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) scan(group.getChildAt(i), viewer, clean, tabsOnly, panes, depth + 1);
+        }
+    }
+    private void remember(View view, boolean hide, boolean pane, boolean tab) {
+        State state = states.get(view);
+        if (state == null) { state = new State(); states.put(view, state); }
+        state.seen = generation; state.hide = hide; state.pane = pane; state.tab = tab;
+    }
+    private boolean containsComment(View view, int depth) {
+        if (names.apply(view).contains("comment")) return true;
+        if (depth >= 20) return true;
+        if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) if (containsComment(group.getChildAt(i), depth + 1)) return true;
+        }
+        return false;
+    }
+    private static boolean isBottomTabs(View view, View viewer, String name) {
+        if (!(name.equals("tab_bar") || name.equals("bottom_tab_bar")
+                || name.equals("bottom_navigation_bar") || name.equals("navigation_bar"))) return false;
+        if (!(view instanceof ViewGroup) || ((ViewGroup) view).getChildCount() < 2) return false;
+        float density = view.getResources().getDisplayMetrics().density;
+        Rect reels = new Rect(); int[] pos = new int[2]; view.getLocationOnScreen(pos);
+        if (!viewer.getGlobalVisibleRect(reels)) return false;
+        return view.getWidth() >= reels.width() * .8f && view.getHeight() > 0
+                && view.getHeight() <= 120 * density && pos[1] >= reels.bottom - 32 * density;
+    }
+    static String resourceName(View view) {
+        int id = view.getId(); if (id == View.NO_ID) return "";
+        String cached = resourceNames.get(id); if (cached != null) return cached;
+        String result;
+        try { result = view.getResources().getResourceEntryName(id); }
+        catch (RuntimeException ignored) { result = ""; }
+        resourceNames.put(id, result); return result;
+    }
+    private static boolean dark(Drawable bg) {
+        if (!(bg instanceof ColorDrawable)) return false;
+        int c = ((ColorDrawable) bg).getColor();
+        return Color.alpha(c) == 255 && Color.red(c) < 32 && Color.green(c) < 32 && Color.blue(c) < 32;
+    }
+    boolean frame() {
+        tabsHidden = false;
+        for (Iterator<Map.Entry<View, State>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, State> e = it.next(); View view = e.getKey(); State state = e.getValue();
+            if (!view.isAttachedToWindow()) { state.restore(view); it.remove(); continue; }
+            state.apply(view);
+            tabsHidden |= state.tab && view.getVisibility() == View.INVISIBLE;
+        }
+        return tabsHidden;
+    }
+    String status() { return "tracked=" + states.size() + " tabs=" + tabsHidden; }
+    void restore() { for (Map.Entry<View, State> e : states.entrySet()) e.getValue().restore(e.getKey()); states.clear(); tabsHidden = false; }
+    private static final class State {
+        int seen, visibility;
+        boolean hide, pane, tab, hid, cleared;
+        Drawable background;
+        void apply(View view) {
+            if (!hide && hid) restoreVisibility(view);
+            if (hide && view.getVisibility() == View.VISIBLE) {
+                visibility = view.getVisibility(); view.setVisibility(View.INVISIBLE); hid = true;
+            }
+            if (!pane && cleared) restoreBackground(view);
+            if (pane && dark(view.getBackground())) { background = view.getBackground(); view.setBackground(null); cleared = true; }
+        }
+        void restoreVisibility(View view) { if (view.getVisibility() == View.INVISIBLE) view.setVisibility(visibility); hid = false; }
+        void restoreBackground(View view) { if (view.getBackground() == null) view.setBackground(background); background = null; cleared = false; }
+        void restore(View view) { if (hid) restoreVisibility(view); if (cleared) restoreBackground(view); }
+    }
+}
