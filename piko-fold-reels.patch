+/** Live presentation of the existing player. Folding and framing never recreate an Activity. */
+public final class FoldReels {
+    private static volatile boolean installed;
+    private static volatile FoldReelsPolicy.WindowKind kind = FoldReelsPolicy.WindowKind.UNKNOWN;
+    private static final Watcher watcher = new Watcher();
+    private static final WeakHashMap<View, Boolean> observedViewers = new WeakHashMap<>();
+    private FoldReels() {}
+
+    public static synchronized void install() {
+        if (installed) return;
+        Context context = Utils.getContext();
+        if (context == null || !(context.getApplicationContext() instanceof Application)) return;
+        ((Application) context.getApplicationContext()).registerActivityLifecycleCallbacks(watcher);
+        installed = true;
+    }
+
+    public static boolean isEnabled() {
+        return installed && SharedPref.getBooleanPref(Settings.ADAPTIVE_FOLD_REELS);
+    }
+
+    public static Boolean override(String key) {
+        if (!installed || !FoldReelsPolicy.handles(key)) return null;
+        if (Looper.myLooper() == Looper.getMainLooper()) watcher.captureForeground();
+        return FoldReelsPolicy.override(key, kind, isEnabled(),
+                SharedPref.getBooleanPref(Settings.FOLD_REELS_COVER_CROP),
+                SharedPref.getBooleanPref(Settings.FOLD_REELS_INNER_CROP));
+    }
+
+    private static Activity activityOf(Context context) {
+        for (int depth = 0; context != null && depth < 20; depth++) {
+            if (context instanceof Activity) return (Activity) context;
+            if (!(context instanceof ContextWrapper)) break;
+            Context next = ((ContextWrapper) context).getBaseContext();
+            if (context == next) break;
+            context = next;
+        }
+        return null;
+    }
+
+    public static void attachViewer(View view) {
+        if (Looper.myLooper() != Looper.getMainLooper()) { view.post(() -> attachViewer(view)); return; }
+        if (observedViewers.containsKey(view)) return;
+        observedViewers.put(view, true);
+        view.addOnAttachStateChangeListener(new View.OnAttachStateChangeListener() {
+            @Override public void onViewAttachedToWindow(View v) { watcher.addViewer(v); }
+            @Override public void onViewDetachedFromWindow(View v) { watcher.removeViewer(v); }
+        });
+        if (view.isAttachedToWindow()) watcher.addViewer(view);
+    }
