+/** Public, inspectable contrast shapes only. No resource-name guesses for complex containers. */
+final class FoldReelsContrast {
+    static final int TOP = 1, BOTTOM = 2, BOTH = 3;
+    private FoldReelsContrast() {}
+    static int edges(Drawable d) { return Math.max(0, inspect(d, 0)); }
+    private static int inspect(Drawable d, int depth) {
+        if (depth > 5 || d == null) return -1;
+        if (d instanceof FoldReelsScrim.ExtendedGradient) d = ((FoldReelsScrim.ExtendedGradient) d).nativeDrawable;
+        if (d instanceof ColorDrawable) return Color.alpha(((ColorDrawable) d).getColor()) == 0 ? 0 : -1;
+        if (d instanceof LayerDrawable) {
