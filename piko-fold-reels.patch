+            if (v != root && !FoldReelsViews.descendant(a,v) && !FoldReelsViews.descendant(n,v) && !FoldReelsViews.descendant(f,v)) { extras.add(new WeakReference<>(v)); return; }
+            if (v instanceof ViewGroup) for (int i=0;i<((ViewGroup)v).getChildCount();i++) extras(((ViewGroup)v).getChildAt(i), root, a,n,f,depth+1);
+        }
