@@ -0,0 +1,30 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+/** Geometry shared by the Android renderer and JVM regression tests. */
+public final class FoldReelsGeometry {
+    private FoldReelsGeometry() {}
+
+    public static float scale(float videoWidth, float videoHeight,
+                              float targetWidth, float targetHeight, boolean crop, float zoom) {
+        if (!positive(videoWidth) || !positive(videoHeight) || !positive(targetWidth)
+                || !positive(targetHeight) || !positive(zoom)) return Float.NaN;
+        float x = targetWidth / videoWidth, y = targetHeight / videoHeight;
+        return (crop ? Math.max(x, y) : Math.min(x, y)) * Math.max(1f, Math.min(2.5f, zoom));
+    }
+
+    public static float pageOffset(float nativeOffset, float pageHeight, float targetHeight) {
+        if (!Float.isFinite(nativeOffset) || !positive(pageHeight) || !positive(targetHeight)) return Float.NaN;
+        return nativeOffset / pageHeight * targetHeight;
+    }
+
+    public static float translation(float targetCentre, float pivot, float nativeCentre, float factor) {
+        return targetCentre - pivot - (nativeCentre - pivot) * factor;
+    }
+
+    private static boolean positive(float value) { return Float.isFinite(value) && value > 0; }
+
+    public static boolean mostlyVisible(float fullArea, float visibleArea) {
+        return positive(fullArea) && positive(visibleArea) && visibleArea / fullArea >= 0.60f;
+    }
+}
