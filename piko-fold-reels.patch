+        assertEquals(1,t.viewers.size()); assertEquals(1,t.observerInstallations); assertSame(chip,t.chip.get()); assertEquals(scale,video.getScaleX(),.001f);
+        assertEquals(0,activity.recreations); assertEquals(0,activity.configurations);
+    }
+    @Test public void backgroundViewerWaitsForActualWindowFocus() {
+        activity.focused=false; FoldReels.Watcher.Tracker t=start(); assertFalse(t.active); assertNull(t.chip.get()); assertEquals(1,video.getScaleX(),.001f);
+        activity.focused=true; t.onWindowFocusChanged(true); t.onPreDraw(); assertTrue(t.active); assertNotNull(t.chip.get());
+    }
+    @Test public void invisibleWindowCannotBootstrapEvenWithStaleFocus() {
+        viewer.windowVisibility=View.GONE; FoldReels.Watcher.Tracker t=start(); assertFalse(t.active); assertNull(t.chip.get());
+        viewer.windowVisibility=View.VISIBLE; t.onPreDraw(); assertTrue(state(t),t.active); assertNotNull(t.chip.get());
+    }
+    @Test public void knownPauseWinsOverStaleWindowFocusAndResumeRestores() {
+        FoldReels.Watcher.Tracker t=start(); FoldReels.watcher.onActivityPaused(activity); t.onPreDraw();
+        assertFalse(t.active); assertEquals(View.GONE,t.chip.get().getVisibility()); assertEquals(1,video.getScaleX(),.001f);
+        FoldReels.watcher.onActivityResumed(activity); t.onPreDraw(); assertTrue(t.active); assertEquals(View.VISIBLE,t.chip.get().getVisibility());
+    }
+    @Test public void detachReattachRestoresAndCreatesOnlyOneNewPresentation() {
+        FoldReels.Watcher.Tracker t=start(); TextView old=t.chip.get(); body.removeView(viewer);
+        assertEquals(1,video.getScaleX(),.001f); assertFalse(t.observersAttached); assertNull(old.getParent());
+        FoldReelsTestFixture.add(body,viewer,0,0,420,760); FoldReels.attachViewer(viewer);
+        FoldReels.Watcher.Tracker next=FoldReels.watcher.trackers.get(activity); next.onPreDraw();
+        assertTrue(next.active); assertEquals(1,next.viewers.size()); assertEquals(1,next.observerInstallations); assertNotNull(next.chip.get());
+    }
+    @Test public void foldRoundTripRestoresProfilesWithoutRecreatingPlayerOrShortcut() {
+        FoldReels.Watcher.Tracker t=start(); TextView chip=t.chip.get();
+        Configuration config=new Configuration(activity.getResources().getConfiguration()); config.screenWidthDp=768; config.screenHeightDp=1024;
+        activity.getResources().updateConfiguration(config,activity.getResources().getDisplayMetrics()); t.onPreDraw();
+        assertEquals(FoldReelsPolicy.WindowKind.WIDE,t.windowKind); assertEquals(1,video.getScaleX(),.001f); assertSame(chip,t.chip.get());
+        config.screenWidthDp=420; config.screenHeightDp=900; activity.getResources().updateConfiguration(config,activity.getResources().getDisplayMetrics()); t.onPreDraw();
+        assertEquals(FoldReelsPolicy.WindowKind.COMPACT,t.windowKind); assertTrue(video.getScaleX()>1); assertSame(chip,t.chip.get());
+        assertEquals(1,t.observerInstallations); assertEquals(0,activity.recreations); assertEquals(0,activity.configurations);
+    }
+    @Test public void nativePolicyExperimentIsLatchedUntilNextInstallation() {
+        start(); assertEquals(Boolean.TRUE,FoldReels.override("111584::9"));
+        FoldReels.prefs.put("fold_reels_native_policy","no_two_pane"); assertEquals(Boolean.TRUE,FoldReels.override("111584::9"));
+        FoldReels.resetForTests(); start(); assertEquals(Boolean.FALSE,FoldReels.override("111584::9")); assertEquals(Boolean.TRUE,FoldReels.override("111584::10")); assertEquals(0,activity.recreations);
+    }
+    @Test public void shortcutPreferenceHidesAndRestoresOneChip() {
+        FoldReels.Watcher.Tracker t=start(); TextView chip=t.chip.get(); FoldReels.prefs.put(FoldReelsPreferences.key(false,"shortcut"),false); t.onPreDraw();
+        assertEquals(View.GONE,chip.getVisibility()); FoldReels.prefs.put(FoldReelsPreferences.key(false,"shortcut"),true); t.onPreDraw(); assertSame(chip,t.chip.get()); assertEquals(View.VISIBLE,chip.getVisibility());
+    }
+    @Test public void destructionReleasesObserversAndTrackedViews() {
+        FoldReels.Watcher.Tracker t=start(); FoldReels.watcher.onActivityDestroyed(activity);
