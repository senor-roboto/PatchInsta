+            String failure = "none";
+            long lastFrame;
+            TextView chip;
+            FrameLayout content;
+            Tracker(Activity activity) { owner = new WeakReference<>(activity); }
+            void attachObservers() {
+                Activity activity = owner.get();
+                if (activity == null || observersAttached) return;
+                activity.registerComponentCallbacks(this);
+                activity.getWindow().getDecorView().getViewTreeObserver().addOnPreDrawListener(this);
+                observersAttached = true;
+            }
+            void capture() {
+                Activity activity = owner.get();
+                if (activity == null || foreground.get() != activity) return;
+                Configuration config = activity.getResources().getConfiguration();
+                FoldReelsPolicy.WindowKind next = FoldReelsPolicy.classify(config.screenWidthDp, config.screenHeightDp);
+                String override = SharedPref.getStringPref("fold_reels_profile_v3", "auto");
+                if (override.equals("cover")) next = FoldReelsPolicy.WindowKind.COMPACT;
+                if (override.equals("inner")) next = FoldReelsPolicy.WindowKind.WIDE;
+                if (next != FoldReelsPolicy.WindowKind.UNKNOWN && next != kind) { kind = next; force = true; }
+            }
