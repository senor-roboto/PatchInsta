+        new AlertDialog.Builder(activity).setTitle(str("piko_fold_reels_profile"))
+                .setSingleChoiceItems(new String[]{str("piko_fold_reels_auto"), str("piko_fold_reels_force_cover"), str("piko_fold_reels_force_inner")}, index,
+                        (dialog, which) -> {
