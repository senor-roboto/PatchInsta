+    Context context;
+    @Before public void setup(){context=RuntimeEnvironment.getApplication();context.getSharedPreferences("piko_settings",0).edit().clear().commit();}
+    @Test public void newDefaultsAreCleanCoverAndFullInner(){
+        FoldReelsPreferences p=new FoldReelsPreferences(context);
+        assertEquals(FoldReelsControls.Actions.COMMENT_ONLY,p.read(false).actions);assertEquals(FoldReelsMetadata.Mode.COMPACT,p.read(false).metadata);
+        assertEquals(FoldReelsControls.Actions.ALL,p.read(true).actions);assertEquals(FoldReelsMetadata.Mode.FULL,p.read(true).metadata);assertFalse(p.read(true).card);assertFalse(p.read(true).crop);
+    }
+    @Test public void legacyExplicitMinimalChoiceMigratesOnce(){
+        context.getSharedPreferences("piko_settings",0).edit().putBoolean(FoldReelsPreferences.LEGACY_MINIMAL,false).commit();
+        FoldReelsPreferences p=new FoldReelsPreferences(context);assertEquals(FoldReelsControls.Actions.ALL,p.read(false).actions);
+        p.put(FoldReelsPreferences.key(false,"actions"),"NONE");new FoldReelsPreferences(context);assertEquals(FoldReelsControls.Actions.NONE,p.read(false).actions);
+        p.storage.edit().remove(FoldReelsPreferences.key(false,"actions")).putBoolean(FoldReelsPreferences.LEGACY_MINIMAL,true).commit();
+        p=new FoldReelsPreferences(context);assertEquals(FoldReelsControls.Actions.COMMENT_ONLY,p.read(false).actions);
+    }
+    @Test public void presetsAreAtomicAndDoNotOverwriteInnerPreferences(){
+        FoldReelsPreferences p=new FoldReelsPreferences(context);p.crop(true,true);p.put(FoldReelsPreferences.key(true,"zoom_v3"),"1.5");
+        p.preset(false);assertFalse(p.read(false).crop);assertFalse(p.read(false).tabs);assertFalse(p.read(false).edges);assertEquals(FoldReelsMetadata.Mode.FULL,p.read(false).metadata);
+        p.preset(true);assertTrue(p.read(false).crop);assertTrue(p.read(false).tabs);assertTrue(p.read(false).card);assertEquals(FoldReelsControls.Actions.COMMENT_ONLY,p.read(false).actions);
+        assertTrue(p.read(true).crop);assertEquals(1.5f,p.read(true).zoom,.001f);
+    }
+    @Test public void malformedModesAndZoomFallBackToNativeSafeValues(){
+        FoldReelsPreferences p=new FoldReelsPreferences(context);p.put(FoldReelsPreferences.key(false,"actions"),"BAD");p.put(FoldReelsPreferences.key(false,"metadata"),"BAD");p.put(FoldReelsPreferences.key(false,"zoom_v3"),"NaN");
