@@ -0,0 +1,56 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+/** Pure policy; no device names, pixel resolutions, View mutations or numeric flags. */
+public final class FoldReelsPolicy {
+    private FoldReelsPolicy() {}
+
+    public enum WindowKind { UNKNOWN, COMPACT, WIDE }
+
+    public static WindowKind classify(float widthDp, float heightDp) {
+        if (!Float.isFinite(widthDp) || !Float.isFinite(heightDp)
+                || widthDp <= 0 || heightDp <= 0) return WindowKind.UNKNOWN;
+        // Rotation alone must not turn the cover window into the inner-screen mode.
+        return Math.min(widthDp, heightDp) >= 600f ? WindowKind.WIDE : WindowKind.COMPACT;
+    }
+
+    /** null delegates to Piko / Instagram; only exact, audited Boolean keys match. */
+    public static Boolean override(String key, WindowKind kind,
+                                   boolean enabled, boolean coverCrop, boolean innerCrop) {
+        if (!enabled || kind == null || kind == WindowKind.UNKNOWN || key == null) return null;
+        boolean wide = kind == WindowKind.WIDE;
+        boolean crop = wide ? innerCrop : coverCrop;
+        boolean wideLayout = wide && !innerCrop;
+        switch (key) {
+            // ig_android_reels_dynamic_cropping_h1_2025
+            // Native numerical thresholds and baked-in black borders are not overridden.
+            case "83325::1": return crop; // should_dynamic_crop
+            case "83325::3": return crop ? Boolean.TRUE : null; // crop_organic_only
+            case "83325::4": return crop ? Boolean.FALSE : null; // crop_ads_only
+            // ig_reels_width_change_large_screens / ..._user_based
+            case "55842::0":
+            case "55943::0": return wideLayout;
+            // ig_pandroid_foldables: retain Instagram's native controls and hit targets.
+            case "111584::9":  // reels_viewer_two_pane_enabled
+            case "111584::10": // reels_viewer_ui_refresh
+            case "111584::11": // enable_watch_and_comment_portrait
+            case "111584::12": // watch_and_comment_insets_enabled
+            case "111584::25": // reels_viewer_two_pane_comments_slide_fix
+            case "111584::27": // reels_viewer_two_pane_full_video_height
+                return wideLayout;
+            case "111584::17": // large_screen_gating_can_resize_fix
+            case "111584::26": // nav_bar_visibility_restore_fix
+            case "56160::1":   // is_mw_bottom_padding_enabled
+            case "72006::9":   // enable_fullscreen_view_in_overflow_menu
+                return true;
+            default: return null;
+        }
+    }
+
+    public static boolean handles(String key) {
+        // No Android resource reads for unrelated MobileConfig queries.
+        return key != null && (key.startsWith("83325::") || key.startsWith("55842::")
+                || key.startsWith("55943::") || key.startsWith("111584::")
+                || key.equals("56160::1") || key.equals("72006::9"));
+    }
+}
diff --git a/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsRefreshGate.java b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsRefreshGate.java
