+                    stopPresentation(); return;
+                }
+                boolean inner = wide(), crop = SharedPref.getBooleanPref(cropSetting(inner));
+                boolean immersive = !inner && SharedPref.getBooleanPref(Settings.FOLD_REELS_COVER_IMMERSIVE);
