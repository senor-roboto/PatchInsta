+++ b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsRefreshGate.java
@@ -0,0 +1,33 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import app.morphe.extension.instagram.patches.reels.FoldReelsPolicy.WindowKind;
+
+/** Pure state machine: at most one recreation per Activity, after a stable mode change. */
+public final class FoldReelsRefreshGate {
+    public static final long SETTLE_MS = 450;
+    private WindowKind rendered = WindowKind.UNKNOWN;
+    private WindowKind current = WindowKind.UNKNOWN;
+    private long changedAt;
+    private boolean requested;
+
+    public void observe(WindowKind next, long now, boolean viewerPresent) {
+        if (next == null || next == WindowKind.UNKNOWN || requested) return;
+        if (current != next) {
+            current = next;
+            changedAt = now;
+        }
+        // No viewer exists yet: it will be created with the latest mode.
+        if (rendered == WindowKind.UNKNOWN || !viewerPresent) rendered = current;
+    }
+
+    public boolean pending() {
+        return !requested && rendered != WindowKind.UNKNOWN && current != rendered;
+    }
+
+    public boolean ready(long now, boolean resumed, boolean viewerVisible, boolean enabled) {
+        return pending() && resumed && viewerVisible && enabled && now - changedAt >= SETTLE_MS;
+    }
+
+    public void markRequested() { requested = true; }
+}
