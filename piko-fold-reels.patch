@@ -0,0 +1,57 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+/** Native layout hints. The renderer owns crop, independently of cached MobileConfig values. */
+public final class FoldReelsPolicy {
+    private FoldReelsPolicy() {}
+
+    public enum WindowKind { UNKNOWN, COMPACT, WIDE }
+
+    public static WindowKind classify(float widthDp, float heightDp) {
+        if (!Float.isFinite(widthDp) || !Float.isFinite(heightDp)
+                || widthDp <= 0 || heightDp <= 0) return WindowKind.UNKNOWN;
+        // Rotation alone must not turn the cover window into the inner-screen mode.
+        float shortSide = Math.min(widthDp, heightDp), longSide = Math.max(widthDp, heightDp);
+        // A high-resolution narrow cover window must not become a tablet due to display scaling.
+        return shortSide >= 600f && shortSide / longSide >= .70f ? WindowKind.WIDE : WindowKind.COMPACT;
+    }
+
+    /** null delegates to Piko / Instagram; only exact, audited Boolean keys match. */
+    public static Boolean override(String key, WindowKind kind,
+                                   boolean enabled, boolean coverCrop, boolean innerCrop) {
+        if (!enabled || kind == null || kind == WindowKind.UNKNOWN || key == null) return null;
+        // These feature gates may be cached when the player is created. Keep the same
+        // responsive controls available on both displays; native sizing still follows the window.
+        // Only the presentation layer selects a crop profile. No gate flips at each fold.
+        boolean wideLayout = true;
+        switch (key) {
+            // ig_android_reels_dynamic_cropping_h1_2025
+            // Avoid compounding Instagram threshold-based crop with our direct presentation.
+            case "83325::1": return false; // should_dynamic_crop
+            // ig_reels_width_change_large_screens / ..._user_based
+            case "55842::0":
+            case "55943::0": return wideLayout;
+            // ig_pandroid_foldables: retain Instagram's native controls and hit targets.
+            case "111584::9":  // reels_viewer_two_pane_enabled
+            case "111584::10": // reels_viewer_ui_refresh
+            case "111584::11": // enable_watch_and_comment_portrait
+            case "111584::12": // watch_and_comment_insets_enabled
+            case "111584::25": // reels_viewer_two_pane_comments_slide_fix
+            case "111584::27": // reels_viewer_two_pane_full_video_height
+                return wideLayout;
+            case "111584::17": // large_screen_gating_can_resize_fix
+            case "111584::26": // nav_bar_visibility_restore_fix
+            case "56160::1":   // is_mw_bottom_padding_enabled
+            case "72006::9":   // enable_fullscreen_view_in_overflow_menu
+                return true;
+            default: return null;
+        }
+    }
+
+    public static boolean handles(String key) {
+        // No Android resource reads for unrelated MobileConfig queries.
+        return key != null && (key.startsWith("83325::") || key.startsWith("55842::")
+                || key.startsWith("55943::") || key.startsWith("111584::")
+                || key.equals("56160::1") || key.equals("72006::9"));
+    }
+}
diff --git a/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsRenderer.java b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsRenderer.java
new file mode 100644
index 0000000..a122a89
--- /dev/null
+++ b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsRenderer.java
@@ -0,0 +1,218 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.graphics.Matrix;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.os.Build;
+import android.view.SurfaceView;
+import android.view.TextureView;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewParent;
+import java.util.ArrayList;
+import java.util.IdentityHashMap;
+import java.util.Map;
+
+/** Changes only the active rendering leaf. Never reparents a surface or touches the player. */
+final class FoldReelsRenderer {
+    private View selected;
+    private View lastViewer, lastBoundary;
+    private Transform transform;
+    private final Map<ViewGroup, ClipState> clips = new IdentityHashMap<>();
+    private final ArrayList<View> surfaces = new ArrayList<>();
+    private final Rect visible = new Rect();
+    private String status = "waiting";
+    private int nodes;
+
+    String status() { return status; }
+
+    boolean apply(View viewer, RectF viewport, View boundary, boolean crop, float zoom) {
+        if (Build.VERSION.SDK_INT < 29) { status = "live-framing-requires-api29"; return false; }
+        if (lastViewer != viewer || lastBoundary != boundary) {
+            restore(); lastViewer = viewer; lastBoundary = boundary;
+        }
+        surfaces.clear();
+        nodes = 0;
+        collect(viewer, 0);
+        View best = null;
+        float bestArea = 0;
+        for (View candidate : surfaces) {
+            RectF bounds = originalBounds(candidate);
+            float area = bounds.width() * bounds.height();
+            RectF intersection = new RectF(bounds);
+            if (!intersection.intersect(viewport)) continue;
+            if (!FoldReelsGeometry.mostlyVisible(area, intersection.width() * intersection.height())) continue;
+            if (intersection.width() < viewport.width() * .20f
+                    || intersection.height() < viewport.height() * .30f) continue;
+            if (area > bestArea) { best = candidate; bestArea = area; }
+        }
+        if (best != selected) { restore(); selected = best; }
+        if (best == null) { status = "no-visible-surface (candidates=" + surfaces.size() + ")"; return false; }
+        // No crop and no extra zoom is the native, reversible layout used by the inner display.
+        if (!crop && zoom <= 1f) {
+            restoreTransform();
+            status = "native-fit " + best.getClass().getSimpleName();
+            return true;
+        }
+        if (transform == null) transform = new Transform(best);
+        transform.captureNativeChanges(best);
+        RectF source = transform.bounds(best);
+        if (!validAncestors(best, boundary)) { restore(); status = "unsupported-parent-transform"; return false; }
+        float factor = FoldReelsGeometry.scale(source.width(), source.height(),
+                viewport.width(), viewport.height(), crop, zoom);
+        if (!Float.isFinite(factor) || factor <= 0 || factor > 12) {
+            restore(); status = "invalid-surface-geometry"; return false;
+        }
+        // Let the video cross its old letterbox containers. The outer boundary keeps its clip.
+        for (ViewParent p = best.getParent(); p instanceof ViewGroup && p != boundary; p = p.getParent()) {
+            ViewGroup group = (ViewGroup) p;
+            ClipState state = clips.get(group);
+            if (state == null) { state = new ClipState(group); clips.put(group, state); }
+            state.open(group);
+        }
+        // Keep the video attached to its page while the user swipes. Do not pin it to the window.
+        RectF movingTarget = new RectF(viewport);
+        RectF viewerBounds = globalBounds(viewer);
+        for (ViewParent p = best.getParent(); p instanceof View && p != viewer; p = p.getParent()) {
+            View page = (View) p;
+            if (Math.abs(page.getHeight() - viewer.getHeight()) <= viewer.getHeight() * .08f) {
+                movingTarget.offset(0, globalBounds(page).top - viewerBounds.top);
+                break;
+            }
+        }
+        transform.apply(best, source, movingTarget, factor);
+        status = best.getClass().getSimpleName() + " " + Math.round(source.width()) + "x"
+                + Math.round(source.height()) + " -> " + Math.round(viewport.width()) + "x"
+                + Math.round(viewport.height()) + " scale=" + factor;
+        return true;
+    }
+
+    private static RectF globalBounds(View view) {
+        RectF bounds = new RectF(0, 0, view.getWidth(), view.getHeight());
+        Matrix matrix = new Matrix(); view.transformMatrixToGlobal(matrix); matrix.mapRect(bounds);
+        return bounds;
+    }
+
+    private void collect(View view, int depth) {
+        if (++nodes > 1600 || depth > 40 || view.getVisibility() != View.VISIBLE) return;
+        if (view instanceof TextureView || view instanceof SurfaceView) {
+            if (view.getWidth() > 0 && view.getHeight() > 0 && view.isShown()
+                    && view.getGlobalVisibleRect(visible)) surfaces.add(view);
+            return;
+        }
+        if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) collect(group.getChildAt(i), depth + 1);
+        }
+    }
+
+    private RectF originalBounds(View view) {
+        if (view == selected && transform != null) {
+            transform.captureNativeChanges(view);
+            return transform.bounds(view);
+        }
+        return new Transform(view).bounds(view);
+    }
+
+    private static boolean validAncestors(View view, View boundary) {
+        for (View current = view; current != null; ) {
+            if (Math.abs(current.getRotation()) > .01f || Math.abs(current.getRotationX()) > .01f
+                    || Math.abs(current.getRotationY()) > .01f) return false;
+            if (current != view && (Math.abs(current.getScaleX() - 1) > .01f
+                    || Math.abs(current.getScaleY() - 1) > .01f)) return false;
+            if (current == boundary) return true;
+            current = current.getParent() instanceof View ? (View) current.getParent() : null;
+        }
+        return false;
+    }
+
+    void restore() { restoreTransform(); selected = null; }
+
+    private void restoreTransform() {
+        if (selected != null && transform != null) transform.restore(selected);
+        transform = null;
+        for (Map.Entry<ViewGroup, ClipState> entry : clips.entrySet()) entry.getValue().restore(entry.getKey());
+        clips.clear();
+    }
+
+    private static boolean equal(float a, float b) { return Math.abs(a - b) < .0001f; }
+
+    private static final class Transform {
+        float sx, sy, tx, ty, appliedSx, appliedSy, appliedTx, appliedTy;
+        boolean applied;
+        Transform(View view) { read(view); }
+        void read(View v) { sx = v.getScaleX(); sy = v.getScaleY(); tx = v.getTranslationX(); ty = v.getTranslationY(); }
+        void captureNativeChanges(View v) {
+            if (!applied) { read(v); return; }
+            // A recycled player or a native animation can replace any individual property.
+            if (!equal(v.getScaleX(), appliedSx)) sx = v.getScaleX();
+            if (!equal(v.getScaleY(), appliedSy)) sy = v.getScaleY();
+            if (!equal(v.getTranslationX(), appliedTx)) tx = v.getTranslationX();
+            if (!equal(v.getTranslationY(), appliedTy)) ty = v.getTranslationY();
+        }
+        RectF bounds(View v) {
+            RectF local = new RectF(0, 0, v.getWidth(), v.getHeight());
+            if (v instanceof TextureView) {
+                Matrix texture = ((TextureView) v).getTransform(new Matrix());
+                texture.mapRect(local);
+                if (!local.intersect(0, 0, v.getWidth(), v.getHeight())) return new RectF();
+            }
+            float px = v.getPivotX(), py = v.getPivotY();
+            local.set(px + (local.left - px) * sx + tx, py + (local.top - py) * sy + ty,
+                    px + (local.right - px) * sx + tx, py + (local.bottom - py) * sy + ty);
+            View parent = v.getParent() instanceof View ? (View) v.getParent() : null;
+            local.offset(v.getLeft() - (parent == null ? 0 : parent.getScrollX()),
+                    v.getTop() - (parent == null ? 0 : parent.getScrollY()));
+            if (parent != null) {
+                Matrix global = new Matrix();
+                parent.transformMatrixToGlobal(global);
+                global.mapRect(local);
+            }
+            return local;
+        }
+        void apply(View v, RectF source, RectF target, float factor) {
+            // Parents have unit scale. Keep native pivot and account for off-centre texture content.
+            float[] pivot = {v.getPivotX() + v.getLeft(), v.getPivotY() + v.getTop()};
+            View parent = (View) v.getParent();
+            pivot[0] -= parent.getScrollX(); pivot[1] -= parent.getScrollY();
+            Matrix global = new Matrix(); parent.transformMatrixToGlobal(global); global.mapPoints(pivot);
+            float centreXWithoutTranslation = source.centerX() - tx;
+            float centreYWithoutTranslation = source.centerY() - ty;
+            appliedSx = sx * factor; appliedSy = sy * factor;
+            appliedTx = FoldReelsGeometry.translation(target.centerX(), pivot[0], centreXWithoutTranslation, factor);
+            appliedTy = FoldReelsGeometry.translation(target.centerY(), pivot[1], centreYWithoutTranslation, factor);
+            if (!equal(v.getScaleX(), appliedSx)) v.setScaleX(appliedSx);
+            if (!equal(v.getScaleY(), appliedSy)) v.setScaleY(appliedSy);
+            if (!equal(v.getTranslationX(), appliedTx)) v.setTranslationX(appliedTx);
+            if (!equal(v.getTranslationY(), appliedTy)) v.setTranslationY(appliedTy);
+            applied = true;
+        }
+        void restore(View v) {
+            if (!applied) return;
+            if (equal(v.getScaleX(), appliedSx)) v.setScaleX(sx);
+            if (equal(v.getScaleY(), appliedSy)) v.setScaleY(sy);
+            if (equal(v.getTranslationX(), appliedTx)) v.setTranslationX(tx);
+            if (equal(v.getTranslationY(), appliedTy)) v.setTranslationY(ty);
+        }
+    }
+
+    private static final class ClipState {
+        final boolean children, padding, outline;
+        Rect bounds;
+        ClipState(ViewGroup group) {
+            children = group.getClipChildren(); padding = group.getClipToPadding();
+            outline = group.getClipToOutline(); bounds = group.getClipBounds();
+        }
+        void open(ViewGroup group) {
+            if (group.getClipChildren()) group.setClipChildren(false);
+            if (group.getClipToPadding()) group.setClipToPadding(false);
+            if (group.getClipToOutline()) group.setClipToOutline(false);
+            if (group.getClipBounds() != null) { bounds = group.getClipBounds(); group.setClipBounds(null); }
+        }
+        void restore(ViewGroup group) {
+            group.setClipChildren(children); group.setClipToPadding(padding); group.setClipToOutline(outline);
+            if (group.getClipBounds() == null) group.setClipBounds(bounds);
+        }
+    }
+}
