diff --git a/tests/fold-reels/FoldReelsPolicyTest.java b/tests/fold-reels/FoldReelsPolicyTest.java
new file mode 100644
index 0000000..ba51da7
--- /dev/null
+++ b/tests/fold-reels/FoldReelsPolicyTest.java
@@ -0,0 +1,93 @@
+import app.morphe.extension.instagram.patches.reels.FoldReelsPolicy;
+import app.morphe.extension.instagram.patches.reels.FoldReelsGeometry;
+import static app.morphe.extension.instagram.patches.reels.FoldReelsPolicy.WindowKind.*;
+
+/** Real geometry invariants and regression scenarios; no claim to simulate Instagram. */
+public final class FoldReelsPolicyTest {
+    private static int checks;
+    private static void eq(Object expected, Object actual) {
+        checks++;
+        if (!java.util.Objects.equals(expected, actual)) throw new AssertionError("Check " + checks + ": " + expected + " != " + actual);
+    }
+    private static void near(float expected, float actual) {
+        checks++;
+        if (!Float.isFinite(actual) || Math.abs(expected - actual) > .002f)
+            throw new AssertionError("Check " + checks + ": " + expected + " != " + actual);
+    }
+    public static void main(String[] args) {
+        eq(COMPACT, FoldReelsPolicy.classify(420, 900));
+        eq(COMPACT, FoldReelsPolicy.classify(900, 420));
+        eq(COMPACT, FoldReelsPolicy.classify(648, 1024)); // Narrow window, even above 600 dp.
+        eq(COMPACT, FoldReelsPolicy.classify(1024, 648));
+        eq(WIDE, FoldReelsPolicy.classify(840, 900));
+        eq(WIDE, FoldReelsPolicy.classify(900, 840));
+        eq(WIDE, FoldReelsPolicy.classify(768, 1024));
+        eq(WIDE, FoldReelsPolicy.classify(1024, 768));
+        eq(COMPACT, FoldReelsPolicy.classify(599, 800)); // Small multi-window.
+        eq(WIDE, FoldReelsPolicy.classify(600, 800));
+        eq(UNKNOWN, FoldReelsPolicy.classify(0, 900));
+        eq(UNKNOWN, FoldReelsPolicy.classify(-1, 900));
+        eq(UNKNOWN, FoldReelsPolicy.classify(Float.NaN, 900));
+        eq(UNKNOWN, FoldReelsPolicy.classify(900, Float.POSITIVE_INFINITY));
+        for (String key : new String[]{"83325::1", "55842::0", "55943::0", "111584::9", "111584::27"}) {
+            eq(null, FoldReelsPolicy.override(key, UNKNOWN, true, true, false));
+            eq(null, FoldReelsPolicy.override(key, WIDE, false, true, false));
+            Boolean original = FoldReelsPolicy.override(key, COMPACT, true, true, false);
+            for (var mode : new FoldReelsPolicy.WindowKind[]{COMPACT, WIDE}) {
+                for (boolean cover : new boolean[]{false, true}) for (boolean inner : new boolean[]{false, true})
+                    eq(original, FoldReelsPolicy.override(key, mode, true, cover, inner));
+            }
+        }
+        eq(false, FoldReelsPolicy.override("83325::1", COMPACT, true, true, false)); // No double crop.
+        eq(true, FoldReelsPolicy.override("111584::9", WIDE, true, true, true)); // Keep controls with inner crop.
+        for (String key : new String[]{"83325::0", "83325::3", "111584::29", "111584::30", "999999::1"})
+            eq(null, FoldReelsPolicy.override(key, WIDE, true, true, true));
+        eq(false, FoldReelsPolicy.handles(null));
+        eq(false, FoldReelsPolicy.handles("unrelated"));
+
+        // Screenshot-like viewports: uniform crop covers BOTH dimensions, fit covers neither beyond bounds.
+        for (float[] window : new float[][]{{972, 1312}, {1160, 1400}, {1400, 1160}, {420, 900}}) {
+            for (float[] video : new float[][]{{738, 1312}, {1920, 1080}, {1080, 1080}}) {
+                float fill = FoldReelsGeometry.scale(video[0], video[1], window[0], window[1], true, 1);
+                float fit = FoldReelsGeometry.scale(video[0], video[1], window[0], window[1], false, 1);
+                eq(true, video[0] * fill >= window[0] - .001f && video[1] * fill >= window[1] - .001f);
+                eq(true, video[0] * fit <= window[0] + .001f && video[1] * fit <= window[1] + .001f);
+                near(fill * 1.5f, FoldReelsGeometry.scale(video[0], video[1], window[0], window[1], true, 1.5f));
+            }
+        }
+        eq(true, Float.isNaN(FoldReelsGeometry.scale(0, 100, 100, 100, true, 1)));
+        eq(true, Float.isNaN(FoldReelsGeometry.scale(100, Float.NaN, 100, 100, true, 1)));
+        eq(true, Float.isNaN(FoldReelsGeometry.scale(100, 100, 100, 100, true, Float.NaN)));
+        near(2.5f, FoldReelsGeometry.scale(100, 100, 100, 100, true, 10));
+        eq(true, FoldReelsGeometry.mostlyVisible(100, 60));
+        eq(false, FoldReelsGeometry.mostlyVisible(100, 59)); // Reject adjacent preloaded page.
+        eq(false, FoldReelsGeometry.mostlyVisible(0, 0));
+        // Existing off-centre native texture and pivot: the displayed centre must land exactly on target.
+        for (float pivot : new float[]{0, 100, 500}) for (float centre : new float[]{200, 600}) {
+            float shift = FoldReelsGeometry.translation(486, pivot, centre, 1.7f);
+            near(486, pivot + (centre - pivot) * 1.7f + shift);
+            near(0, FoldReelsGeometry.translation(centre, pivot, centre, 1));
+        }
+        // Enlarging the viewport without relaying out Instagram must still tile adjacent pages.
+        for (int i = 0; i <= 120; i++) {
+            float distance = 1400f * i / 120;
+            float outgoing = FoldReelsGeometry.pageOffset(-distance, 1400, 1600);
+            float incoming = FoldReelsGeometry.pageOffset(1400 - distance, 1400, 1600);
+            near(outgoing + 1600, incoming);
+        }
+        near(-1600, FoldReelsGeometry.pageOffset(-1400, 1400, 1600));
+        near(0, FoldReelsGeometry.pageOffset(0, 1400, 1600));
+        near(1600, FoldReelsGeometry.pageOffset(1400, 1400, 1600));
+        eq(true, Float.isNaN(FoldReelsGeometry.pageOffset(1, 0, 1600)));
+        // Isolated no-two-pane experiment is stable across folds and changes exactly three keys.
+        for (String key : new String[]{"83325::1", "55842::0", "55943::0", "111584::9", "111584::10", "111584::11", "111584::12", "111584::17", "111584::25", "111584::26", "111584::27", "56160::1", "72006::9"}) {
+            boolean twoPane = key.equals("111584::9") || key.equals("111584::25") || key.equals("111584::27");
+            Boolean expected = twoPane ? false : FoldReelsPolicy.override(key, COMPACT, true, true, false);
+            eq(expected, FoldReelsPolicy.override(key, COMPACT, true, true, false, true));
+            eq(expected, FoldReelsPolicy.override(key, WIDE, true, true, false, true));
+            eq(null, FoldReelsPolicy.override(key, WIDE, false, true, false, true));
+            eq(null, FoldReelsPolicy.override(key, UNKNOWN, true, true, false, true));
+        }
+        System.out.println(checks + " policy/geometry checks passed (no device validation).");
+    }
+}
