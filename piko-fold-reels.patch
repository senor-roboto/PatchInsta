+            @Override public void onStartTrackingTouch(SeekBar bar) {}
+            @Override public void onStopTrackingTouch(SeekBar bar) {}
+        });
+        showBox(owner, box, inner);
+    }
+    private static void showAdvanced(Activity owner) {
+        LinearLayout box = box(owner);
+        addButton(box, str("piko_fold_reels_profile"), () -> showProfileOptions(owner));
+        addButton(box, str("piko_fold_reels_diagnostic"), () -> showDiagnostic(owner));
+        choose(box, "piko_fold_reels_native_policy", "fold_reels_native_policy", new String[]{"v4", "no_two_pane"},
+                new String[]{"piko_fold_reels_policy_v4", "piko_fold_reels_policy_experiment"}, prefs.string("fold_reels_native_policy", "v4"));
+        TextView hint = new TextView(owner); hint.setText(str("piko_fold_reels_policy_hint")); box.addView(hint);
+        addButton(box, str("piko_fold_reels_refresh_now"), () -> confirmRefresh(owner));
+        showBox(owner, box, wide());
+    }
+    private static LinearLayout box(Activity owner) {
+        LinearLayout box = new LinearLayout(owner); box.setOrientation(LinearLayout.VERTICAL);
+        int pad = dp(owner, 18); box.setPadding(pad, pad, pad, pad); return box;
+    }
+    private static AlertDialog showBox(Activity owner, LinearLayout box, boolean inner) {
+        ScrollView scroll = new ScrollView(owner); scroll.addView(box);
+        AlertDialog dialog = new AlertDialog.Builder(owner, AlertDialog.THEME_DEVICE_DEFAULT_DARK)
+                .setTitle(str("piko_fold_reels_menu_title") + " · " + str(inner ? "piko_fold_reels_inner" : "piko_fold_reels_cover"))
+                .setView(scroll).setPositiveButton(android.R.string.ok, null).create();
