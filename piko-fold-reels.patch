+        for (Iterator<Map.Entry<ViewGroup, Rail>> it = rails.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<ViewGroup, Rail> e = it.next(); ViewGroup view = e.getKey(); Rail rail = e.getValue();
+            if (!view.isAttachedToWindow() || !FoldReelsViews.descendant(view, viewer)) {
+                if (active.get() == view) cancel(); rail.restore(view); it.remove(); continue;
+            }
+            if (!enabled || !FoldReelsViews.unitParents(view, viewer)) { rail.restore(view); continue; }
+            rail.capture(view); FoldReelsViews.bounds(view, work, matrix);
+            work.offset(rail.x - view.getTranslationX(), rail.y - view.getTranslationY());
+            if (work.centerX() < viewerBounds.centerX()) { rail.restore(view); continue; }
+            rail.ax = rail.x + wantedRight - work.right;
+            rail.ay = rail.y;
+            View page = rail.page.get();
+            if (page != null && FoldReelsViews.descendant(view, page)) {
+                float nativeOffset = FoldReelsViews.pageOffset(page, viewer, page.getHeight(), work, matrix);
+                float visualOffset = FoldReelsGeometry.pageOffset(nativeOffset, page.getHeight(), viewport.height());
+                if (Float.isFinite(visualOffset)) rail.ay += visualOffset - nativeOffset;
+            }
+            if (Math.abs(view.getTranslationX() - rail.ax) > .01f) view.setTranslationX(rail.ax);
+            if (Math.abs(view.getTranslationY() - rail.ay) > .01f) view.setTranslationY(rail.ay);
+            rail.applied = true;
+            if (Math.abs(rail.ax - rail.x) > .5f || Math.abs(rail.ay - rail.y) > .5f) { clipping.openPath(view, viewer); moved++; }
+        }
+        if (!enabled) cancel();
+    }
+
+    /** Called before the native viewer dispatch; returns false for every unrelated touch. */
+    boolean routeTouch(View viewer, MotionEvent event) {
+        if (forwarding) return false;
+        int action = event.getActionMasked();
+        if (action == MotionEvent.ACTION_DOWN) {
+            cancel();
+            point[0] = event.getX(); point[1] = event.getY();
+            matrix.reset(); viewer.transformMatrixToGlobal(matrix); matrix.mapPoints(point);
+            for (Map.Entry<ViewGroup, Rail> e : rails.entrySet()) {
+                ViewGroup rail = e.getKey(); Rail state = e.getValue();
+                if (!state.applied || !rail.isShown() || rail.getAlpha() <= .01f) continue;
+                if (Math.abs(state.ax - state.x) <= .5f && Math.abs(state.ay - state.y) <= .5f) continue;
+                boolean hit = false;
+                for (WeakReference<View> ref : state.targets) {
+                    View target = ref.get();
+                    if (target == null || !target.isShown() || !target.isEnabled() || target.getAlpha() <= .01f) continue;
+                    FoldReelsViews.bounds(target, work, matrix);
+                    if (work.contains(point[0], point[1])) { hit = true; break; }
+                }
+                if (!hit || obscured(rail, viewer, point[0], point[1])) continue;
+                if (dispatch(rail, viewer, event)) {
+                    active = new WeakReference<>(rail); activeViewer = new WeakReference<>(viewer); down = MotionEvent.obtain(event); last = MotionEvent.obtain(event); return true;
+                }
+            }
+            return false;
+        }
+        if (down == null) return false;
+        ViewGroup rail = active.get();
+        if (rail == null || !rail.isAttachedToWindow()) { cancel(); return false; }
+        if (!swiping && (event.getPointerCount() > 1 || action == MotionEvent.ACTION_MOVE
+                && Math.hypot(event.getX() - down.getX(), event.getY() - down.getY())
+                > ViewConfiguration.get(viewer.getContext()).getScaledTouchSlop())) {
+            MotionEvent cancelled = MotionEvent.obtain(last); cancelled.setAction(MotionEvent.ACTION_CANCEL);
+            dispatch(rail, viewer, cancelled); cancelled.recycle(); swiping = true;
+            nativeDispatch(viewer, down); // Native pager receives a complete DOWN/MOVE/... stream.
+        }
+        if (swiping) nativeDispatch(viewer, event); else dispatch(rail, viewer, event);
+        if (last != null) last.recycle(); last = MotionEvent.obtain(event);
+        if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL) clearTouch();
+        return true;
+    }
+    private boolean obscured(View rail, View viewer, float x, float y) {
+        for (View branch = rail; branch != viewer && branch.getParent() instanceof ViewGroup; ) {
+            ViewGroup parent = (ViewGroup) branch.getParent();
+            int index = parent.indexOfChild(branch);
+            for (int i = 0; i < parent.getChildCount(); i++) {
+                View sibling = parent.getChildAt(i);
+                if (sibling == branch || sibling.getZ() < branch.getZ()
+                        || sibling.getZ() == branch.getZ() && i < index) continue;
+                if (covers(sibling, x, y, 0, new int[]{0})) return true;
+            }
+            branch = parent;
+        }
+        return false;
+    }
+    private boolean covers(View view, float x, float y, int depth, int[] count) {
+        if (++count[0] > 200 || depth > 20) return true;
+        if (!view.isShown() || view.getAlpha() <= .01f || view instanceof SurfaceView) return false;
+        FoldReelsViews.bounds(view, work, matrix);
+        if (!work.contains(x, y)) return false;
+        boolean painted = view.getBackground() != null;
+        if (view.getBackground() instanceof ColorDrawable)
+            painted = Color.alpha(((ColorDrawable) view.getBackground()).getColor()) > 0;
+        if (painted || view.isClickable() || view instanceof TextureView) return true;
+        if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = group.getChildCount() - 1; i >= 0; i--)
+                if (covers(group.getChildAt(i), x, y, depth + 1, count)) return true;
+        }
+        return false;
+    }
+
+    private boolean dispatch(View rail, View viewer, MotionEvent event) {
+        MotionEvent copy = MotionEvent.obtain(event);
+        matrix.reset(); viewer.transformMatrixToGlobal(matrix); copy.transform(matrix);
+        matrix.reset(); rail.transformMatrixToGlobal(matrix);
+        if (!matrix.invert(inverse)) { copy.recycle(); return false; }
+        copy.transform(inverse);
+        try { return rail.dispatchTouchEvent(copy); } finally { copy.recycle(); }
+    }
+    private void nativeDispatch(View viewer, MotionEvent event) {
+        MotionEvent copy = MotionEvent.obtain(event); forwarding = true;
+        try { viewer.dispatchTouchEvent(copy); } finally { forwarding = false; copy.recycle(); }
+    }
+    void cancel() {
+        ViewGroup rail = active.get(); View viewer = activeViewer.get();
+        if (viewer != null && last != null) {
+            MotionEvent cancelled = MotionEvent.obtain(last); cancelled.setAction(MotionEvent.ACTION_CANCEL);
+            if (swiping) nativeDispatch(viewer, cancelled);
+            else if (rail != null) dispatch(rail, viewer, cancelled);
+            cancelled.recycle();
+        }
+        clearTouch();
+    }
+    private void clearTouch() {
+        if (down != null) down.recycle(); if (last != null) last.recycle();
+        down = last = null; swiping = false; active.clear(); activeViewer.clear();
+    }
+    void restore() { cancel(); for (Map.Entry<ViewGroup, Rail> e : rails.entrySet()) e.getValue().restore(e.getKey()); rails.clear(); moved = 0; }
+    private static final class Candidate { final ViewGroup view; final int mask; Candidate(ViewGroup v, int m) { view = v; mask = m; } }
+    private static final class Rail {
+        final ArrayList<WeakReference<View>> targets = new ArrayList<>();
+        WeakReference<View> page = new WeakReference<>(null);
+        int seen; float x, y, ax, ay; boolean applied;
+        Rail(View view) { x = view.getTranslationX(); y = view.getTranslationY(); }
+        void capture(View view) {
+            if (!applied || Math.abs(view.getTranslationX() - ax) > .001f) x = view.getTranslationX();
+            if (!applied || Math.abs(view.getTranslationY() - ay) > .001f) y = view.getTranslationY();
+        }
+        void restore(View view) {
+            if (applied && Math.abs(view.getTranslationX() - ax) < .001f) view.setTranslationX(x);
+            if (applied && Math.abs(view.getTranslationY() - ay) < .001f) view.setTranslationY(y);
+            applied = false;
+        }
+    }
+}
