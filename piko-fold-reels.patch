+    static final class Watcher implements Application.ActivityLifecycleCallbacks {
+        final Map<Activity, Tracker> trackers = new WeakHashMap<>();
+        WeakReference<Activity> foreground = new WeakReference<>(null);
+        Tracker tracker(Activity activity) {
+            Tracker result = trackers.get(activity);
+            if (result == null) { result = new Tracker(activity); trackers.put(activity, result); }
+            return result;
+        }
+        void captureForeground() { Activity a = foreground.get(); if (a != null) tracker(a).capture(); }
+        void requestFrame() {
+            for (Tracker tracker : trackers.values()) tracker.requestFrame();
+        }
+        void addViewer(View view) {
+            Activity a = activityOf(view.getContext());
+            if (a == null || a.isFinishing() || a.isDestroyed()) return;
+            Tracker t = tracker(a);
+            boolean known = false;
+            for (WeakReference<View> ref : t.viewers) if (ref.get() == view) { known = true; break; }
+            if (!known) t.viewers.add(new WeakReference<>(view));
+            t.attachObservers(); t.capture(); t.markDiscovery();
+            if (t.presentable(view)) { foreground = new WeakReference<>(a); kind = t.windowKind; }
+            t.requestFrame();
+        }
+        void removeViewer(View view) {
+            Activity a = activityOf(view.getContext()); Tracker t = trackers.get(a);
+            if (t == null) return;
+            t.viewers.removeIf(ref -> ref.get() == null || ref.get() == view);
+            if (t.currentViewer.get() == view) t.stopPresentation();
+            t.markDiscovery();
+            if (t.viewers.isEmpty()) { t.dispose(); trackers.remove(a); }
+        }
+        private void lifecycle(Activity a, boolean resumed) {
+            Tracker t = tracker(a); t.lifecycleKnown = true; t.resumed = resumed;
+            if (resumed) { t.attachObservers(); t.capture(); t.markDiscovery(); t.requestFrame(); }
+            else { t.stopPresentation(); if (foreground.get() == a) foreground.clear(); }
+        }
+        @Override public void onActivityCreated(Activity a, Bundle state) { tracker(a).capture(); }
+        @Override public void onActivityResumed(Activity a) { lifecycle(a, true); }
+        @Override public void onActivityPaused(Activity a) { lifecycle(a, false); }
+        @Override public void onActivityStopped(Activity a) { Tracker t = trackers.get(a); if (t != null) { t.lifecycleKnown = true; t.resumed = false; t.stopPresentation(); } }
+        @Override public void onActivityStarted(Activity a) {}
+        @Override public void onActivitySaveInstanceState(Activity a, Bundle state) {}
+        @Override public void onActivityDestroyed(Activity a) {
+            Tracker t = trackers.remove(a); if (t != null) t.dispose();
+            if (foreground.get() == a) foreground.clear();
+        }
