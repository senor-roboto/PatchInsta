+    private static void showDiagnostic(Activity activity) {
+        Watcher.Tracker tracker = watcher.trackers.get(activity);
+        StringBuilder report = new StringBuilder("PatchInsta 4.1.0\n");
+        report.append("installed=").append(installed).append(" foreground=").append(watcher.foreground.get() == activity)
+                .append(" nativePolicy=").append(noTwoPane ? "no_two_pane" : "v4")
+                .append(" nextNativePolicy=").append(prefs.string("fold_reels_native_policy", "v4")).append('\n');
