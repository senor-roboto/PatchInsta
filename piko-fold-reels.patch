index 0000000..78460d6
--- /dev/null
+++ b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsRenderer.java
@@ -0,0 +1,190 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.graphics.Matrix;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.os.Build;
+import android.view.SurfaceView;
+import android.view.TextureView;
+import android.view.View;
+import android.view.ViewParent;
+import android.view.ViewGroup;
+import java.lang.ref.WeakReference;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.Objects;
+import java.util.WeakHashMap;
+
+/** Discovery is event driven; every known pager surface is framed before each draw, including neighbours. */
+final class FoldReelsRenderer implements View.OnLayoutChangeListener, View.OnAttachStateChangeListener {
+    private final WeakHashMap<View, SurfaceState> states = new WeakHashMap<>();
+    private final Runnable changed;
+    private final RectF viewerBounds = new RectF();
+    private final Matrix matrix = new Matrix();
+    private int generation, nodes, framed, unanchored;
+    private long discoveries, frames;
+    FoldReelsRenderer(Runnable changed) { this.changed = changed; }
+
+    String status() { return "surfaces=" + states.size() + " framed=" + framed + " unanchored=" + unanchored
+            + " discoveries=" + discoveries + " frames=" + frames; }
+    int surfaceCount() { return states.size(); }
+    long discoveryCount() { return discoveries; }
+
+    void discover(View viewer) {
+        generation++; discoveries++; nodes = 0;
+        collect(viewer, viewer, 0);
+        for (Iterator<Map.Entry<View, SurfaceState>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, SurfaceState> e = it.next();
+            if (e.getValue().seen != generation) { release(e.getKey(), e.getValue()); it.remove(); }
+        }
+    }
+    private void collect(View view, View viewer, int depth) {
+        if (++nodes > 1600 || depth > 40) return;
+        if (view instanceof TextureView || view instanceof SurfaceView) {
+            if (!view.isAttachedToWindow()) return;
+            SurfaceState state = states.get(view);
+            if (state == null) {
+                state = new SurfaceState(view); states.put(view, state);
+                view.addOnLayoutChangeListener(this); view.addOnAttachStateChangeListener(this);
+            }
+            state.seen = generation;
+            state.page = new WeakReference<>(FoldReelsViews.page(view, viewer));
+            return; // Visibility and intersection are deliberately NOT discovery gates.
+        }
+        if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) collect(group.getChildAt(i), viewer, depth + 1);
+        }
+    }
+
+    boolean frame(View viewer, RectF viewport, View boundary, boolean crop, float zoom, FoldReelsClipping clipping) {
+        if (Build.VERSION.SDK_INT < 29) return false;
+        frames++; framed = 0; unanchored = 0;
+        FoldReelsViews.bounds(viewer, viewerBounds, matrix);
+        for (Iterator<Map.Entry<View, SurfaceState>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, SurfaceState> e = it.next(); View view = e.getKey(); SurfaceState state = e.getValue();
+            if (!view.isAttachedToWindow() || !FoldReelsViews.descendant(view, viewer)) {
+                release(view, state); it.remove(); continue;
+            }
+            // Register zero-sized players during discovery; frame them as soon as their first layout is ready.
+            if (view.getWidth() <= 0 || view.getHeight() <= 0) continue;
+            if (!crop && zoom <= 1f) { state.restore(view); framed++; continue; }
+            state.capture(view);
+            View page = state.page.get();
+            if (page == null || page.getHeight() < viewer.getHeight() * .75f || !FoldReelsViews.descendant(view, page)) {
+                // Unknown page boundaries must not let an offscreen renderer paint over another Reel.
+                state.restore(view); unanchored++; continue;
+            }
+            if (!FoldReelsViews.unitParents(view, boundary)) { state.restore(view); continue; }
+            state.bounds(view);
+            float factor = FoldReelsGeometry.scale(state.source.width(), state.source.height(),
+                    viewport.width(), viewport.height(), crop, zoom);
+            if (!Float.isFinite(factor) || factor <= 0 || factor > 12
+                    || view.getWidth() < viewer.getWidth() * .15f || view.getHeight() < viewer.getHeight() * .25f) {
+                state.restore(view); continue; // Reject thumbnails by size, never by how far they have entered the screen.
+            }
+            state.target.set(viewport);
+            float offset = FoldReelsViews.pageOffset(page, viewer, viewport.height(), state.work, state.matrix);
+            if (!Float.isFinite(offset)) { state.restore(view); continue; }
+            state.target.offset(0, offset);
+            clipping.openPath(view, boundary);
+            state.apply(view, factor);
+            framed++;
+        }
+        return framed > 0;
+    }
+
+    void restore() {
+        for (Map.Entry<View, SurfaceState> e : states.entrySet()) release(e.getKey(), e.getValue());
+        states.clear(); framed = 0;
+    }
+    private void release(View view, SurfaceState state) {
+        state.restore(view); view.removeOnLayoutChangeListener(this); view.removeOnAttachStateChangeListener(this);
+    }
+    @Override public void onViewAttachedToWindow(View view) { changed.run(); }
+    @Override public void onViewDetachedFromWindow(View view) {
+        SurfaceState state = states.remove(view); if (state != null) release(view, state);
+        changed.run();
+    }
+    @Override public void onLayoutChange(View v, int l, int t, int r, int b, int ol, int ot, int or, int ob) { changed.run(); }
+
+    /** Values contain no strong View references, so the weak-key map cannot retain recycled pages. */
+    private static final class SurfaceState {
+        WeakReference<View> page = new WeakReference<>(null);
+        int seen;
+        float sx, sy, tx, ty, asx, asy, atx, aty;
+        boolean applied, clipped;
+        Rect nativeClip, lastClip;
+        final RectF source = new RectF(), target = new RectF(), work = new RectF();
+        final Matrix matrix = new Matrix(), inverse = new Matrix();
+        final float[] pivot = new float[2];
+        SurfaceState(View view) { read(view); }
+        static boolean same(float a, float b) { return Math.abs(a - b) < .0001f; }
+        void read(View v) {
+            sx = v.getScaleX(); sy = v.getScaleY(); tx = v.getTranslationX(); ty = v.getTranslationY();
+            nativeClip = v.getClipBounds();
+        }
+        void capture(View v) {
+            if (!applied) { read(v); return; }
+            if (!same(v.getScaleX(), asx)) sx = v.getScaleX();
+            if (!same(v.getScaleY(), asy)) sy = v.getScaleY();
+            if (!same(v.getTranslationX(), atx)) tx = v.getTranslationX();
+            if (!same(v.getTranslationY(), aty)) ty = v.getTranslationY();
+            Rect current = v.getClipBounds();
+            if (!Objects.equals(current, lastClip)) nativeClip = current;
+        }
+        void bounds(View v) {
+            source.set(0, 0, v.getWidth(), v.getHeight());
+            if (v instanceof TextureView) {
+                ((TextureView) v).getTransform(matrix); matrix.mapRect(source);
+                if (!source.intersect(0, 0, v.getWidth(), v.getHeight())) { source.setEmpty(); return; }
+            }
+            if (nativeClip != null && !source.intersect(nativeClip.left, nativeClip.top, nativeClip.right, nativeClip.bottom)) {
+                source.setEmpty(); return;
+            }
+            float px = v.getPivotX(), py = v.getPivotY();
+            source.set(px + (source.left - px) * sx + tx, py + (source.top - py) * sy + ty,
+                    px + (source.right - px) * sx + tx, py + (source.bottom - py) * sy + ty);
+            View parent = (View) v.getParent();
+            source.offset(v.getLeft() - parent.getScrollX(), v.getTop() - parent.getScrollY());
+            matrix.reset(); parent.transformMatrixToGlobal(matrix); matrix.mapRect(source);
+        }
+        void apply(View v, float factor) {
+            View parent = (View) v.getParent();
+            pivot[0] = v.getPivotX() + v.getLeft() - parent.getScrollX();
+            pivot[1] = v.getPivotY() + v.getTop() - parent.getScrollY();
+            matrix.reset(); parent.transformMatrixToGlobal(matrix); matrix.mapPoints(pivot);
+            asx = sx * factor; asy = sy * factor;
+            atx = FoldReelsGeometry.translation(target.centerX(), pivot[0], source.centerX() - tx, factor);
+            aty = FoldReelsGeometry.translation(target.centerY(), pivot[1], source.centerY() - ty, factor);
+            if (!same(v.getScaleX(), asx)) v.setScaleX(asx);
+            if (!same(v.getScaleY(), asy)) v.setScaleY(asy);
+            if (!same(v.getTranslationX(), atx)) v.setTranslationX(atx);
+            if (!same(v.getTranslationY(), aty)) v.setTranslationY(aty);
+            applied = true;
+            // Each page has its own crop window: neighbouring enlarged videos never overlap.
+            matrix.reset(); v.transformMatrixToGlobal(matrix);
+            if (!matrix.invert(inverse)) return;
+            work.set(target); inverse.mapRect(work);
+            int left = Math.max(0, (int) Math.ceil(work.left - .001f));
+            int top = Math.max(0, (int) Math.ceil(work.top - .001f));
+            int right = Math.min(v.getWidth(), (int) Math.floor(work.right + .001f));
+            int bottom = Math.min(v.getHeight(), (int) Math.floor(work.bottom + .001f));
+            if (lastClip == null) lastClip = new Rect();
+            lastClip.set(left, top, Math.max(left, right), Math.max(top, bottom));
+            if (!lastClip.equals(v.getClipBounds())) v.setClipBounds(lastClip);
+            clipped = true;
+        }
+        void restore(View v) {
+            if (applied) {
+                if (same(v.getScaleX(), asx)) v.setScaleX(sx);
+                if (same(v.getScaleY(), asy)) v.setScaleY(sy);
+                if (same(v.getTranslationX(), atx)) v.setTranslationX(tx);
+                if (same(v.getTranslationY(), aty)) v.setTranslationY(ty);
+            }
+            if (clipped && Objects.equals(v.getClipBounds(), lastClip)) v.setClipBounds(nativeClip);
+            applied = clipped = false; lastClip = null;
+        }
+    }
+}
