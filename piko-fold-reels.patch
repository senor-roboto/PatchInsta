+/** Runs the actual installed watcher/presenter, with no replay of historical lifecycle events. */
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=29, manifest=Config.NONE, qualifiers="w420dp-h900dp-mdpi")
+public class FoldReelsLifecycleTest {
+    ActivityController<Host> controller; Host activity; FrameLayout body; WindowViewer viewer; TextureView video;
+    @Before public void createResumedActivityBeforeInstallation() {
+        FoldReels.resetForTests(); controller=Robolectric.buildActivity(Host.class).setup().visible(); activity=controller.get();
+        activity.getSharedPreferences("piko_settings",0).edit().clear().commit();
+        body=new FrameLayout(activity); activity.setContentView(body);
+        int width=activity.getResources().getConfiguration().screenWidthDp;
+        int height=activity.getResources().getConfiguration().screenHeightDp;
+        body.measure(View.MeasureSpec.makeMeasureSpec(width,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(height,View.MeasureSpec.EXACTLY)); body.layout(0,0,width,height);
+        viewer=new WindowViewer(activity); FoldReelsTestFixture.add(body,viewer,0,0,width,height-140);
+        FrameLayout page=new FrameLayout(activity); FoldReelsTestFixture.add(viewer,page,0,0,width,height-140);
+        video=new TextureView(activity); FoldReelsTestFixture.add(page,video,30,0,width-60,height-140);
+    }
+    @After public void destroy() { FoldReels.resetForTests(); controller.pause().stop().destroy(); }
+    FoldReels.Watcher.Tracker start() { FoldReels.attachViewer(viewer); FoldReels.Watcher.Tracker t=FoldReels.watcher.trackers.get(activity); t.onPreDraw(); return t; }
+    String state(FoldReels.Watcher.Tracker t) {
+        StringBuilder out=new StringBuilder(); t.diagnostics(out); FoldReelsDiagnostics.view(viewer,out);
+        android.graphics.Rect rect=new android.graphics.Rect(); out.append(" globalVisible=").append(viewer.getGlobalVisibleRect(rect)).append(' ').append(rect)
+            .append(" windowVis=").append(viewer.getWindowVisibility()).append(" attached=").append(viewer.isAttachedToWindow()); return out.toString();
+    }
+    @Test public void lateInstallColdCoverBootstrapsWithoutAnyNewLifecycleCallback() {
+        FoldReels.Watcher.Tracker t=start();
+        assertFalse(t.lifecycleKnown); assertFalse(t.resumed); assertTrue(state(t),t.active);
+        assertTrue(t.observersAttached); assertEquals(1,t.viewers.size()); assertSame(activity,FoldReels.watcher.foreground.get());
+        assertEquals(FoldReelsPolicy.WindowKind.COMPACT,t.windowKind); assertNotNull(t.chip.get()); assertEquals(View.VISIBLE,t.chip.get().getVisibility());
+        assertEquals("piko_fold_reels_chip_fit",t.chip.get().getText().toString()); assertTrue(video.getScaleX()>1); assertEquals(0,activity.configurations);
+        assertTrue(t.failures.toString(),t.failures.isEmpty());
+    }
+    @Test @Config(qualifiers="w768dp-h1024dp-mdpi") public void coldInnerKeepsNativeFramingWithoutConfigurationCallback() {
+        FoldReels.Watcher.Tracker t=start(); assertEquals(FoldReelsPolicy.WindowKind.WIDE,t.windowKind);
+        assertEquals(1,video.getScaleX(),.001f); assertNotNull(t.chip.get()); assertEquals("piko_fold_reels_chip_fill",t.chip.get().getText().toString()); assertEquals(0,activity.configurations);
+    }
+    @Test public void contentRootMayArriveAfterTheViewerWithoutASecondAttach() {
+        activity.contentReady=false; FoldReels.Watcher.Tracker t=start(); assertNull(t.chip.get()); assertTrue(t.active);
+        activity.contentReady=true; t.onGlobalLayout(); t.onPreDraw(); assertNotNull(t.chip.get()); assertEquals(1,t.observerInstallations); assertEquals(0,activity.configurations);
+    }
+    @Test public void repeatedAttachAndFramesDoNotDuplicateObserversChipOrTransform() {
