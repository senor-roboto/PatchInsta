+        android.graphics.Rect rect=new android.graphics.Rect(); out.append(" globalVisible=").append(viewer.getGlobalVisibleRect(rect)).append(' ').append(rect)
+            .append(" windowVis=").append(viewer.getWindowVisibility()).append(" attached=").append(viewer.isAttachedToWindow()); return out.toString();
+    }
