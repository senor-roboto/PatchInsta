+    private static float zoom(boolean inner) {
+        try { float value = Float.parseFloat(SharedPref.getStringPref(zoomKey(inner), "1"));
+            return Float.isFinite(value) ? Math.max(1f, Math.min(2.5f, value)) : 1f;
+        } catch (NumberFormatException ignored) { return 1f; }
+    }
