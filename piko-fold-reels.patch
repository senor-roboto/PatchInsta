+    private static void choose(LinearLayout box, String title, String key, String[] values, String[] labels, String selected) {
+        String[] items = new String[labels.length]; int initial = 0;
+        for (int i = 0; i < labels.length; i++) { items[i] = str(labels[i]); if (values[i].equals(selected)) initial = i; }
