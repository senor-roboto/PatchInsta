+package app.morphe.extension.instagram.patches.reels;
+
+import android.view.View;
+import android.view.ViewGroup;
+
+/** Structural diagnostics only: never text, contentDescription, tags, URLs or media/account identifiers. */
+final class FoldReelsDiagnostics {
+    static String type(Object value) { return value == null ? "none" : value.getClass().getName(); }
+    static String id(View view) { return view == null ? "none" : type(view) + "#" + FoldReelsChrome.resourceName(view); }
+    static void view(View view, StringBuilder out) {
+        int[] xy = new int[2]; view.getLocationOnScreen(xy);
+        out.append(id(view)).append(' ').append(view.getWidth()).append('x').append(view.getHeight())
+                .append('@').append(xy[0]).append(',').append(xy[1]).append(" vis=").append(view.getVisibility())
+                .append(" alpha=").append(view.getAlpha()).append(" bg=").append(type(view.getBackground()))
+                .append(" fg=").append(type(view.getForeground())).append(" clip=").append(view.getClipBounds())
+                .append(" outlineClip=").append(view.getClipToOutline()).append(" outline=").append(type(view.getOutlineProvider()))
+                .append(" elevation=").append(view.getElevation()).append(" scale=").append(view.getScaleX()).append(',').append(view.getScaleY())
+                .append(" translation=").append(view.getTranslationX()).append(',').append(view.getTranslationY())
+                .append(" clickable=").append(view.isClickable()).append(" longClickable=").append(view.isLongClickable())
+                .append(" parent=").append(view.getParent() instanceof View ? id((View) view.getParent()) : type(view.getParent()));
+        if (view instanceof ViewGroup) out.append(" clipChildren=").append(((ViewGroup) view).getClipChildren())
+                .append(" clipPadding=").append(((ViewGroup) view).getClipToPadding());
+        out.append('\n');
+    }
+    static void tree(View root, StringBuilder out, int depth, int[] count) {
+        if (depth > 35 || ++count[0] > 700) return;
+        out.append(depth).append(' '); view(root, out);
+        if (root instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) root;
+            for (int i = 0; i < group.getChildCount(); i++) tree(group.getChildAt(i), out, depth + 1, count);
+        }
+    }
+}
