@@ -0,0 +1,67 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.graphics.Matrix;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.view.View;
+import java.lang.ref.WeakReference;
+
+/** Window drawing and native hit dispatch have different bounds. All rectangles use
+ * transformMatrixToGlobal coordinates; never physical display pixels or a cached configuration. */
+final class FoldReelsViewport {
+    final RectF window = new RectF(), content = new RectF(), viewer = new RectF();
+    final RectF visual = new RectF(), interactive = new RectF();
+    private final Matrix matrix = new Matrix();
+    private final Rect visible = new Rect();
+    private final int[] screenLocation = new int[2], windowLocation = new int[2];
+    WeakReference<View> boundary = new WeakReference<>(null);
+    String source = "viewer";
+
+    void update(View root, View holder, View nativeViewer, boolean coverCrop,
+                boolean immersive, boolean tabsHidden) {
+        FoldReelsViews.bounds(nativeViewer, viewer, matrix);
+        visual.set(viewer);
+        if (nativeViewer.getGlobalVisibleRect(visible)) {
+            // Despite its name this API returns root/window coordinates; transformMatrixToGlobal
+            // returns screen coordinates. Account for a freeform/multi-window origin before intersecting.
+            View viewRoot = nativeViewer.getRootView();
+            viewRoot.getLocationOnScreen(screenLocation); viewRoot.getLocationInWindow(windowLocation);
+            visible.offset(screenLocation[0] - windowLocation[0], screenLocation[1] - windowLocation[1]);
+            visual.intersect(new RectF(visible));
+        }
+        window.setEmpty(); content.setEmpty();
+        boolean hasWindow = valid(root, nativeViewer), hasContent = valid(holder, nativeViewer);
+        if (hasWindow) FoldReelsViews.bounds(root, window, matrix);
+        if (hasContent) FoldReelsViews.bounds(holder, content, matrix);
+        View clipBoundary = nativeViewer; source = "viewer";
+        if (coverCrop && (immersive || tabsHidden) && (hasWindow || hasContent)) {
+            // Hiding bars does not guarantee that Instagram removes its old content insets.
+            // A laid-out DecorView describes this window, including multi-window, not the display.
+            RectF full = immersive && hasWindow ? window : content;
+            if (!full.isEmpty()) {
+                visual.left = full.left; visual.right = full.right;
+                if (immersive) visual.top = full.top;
+                if (tabsHidden) visual.bottom = full.bottom;
+                clipBoundary = immersive && hasWindow ? root : holder;
+                source = clipBoundary == root ? "window" : "content";
+            }
+        }
+        boundary = new WeakReference<>(clipBoundary);
+        if (hasWindow) visual.intersect(window);
+        interactive.set(viewer);
+        if (!interactive.intersect(visual)) interactive.setEmpty();
+    }
+
+    private static boolean valid(View ancestor, View viewer) {
+        return ancestor != null && ancestor.isAttachedToWindow() && ancestor.getWidth() > 0
+                && ancestor.getHeight() > 0 && FoldReelsViews.descendant(viewer, ancestor);
+    }
+
+    void diagnostics(StringBuilder out) {
+        out.append("spaces source=").append(source).append(" window=").append(window)
+                .append(" content=").append(content).append(" viewer=").append(viewer)
+                .append(" visual=").append(visual).append(" interactive=").append(interactive)
+                .append(" clipBoundary=").append(FoldReelsDiagnostics.id(boundary.get())).append('\n');
+    }
+}
diff --git a/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsViews.java b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsViews.java
new file mode 100644
index 0000000..3fbfd3e
--- /dev/null
+++ b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsViews.java
@@ -0,0 +1,59 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.graphics.Matrix;
+import android.graphics.RectF;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewParent;
+
+final class FoldReelsViews {
+    private FoldReelsViews() {}
+    static void bounds(View view, RectF out, Matrix matrix) {
+        out.set(0, 0, view.getWidth(), view.getHeight());
+        matrix.reset(); view.transformMatrixToGlobal(matrix); matrix.mapRect(out);
+    }
+    static boolean descendant(View view, View ancestor) {
+        for (View v = view; v != null; v = v.getParent() instanceof View ? (View) v.getParent() : null)
+            if (v == ancestor) return true;
+        return false;
+    }
+    static boolean unitParents(View view, View boundary) {
+        for (View v = view; v != null; v = v.getParent() instanceof View ? (View) v.getParent() : null) {
+            if (Math.abs(v.getRotation()) > .01f || Math.abs(v.getRotationX()) > .01f || Math.abs(v.getRotationY()) > .01f) return false;
+            if (v != view && (Math.abs(v.getScaleX() - 1) > .001f || Math.abs(v.getScaleY() - 1) > .001f)) return false;
+            if (v == boundary) return true;
+        }
+        return false;
+    }
+    static float pageOffset(View page, View viewer, float height, RectF work, Matrix matrix) {
+        if (page.getHeight() <= 0) return Float.NaN;
+        bounds(page, work, matrix); float top = work.top;
+        View parent = page.getParent() instanceof View ? (View) page.getParent() : viewer;
+        if (classIs(parent, "androidx.recyclerview.widget.RecyclerView")
+                || classIs(parent, "androidx.viewpager.widget.ViewPager")) {
+            bounds(parent, work, matrix);
+            return FoldReelsGeometry.pageOffset(top - work.top - parent.getPaddingTop(), page.getHeight(), height);
+        }
+        bounds(viewer, work, matrix);
+        return FoldReelsGeometry.pageOffset(top - work.top, page.getHeight(), height);
+    }
+    static boolean classIs(View view, String name) {
+        for (Class<?> c = view.getClass(); c != null; c = c.getSuperclass()) if (c.getName().equals(name)) return true;
+        return false;
+    }
+    /** Prefer an actual pager item over a video wrapper that merely has a similar height. */
+    static View page(View surface, View viewer) {
+        View fallback = null;
+        for (View child = surface; child != viewer && child.getParent() instanceof View; ) {
+            View parent = (View) child.getParent();
+            if (classIs(parent, "androidx.recyclerview.widget.RecyclerView")
+                    || classIs(parent, "androidx.viewpager.widget.ViewPager")) return child;
+            if (fallback == null && child instanceof ViewGroup
+                    && Math.abs(child.getHeight() - viewer.getHeight()) <= viewer.getHeight() * .08f)
+                fallback = child; // Never promote this to a shared pager container farther up the tree.
+            child = parent;
+        }
+        return fallback;
+    }
+}
