+        choose(box, "piko_fold_reels_metadata", FoldReelsPreferences.key(inner, "metadata"),
+                new String[]{"FULL", "COMPACT", "HIDDEN"}, new String[]{"piko_fold_reels_metadata_full", "piko_fold_reels_metadata_compact", "piko_fold_reels_metadata_hidden"}, p.metadata.name());
+        addSwitch(box, "piko_fold_reels_edges_title", FoldReelsPreferences.key(inner, "edges"), p.edges);
+        addSwitch(box, "piko_fold_reels_shortcut", FoldReelsPreferences.key(inner, "shortcut"), p.shortcut);
+        if (!inner) {
+            addSwitch(box, "piko_fold_reels_immersive_title", FoldReelsPreferences.IMMERSIVE, p.immersive);
+            addSwitch(box, "piko_fold_reels_tabs_title", FoldReelsPreferences.TABS, p.tabs);
