+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.app.Activity;
+import android.os.Build;
+import android.view.View;
+import android.view.Window;
+import android.view.WindowInsets;
+import android.view.WindowInsetsController;
+
+/** Own only a temporary bar-visibility request, never Instagram's inset listener. */
+final class FoldReelsBars {
+    private boolean active;
+    private int visibleTypes, behavior, legacyFlags;
+
+    void hide(Activity activity) {
+        if (active) return; // A user swipe must be allowed to reveal transient system bars.
+        Window window = activity.getWindow(); View decor = window.getDecorView();
+        if (Build.VERSION.SDK_INT >= 30) {
+            WindowInsets insets = decor.getRootWindowInsets();
+            WindowInsetsController controller = window.getInsetsController();
+            if (controller == null || insets == null) return;
+            visibleTypes = 0;
+            if (insets.isVisible(WindowInsets.Type.statusBars())) visibleTypes |= WindowInsets.Type.statusBars();
+            if (insets.isVisible(WindowInsets.Type.navigationBars())) visibleTypes |= WindowInsets.Type.navigationBars();
+            behavior = controller.getSystemBarsBehavior();
+            controller.setSystemBarsBehavior(WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
+            controller.hide(WindowInsets.Type.systemBars());
+        } else {
+            legacyFlags = decor.getSystemUiVisibility();
+            decor.setSystemUiVisibility(legacyFlags | View.SYSTEM_UI_FLAG_FULLSCREEN
+                    | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY);
+        }
+        active = true;
+    }
+
+    void restore(Activity activity) {
+        if (!active) return;
+        active = false;
+        if (Build.VERSION.SDK_INT >= 30) {
+            WindowInsetsController controller = activity.getWindow().getInsetsController();
+            if (controller != null) {
+                controller.setSystemBarsBehavior(behavior);
+                if (visibleTypes != 0) controller.show(visibleTypes);
+            }
+        } else activity.getWindow().getDecorView().setSystemUiVisibility(legacyFlags);
+    }
+}
diff --git a/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsChrome.java b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsChrome.java
new file mode 100644
index 0000000..804596e
--- /dev/null
+++ b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsChrome.java
@@ -0,0 +1,122 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.graphics.Color;
+import android.graphics.Rect;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.Drawable;
+import android.view.SurfaceView;
+import android.view.TextureView;
+import android.view.View;
+import android.view.ViewGroup;
+import java.util.IdentityHashMap;
+import java.util.Map;
+
+/** Optional, conservative cosmetics. Unknown controls remain available. No translated-text matching. */
+final class FoldReelsChrome {
+    private final Map<View, Integer> hidden = new IdentityHashMap<>();
+    private final Map<View, Drawable> backgrounds = new IdentityHashMap<>();
+    private int nodes;
+    private boolean tabsHidden;
+    private View root;
+    private boolean minimal;
+
+    boolean apply(View viewer, View content, boolean clean) {
+        if (root != viewer || minimal != clean) restore();
+        root = viewer; minimal = clean;
+        hidden.entrySet().removeIf(e -> {
+            if (e.getKey().isAttachedToWindow()) return false;
+            if (e.getKey().getVisibility() == View.INVISIBLE) e.getKey().setVisibility(e.getValue());
+            return true;
+        });
+        backgrounds.entrySet().removeIf(e -> {
+            if (e.getKey().isAttachedToWindow()) return false;
+            if (e.getKey().getBackground() == null) e.getKey().setBackground(e.getValue());
+            return true;
+        });
+        tabsHidden = false;
+        nodes = 0;
+        scan(viewer, viewer, clean, false, 0);
+        if (clean) { nodes = 0; scan(content, viewer, true, true, 0); }
+        return tabsHidden;
+    }
+
+    private void scan(View view, View viewer, boolean clean, boolean tabsOnly, int depth) {
+        if (++nodes > 1800 || depth > 40 || view instanceof TextureView || view instanceof SurfaceView) return;
+        if (view.getVisibility() != View.VISIBLE && !hidden.containsKey(view)) return;
+        String name = resourceName(view);
+        if (tabsOnly && view == viewer) return;
+        if (tabsOnly && isBottomTabs(view, viewer, name)) { hide(view); tabsHidden = true; return; }
+        if (!tabsOnly) {
+            // Clear only dark, narrow side-pane backgrounds while the video fills the viewer.
+            Drawable background = view.getBackground();
+            if (background instanceof ColorDrawable && view.getHeight() > viewer.getHeight() * .6f
+                    && view.getWidth() < viewer.getWidth() * .35f && view.getWidth() > 0) {
+                int c = ((ColorDrawable) background).getColor();
+                if (Color.alpha(c) == 255 && Color.red(c) < 32 && Color.green(c) < 32 && Color.blue(c) < 32) {
+                    backgrounds.putIfAbsent(view, background); view.setBackground(null);
+                }
+            }
+            // Never hide an enclosing action bar: it may contain the comments button.
+            boolean reelName = name.startsWith("clips_") || name.startsWith("reel_") || name.startsWith("reels_");
+            boolean optional = name.contains("like_button") || name.contains("like_count")
+                    || name.contains("share_button") || name.contains("share_count")
+                    || name.contains("reshare") || name.contains("repost")
+                    || name.contains("save_button") || name.contains("save_count")
+                    || name.contains("audio_button") || name.contains("caption")
+                    || name.equals("clips_viewer_header");
+            if (clean && reelName && optional && !name.contains("comment")
+                    && view.getHeight() < viewer.getHeight() * .35f && !containsComment(view, 0)) {
+                hide(view); return;
+            }
+        }
+        if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) scan(group.getChildAt(i), viewer, clean, tabsOnly, depth + 1);
+        }
+    }
+
+    private static boolean containsComment(View view, int depth) {
+        if (resourceName(view).contains("comment")) return true;
+        if (depth >= 12) return true; // Unknown deep groups are retained.
+        if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) if (containsComment(group.getChildAt(i), depth + 1)) return true;
+        }
+        return false;
+    }
+
+    private static boolean isBottomTabs(View view, View viewer, String name) {
+        if (!(name.equals("tab_bar") || name.equals("bottom_tab_bar")
+                || name.equals("bottom_navigation_bar") || name.equals("navigation_bar"))) return false;
+        if (!(view instanceof ViewGroup) || ((ViewGroup) view).getChildCount() < 2) return false;
+        float density = view.getResources().getDisplayMetrics().density;
+        Rect bounds = new Rect(), reels = new Rect();
+        int[] pos = new int[2]; view.getLocationOnScreen(pos);
+        bounds.set(pos[0], pos[1], pos[0] + view.getWidth(), pos[1] + view.getHeight());
+        if (!viewer.getGlobalVisibleRect(reels)) return false;
+        return bounds.width() >= reels.width() * .8f && bounds.height() > 0
+                && bounds.height() <= 120 * density && bounds.top >= reels.bottom - 32 * density;
+    }
+
+    static String resourceName(View view) {
+        if (view.getId() == View.NO_ID) return "";
+        try { return view.getResources().getResourceEntryName(view.getId()); }
+        catch (RuntimeException ignored) { return ""; }
+    }
+
+    private void hide(View view) {
+        hidden.putIfAbsent(view, view.getVisibility());
+        if (view.getVisibility() == View.VISIBLE) view.setVisibility(View.INVISIBLE);
+    }
+
+    String status() { return "hidden=" + hidden.size() + " tabs=" + tabsHidden; }
+
+    void restore() {
+        for (Map.Entry<View, Integer> e : hidden.entrySet())
+            if (e.getKey().getVisibility() == View.INVISIBLE) e.getKey().setVisibility(e.getValue());
+        for (Map.Entry<View, Drawable> e : backgrounds.entrySet())
+            if (e.getKey().getBackground() == null) e.getKey().setBackground(e.getValue());
+        hidden.clear(); backgrounds.clear(); tabsHidden = false; root = null;
+    }
+}
