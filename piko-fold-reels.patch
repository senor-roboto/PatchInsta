+/** Only rounded decoration on the known surface-to-page path. Clipping has its own shared owner. */
+final class FoldReelsCardChrome implements View.OnAttachStateChangeListener {
+    private final WeakHashMap<View, State> states = new WeakHashMap<>();
+    private int generation, inspected;
+    void discover(FoldReelsRenderer renderer, View viewer) {
+        generation++; inspected = 0;
+        renderer.visitPlayers((surface, page) -> {
+            for (View v = surface.getParent() instanceof View ? (View) surface.getParent() : null;
+                    v != null && v != viewer && FoldReelsViews.descendant(v, page);
+                    v = v.getParent() instanceof View ? (View) v.getParent() : null) {
+                inspected++;
+                State state = states.get(v);
+                // A full-sized video wrapper with an inspectable rounded shape is evidence of
+                // decoration. Arbitrary drawables, siblings, controls and the Activity root are untouched.
+                if (v instanceof ViewGroup && v.getWidth() >= surface.getWidth() * .9f
+                        && v.getHeight() >= surface.getHeight() * .9f
+                        && (state != null || rounded(v.getBackground(), 0) || rounded(v.getForeground(), 0))) {
+                    if (state == null) { state = new State(); states.put(v, state); v.addOnAttachStateChangeListener(this); }
+                    state.seen = generation;
+                }
+                if (v == page) break;
+            }
+        });
+        for (Iterator<Map.Entry<View, State>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, State> e = it.next();
+            if (e.getValue().seen != generation) { release(e.getKey(), e.getValue()); it.remove(); }
+        }
+    }
+    private static boolean rounded(Drawable drawable, int depth) {
+        if (drawable == null || depth > 4) return false;
+        if (drawable instanceof GradientDrawable) {
+            GradientDrawable gradient = (GradientDrawable) drawable;
+            if (gradient.getShape() != GradientDrawable.RECTANGLE) return false;
+            if (gradient.getCornerRadius() > 0) return true;
+            float[] radii = gradient.getCornerRadii();
+            if (radii != null) for (float radius : radii) if (radius > 0) return true;
+        } else if (drawable instanceof LayerDrawable) {
+            LayerDrawable layers = (LayerDrawable) drawable;
+            for (int i = 0; i < layers.getNumberOfLayers(); i++) if (rounded(layers.getDrawable(i), depth + 1)) return true;
+        } else if (drawable instanceof StateListDrawable) {
+            // Only inspect the public current state; never reflect into Instagram's drawables.
+            return rounded(drawable.getCurrent(), depth + 1);
+        }
+        return false;
+    }
+    void frame(boolean enabled) {
+        for (Iterator<Map.Entry<View, State>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<View, State> e = it.next(); View v = e.getKey(); State s = e.getValue();
