+    private static void showDiagnostic(Activity activity) {
+        Watcher.Tracker tracker = watcher.trackers.get(activity);
+        StringBuilder report = new StringBuilder("Fold Reels v3\n");
+        Configuration config = activity.getResources().getConfiguration();
+        report.append("windowDp=").append(config.screenWidthDp).append('x').append(config.screenHeightDp)
+                .append(" densityDpi=").append(config.densityDpi).append(" profile=").append(kind)
+                .append(" override=").append(SharedPref.getStringPref("fold_reels_profile_v3", "auto"))
+                .append(" crop=").append(SharedPref.getBooleanPref(cropSetting(wide())))
+                .append(" zoom=").append(zoom(wide())).append('\n');
+        if (tracker != null) {
+            report.append("failure=").append(tracker.failure).append('\n')
+                    .append("renderer=").append(tracker.renderer.status()).append('\n')
+                    .append("chrome=").append(tracker.chrome.status()).append('\n');
+            View viewer = tracker.visibleViewer();
+            if (viewer != null) dump(viewer, report, 0, new int[]{0});
+        }
+        TextView text = new TextView(activity); text.setText(report); text.setTextIsSelectable(true);
+        text.setTextSize(11); text.setPadding(dp(activity, 16), 0, dp(activity, 16), 0);
+        ScrollView scroll = new ScrollView(activity); scroll.addView(text);
+        new AlertDialog.Builder(activity).setTitle(str("piko_fold_reels_diagnostic")).setView(scroll)
+                .setPositiveButton(str("piko_fold_reels_copy"), (dialog, which) -> {
+                    ClipboardManager clipboard = (ClipboardManager) activity.getSystemService(Context.CLIPBOARD_SERVICE);
+                    if (clipboard != null) clipboard.setPrimaryClip(ClipData.newPlainText("Fold Reels", report));
+                }).setNegativeButton(android.R.string.cancel, null).show();
+    }
+    private static void dump(View view, StringBuilder report, int depth, int[] count) {
+        if (depth > 30 || ++count[0] > 500) return;
