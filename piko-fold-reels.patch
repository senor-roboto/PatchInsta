+    private static final class Watcher implements Application.ActivityLifecycleCallbacks {
+        private final Map<Activity, Tracker> trackers = new HashMap<>();
+        private WeakReference<Activity> foreground = new WeakReference<>(null);
+        private Tracker tracker(Activity activity) {
+            Tracker result = trackers.get(activity);
+            if (result == null) { result = new Tracker(activity); trackers.put(activity, result); }
+            return result;
+        }
+        private void activate(Activity activity, boolean attach) {
+            foreground = new WeakReference<>(activity);
+            Tracker tracker = tracker(activity);
+            if (attach) tracker.attachObservers();
+            tracker.capture(); tracker.markDiscovery();
+        }
+        private void captureForeground() {
+            Activity activity = foreground.get();
+            if (activity != null) tracker(activity).capture();
+        }
+        private void requestFrame() {
+            Activity activity = foreground.get();
+            if (activity == null) return;
+            tracker(activity);
+            activity.getWindow().getDecorView().invalidate();
+        }
+        private void addViewer(View view) {
+            Activity activity = activityOf(view.getContext());
+            if (activity == null) return;
+            Tracker tracker = tracker(activity);
+            for (WeakReference<View> ref : tracker.viewers) if (ref.get() == view) return;
+            tracker.viewers.add(new WeakReference<>(view)); tracker.markDiscovery();
+        }
+        private void removeViewer(View view) {
+            Tracker tracker = trackers.get(activityOf(view.getContext()));
+            if (tracker != null) {
+                tracker.viewers.removeIf(ref -> ref.get() == null || ref.get() == view);
+                tracker.stopPresentation(); tracker.markDiscovery();
+            }
+        }
+        @Override public void onActivityPreCreated(Activity a, Bundle state) { activate(a, false); }
+        @Override public void onActivityCreated(Activity a, Bundle state) { activate(a, true); }
+        @Override public void onActivityPreResumed(Activity a) { activate(a, true); }
+        @Override public void onActivityResumed(Activity a) { activate(a, true); tracker(a).resumed = true; }
+        @Override public void onActivityStarted(Activity a) {}
+        @Override public void onActivityPaused(Activity a) {
+            Tracker tracker = trackers.get(a);
+            if (tracker != null) { tracker.resumed = false; tracker.stopPresentation(); }
+        }
+        @Override public void onActivityStopped(Activity a) {}
+        @Override public void onActivitySaveInstanceState(Activity a, Bundle state) {}
+        @Override public void onActivityDestroyed(Activity a) {
+            Tracker tracker = trackers.remove(a); if (tracker != null) tracker.dispose();
+            if (foreground.get() == a) foreground.clear();
+        }
+
+        private final class Tracker implements ComponentCallbacks, ViewTreeObserver.OnPreDrawListener, ViewTreeObserver.OnGlobalLayoutListener {
+            final WeakReference<Activity> owner;
+            final ArrayList<WeakReference<View>> viewers = new ArrayList<>();
+            final FoldReelsRenderer renderer = new FoldReelsRenderer(this::markDiscovery);
+            final FoldReelsControls controls = new FoldReelsControls();
+            final FoldReelsClipping clipping = new FoldReelsClipping();
+            final FoldReelsChrome chrome = new FoldReelsChrome();
+            final FoldReelsBars bars = new FoldReelsBars();
+            boolean observersAttached, resumed, failed, recognized, failedControls;
+            boolean discoveryDirty = true;
+            int lastOptions = -1;
+            WeakReference<View> currentViewer = new WeakReference<>(null);
+            String failure = "none";
+            long lastDiscovery;
+            TextView chip;
+            FrameLayout content;
+            Tracker(Activity activity) { owner = new WeakReference<>(activity); }
+            void markDiscovery() { discoveryDirty = true; }
+            @Override public void onGlobalLayout() { markDiscovery(); }
+            void attachObservers() {
+                Activity activity = owner.get();
+                if (activity == null || observersAttached) return;
+                activity.registerComponentCallbacks(this);
+                activity.getWindow().getDecorView().getViewTreeObserver().addOnPreDrawListener(this);
+                activity.getWindow().getDecorView().getViewTreeObserver().addOnGlobalLayoutListener(this);
+                observersAttached = true;
+            }
+            void capture() {
+                Activity activity = owner.get();
+                if (activity == null || foreground.get() != activity) return;
+                Configuration config = activity.getResources().getConfiguration();
+                FoldReelsPolicy.WindowKind next = FoldReelsPolicy.classify(config.screenWidthDp, config.screenHeightDp);
+                String override = SharedPref.getStringPref("fold_reels_profile_v3", "auto");
+                if (override.equals("cover")) next = FoldReelsPolicy.WindowKind.COMPACT;
+                if (override.equals("inner")) next = FoldReelsPolicy.WindowKind.WIDE;
+                if (next != FoldReelsPolicy.WindowKind.UNKNOWN && next != kind) { kind = next; markDiscovery(); }
+            }
+            View visibleViewer() {
