+    private static final class Watcher implements Application.ActivityLifecycleCallbacks {
+        private final Map<Activity, Tracker> trackers = new HashMap<>();
+        private WeakReference<Activity> foreground = new WeakReference<>(null);
+        private Tracker tracker(Activity activity) {
+            Tracker result = trackers.get(activity);
+            if (result == null) { result = new Tracker(activity); trackers.put(activity, result); }
+            return result;
+        }
+        private void activate(Activity activity, boolean attach) {
+            foreground = new WeakReference<>(activity);
+            Tracker tracker = tracker(activity);
+            if (attach) tracker.attachObservers();
+            tracker.capture(); tracker.force = true;
+        }
+        private void captureForeground() {
+            Activity activity = foreground.get();
+            if (activity != null) tracker(activity).capture();
+        }
+        private void requestFrame() {
+            Activity activity = foreground.get();
+            if (activity == null) return;
+            Tracker tracker = tracker(activity); tracker.force = true;
+            activity.getWindow().getDecorView().invalidate();
+        }
+        private void addViewer(View view) {
+            Activity activity = activityOf(view.getContext());
