+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/** Uses Piko's existing preferences file; no Activity reference and no eager global-context dependency. */
+final class FoldReelsPreferences {
+    static final String COVER_CROP = "fold_reels_cover_crop", INNER_CROP = "fold_reels_inner_crop";
+    static final String IMMERSIVE = "fold_reels_cover_immersive_v3", TABS = "fold_reels_cover_hide_tabs_v4";
+    static final String LEGACY_MINIMAL = "fold_reels_cover_minimal_v3", LEGACY_EDGES = "fold_reels_edge_controls_v4";
+    final SharedPreferences storage;
+    FoldReelsPreferences(Context context) {
+        storage = context.getApplicationContext().getSharedPreferences("piko_settings", Context.MODE_PRIVATE);
+        // Migrate an explicitly saved v3 choice once. An absent legacy boolean uses the new clean default.
+        String key = key(false, "actions");
+        if (!storage.contains(key) && storage.contains(LEGACY_MINIMAL))
+            put(key, bool(LEGACY_MINIMAL, false) ? "COMMENT_ONLY" : "ALL");
+    }
+    static String key(boolean inner, String option) { return "fold_reels_" + (inner ? "inner_" : "cover_") + option; }
+    boolean enabled() { return bool("adaptive_fold_reels", true); }
+    boolean bool(String key, boolean fallback) { try { return storage.getBoolean(key, fallback); } catch (ClassCastException e) { return fallback; } }
+    String string(String key, String fallback) { try { return storage.getString(key, fallback); } catch (ClassCastException e) { return fallback; } }
+    void put(String key, String value) { storage.edit().putString(key, value).apply(); }
+    void put(String key, boolean value) { storage.edit().putBoolean(key, value).apply(); }
+    void crop(boolean inner, boolean value) {
+        storage.edit().putBoolean(inner ? INNER_CROP : COVER_CROP, value)
+                .putString(key(inner, "zoom_v3"), "1").apply();
+    }
+    Profile read(boolean inner) {
+        float zoom = 1;
+        try { zoom = Float.parseFloat(string(key(inner, "zoom_v3"), "1")); } catch (NumberFormatException ignored) {}
+        if (!Float.isFinite(zoom)) zoom = 1;
+        return new Profile(bool(inner ? INNER_CROP : COVER_CROP, !inner), Math.max(1, Math.min(2.5f, zoom)),
+                !inner && bool(IMMERSIVE, true), !inner && bool(TABS, true),
+                bool(key(inner, "edges"), bool(LEGACY_EDGES, true)),
+                choice(FoldReelsControls.Actions.class, string(key(inner, "actions"), inner ? "ALL" : "COMMENT_ONLY"), FoldReelsControls.Actions.ALL),
+                choice(FoldReelsMetadata.Mode.class, string(key(inner, "metadata"), inner ? "FULL" : "COMPACT"), FoldReelsMetadata.Mode.FULL),
+                !inner && bool(key(false, "card"), true), bool(key(inner, "shortcut"), true));
+    }
+    void preset(boolean clean) {
+        storage.edit().putBoolean(COVER_CROP, clean).putString(key(false, "zoom_v3"), "1")
+                .putBoolean(IMMERSIVE, clean).putBoolean(TABS, clean).putBoolean(key(false, "edges"), clean)
+                .putString(key(false, "actions"), clean ? "COMMENT_ONLY" : "ALL")
+                .putString(key(false, "metadata"), clean ? "COMPACT" : "FULL")
+                .putBoolean(key(false, "card"), clean).putBoolean(key(false, "shortcut"), true).apply();
+    }
+    private static <T extends Enum<T>> T choice(Class<T> type, String value, T fallback) {
+        try { return Enum.valueOf(type, value); } catch (IllegalArgumentException | NullPointerException e) { return fallback; }
+    }
+    static final class Profile {
+        final boolean crop, immersive, tabs, edges, card, shortcut; final float zoom;
+        final FoldReelsControls.Actions actions; final FoldReelsMetadata.Mode metadata;
+        Profile(boolean crop, float zoom, boolean immersive, boolean tabs, boolean edges,
+                FoldReelsControls.Actions actions, FoldReelsMetadata.Mode metadata, boolean card, boolean shortcut) {
+            this.crop=crop; this.zoom=zoom; this.immersive=immersive; this.tabs=tabs; this.edges=edges;
+            this.actions=actions; this.metadata=metadata; this.card=card; this.shortcut=shortcut;
+        }
+        int discoveryKey() { return (crop ? 1 : 0) | (tabs ? 2 : 0) | (card ? 4 : 0) | (edges ? 8 : 0) | actions.ordinal()<<4 | metadata.ordinal()<<6; }
+    }
+}
