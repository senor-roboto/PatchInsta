+            for (int i = 0; i < layers.getNumberOfLayers(); i++) {
+                int edge = inspect(layers.getDrawable(i), depth + 1);
+                if (edge < 0) return -1;
+                result |= edge;
+            }
+            return result;
+        }
+        if (!(d instanceof GradientDrawable)) return -1;
+        GradientDrawable g = (GradientDrawable) d;
+        if (g.getShape() != GradientDrawable.RECTANGLE) return -1;
+        int[] colors = g.getColors();
+        // A transparent rectangular stroke is decoration; it is not itself a scrim.
+        if (colors == null || colors.length < 2)
+            return g.getColor() != null && Color.alpha(g.getColor().getDefaultColor()) == 0 ? 0 : -1;
+        if (g.getGradientType() != GradientDrawable.LINEAR_GRADIENT
+                || (g.getOrientation() != GradientDrawable.Orientation.TOP_BOTTOM
+                    && g.getOrientation() != GradientDrawable.Orientation.BOTTOM_TOP)) return -1;
