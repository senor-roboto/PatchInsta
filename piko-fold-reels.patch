diff --git a/tests/fold-reels/FoldReelsPolicyTest.java b/tests/fold-reels/FoldReelsPolicyTest.java
new file mode 100644
index 0000000..ce111df
--- /dev/null
+++ b/tests/fold-reels/FoldReelsPolicyTest.java
@@ -0,0 +1,122 @@
+import app.morphe.extension.instagram.patches.reels.FoldReelsPolicy;
+import app.morphe.extension.instagram.patches.reels.FoldReelsRefreshGate;
+import static app.morphe.extension.instagram.patches.reels.FoldReelsPolicy.WindowKind.*;
+
+/** JVM regression tests. They do not simulate Instagram's renderer or Android lifecycle. */
+public final class FoldReelsPolicyTest {
+    private static int checks;
+    private static void eq(Object expected, Object actual) {
+        checks++;
+        if (!java.util.Objects.equals(expected, actual))
+            throw new AssertionError("Check " + checks + ": expected " + expected + ", got " + actual);
+    }
+    private static Boolean flag(String key, FoldReelsPolicy.WindowKind mode, boolean enabled,
+                                boolean cover, boolean inner) {
+        return FoldReelsPolicy.override(key, mode, enabled, cover, inner);
+    }
+    public static void main(String[] args) {
+        // Illustrative dp windows, NOT claimed Fold8 hardware dimensions.
+        eq(COMPACT, FoldReelsPolicy.classify(420, 900));
+        eq(COMPACT, FoldReelsPolicy.classify(900, 420)); // cover rotation keeps its mode
+        eq(WIDE, FoldReelsPolicy.classify(840, 900));
+        eq(WIDE, FoldReelsPolicy.classify(900, 840));
+        eq(COMPACT, FoldReelsPolicy.classify(599, 900));
+        eq(COMPACT, FoldReelsPolicy.classify(900, 599));
+        eq(WIDE, FoldReelsPolicy.classify(600, 900));
+        eq(WIDE, FoldReelsPolicy.classify(900, 600));
+        eq(COMPACT, FoldReelsPolicy.classify(500, 500));
+        eq(UNKNOWN, FoldReelsPolicy.classify(0, 900));
+        eq(UNKNOWN, FoldReelsPolicy.classify(-1, 900));
+        eq(UNKNOWN, FoldReelsPolicy.classify(Float.NaN, 900));
+        eq(UNKNOWN, FoldReelsPolicy.classify(900, Float.POSITIVE_INFINITY));
+        eq(null, flag("83325::1", UNKNOWN, true, true, false));
+        eq(null, flag("83325::1", null, true, true, false));
+        eq(null, flag(null, WIDE, true, true, false));
+        eq(null, flag("83325::1", WIDE, false, true, false));
+        eq(null, flag("83325", WIDE, true, true, false));
+        eq(null, flag("83325::0", WIDE, true, true, false)); // numeric threshold
+        eq(null, flag("111584::29", WIDE, true, true, false)); // numeric width
+        eq(null, flag("111584::30", WIDE, true, true, false)); // unrelated DMs
+        eq(null, flag("999999::1", WIDE, true, true, false));
+        eq(true, flag("83325::1", COMPACT, true, true, false));
+        eq(false, flag("83325::1", COMPACT, true, false, false));
+        eq(false, flag("83325::1", WIDE, true, true, false));
+        eq(true, flag("83325::3", COMPACT, true, true, false));
+        eq(false, flag("83325::4", COMPACT, true, true, false));
+        eq(null, flag("83325::3", WIDE, true, true, false));
+        eq(true, flag("111584::9", WIDE, true, true, false));
+        eq(false, flag("111584::9", COMPACT, true, true, false));
+        eq(true, flag("111584::27", WIDE, true, true, false));
+        // Inner crop disables the conflicting two-pane/width-change flags.
+        eq(true, flag("83325::1", WIDE, true, true, true));
+        eq(false, flag("111584::9", WIDE, true, true, true));
+        eq(false, flag("55842::0", WIDE, true, true, true));
+        eq(false, flag("55943::0", WIDE, true, true, true));
+        eq(false, flag("83325::1", COMPACT, true, false, true)); // independent cover preference
+        eq(false, FoldReelsPolicy.handles("999999::1"));
+        eq(false, FoldReelsPolicy.handles(null));
+        eq(true, FoldReelsPolicy.handles("83325::1"));
+
+        // First opening must never recreate the Activity.
+        FoldReelsRefreshGate gate = new FoldReelsRefreshGate();
+        gate.observe(COMPACT, 0, false);
+        gate.observe(COMPACT, 100, true);
+        eq(false, gate.ready(1000, true, true, true));
+        // Unfold: debounce, require visible Reels + foreground + enabled switch.
+        gate.observe(WIDE, 1000, true);
+        eq(true, gate.pending());
+        eq(false, gate.ready(1449, true, true, true));
+        eq(false, gate.ready(1450, false, true, true));
+        eq(false, gate.ready(1450, true, false, true));
+        eq(false, gate.ready(1450, true, true, false));
+        eq(true, gate.ready(1450, true, true, true));
+        // A transient unknown configuration must not reset the settled transition.
+        gate.observe(UNKNOWN, 1440, true);
+        eq(true, gate.ready(1450, true, true, true));
+        gate.markRequested();
+        eq(false, gate.pending());
+        eq(false, gate.ready(2000, true, true, true));
+        gate.observe(COMPACT, 2100, true);
+        eq(false, gate.ready(3000, true, true, true)); // no loops in old Activity
+
+        // New Activity starts wide; rotation preserves its mode; closing must refresh once.
+        FoldReelsRefreshGate replacement = new FoldReelsRefreshGate();
+        replacement.observe(WIDE, 2000, false);
+        replacement.observe(WIDE, 2100, true);
+        replacement.observe(FoldReelsPolicy.classify(900, 840), 2200, true);
+        eq(false, replacement.ready(3000, true, true, true));
+        replacement.observe(COMPACT, 4000, true);
+        eq(true, replacement.ready(4450, true, true, true));
+        replacement.markRequested();
+        eq(false, replacement.ready(5000, true, true, true));
+
+        // Aborted fold returns to original mode without recreation.
+        FoldReelsRefreshGate aborted = new FoldReelsRefreshGate();
+        aborted.observe(COMPACT, 0, true);
+        aborted.observe(WIDE, 100, true);
+        aborted.observe(COMPACT, 200, true);
+        eq(false, aborted.pending());
+        eq(false, aborted.ready(1000, true, true, true));
+        // A second actual fold starts a fresh settling interval.
+        aborted.observe(WIDE, 1100, true);
+        eq(false, aborted.ready(1500, true, true, true));
+        eq(true, aborted.ready(1550, true, true, true));
+
+        // Outside Reels, adopt the new mode for future viewers without restarting the app.
+        FoldReelsRefreshGate outside = new FoldReelsRefreshGate();
+        outside.observe(COMPACT, 0, false);
+        outside.observe(WIDE, 1000, false);
+        outside.observe(WIDE, 2000, true);
+        eq(false, outside.ready(3000, true, true, true));
+
+        // Idempotent repeated layout passes do not postpone a stable transition indefinitely.
+        FoldReelsRefreshGate repeat = new FoldReelsRefreshGate();
+        repeat.observe(COMPACT, 0, true);
+        repeat.observe(WIDE, 100, true);
+        repeat.observe(WIDE, 200, true);
+        repeat.observe(WIDE, 500, true);
+        eq(true, repeat.ready(550, true, true, true));
+
+        System.out.println(checks + " policy/transition checks passed (no device validation).");
+    }
+}
