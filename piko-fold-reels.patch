+/** Android view/gesture regression tests. No Instagram decoder or physical-display validation. */
+abstract class FoldReelsTestFixture {
+    Activity activity;
+    FrameLayout content;
+    TestViewer viewer;
+    final ArrayList<FrameLayout> pages = new ArrayList<>();
+    final ArrayList<TextureView> videos = new ArrayList<>();
+    final FoldReelsClipping clipping = new FoldReelsClipping();
+    final AtomicInteger invalidations = new AtomicInteger();
+    final FoldReelsRenderer renderer = new FoldReelsRenderer(invalidations::incrementAndGet);
+    final FoldReelsControls controls = new FoldReelsControls(FoldReelsTestFixture::name);
+    final FoldReelsChrome chrome = new FoldReelsChrome(FoldReelsTestFixture::name);
+
+    static String name(View view) { return view.getTag() instanceof String ? (String) view.getTag() : ""; }
+    static RectF bounds(View view) { RectF rect = new RectF(); FoldReelsViews.bounds(view, rect, new Matrix()); return rect; }
+    static void add(FrameLayout parent, View child, int x, int y, int w, int h) {
+        // A later page layout must preserve measured player dimensions and its native gutters.
+        FrameLayout.LayoutParams params = new FrameLayout.LayoutParams(w, h);
+        params.leftMargin = x; params.topMargin = y;
+        parent.addView(child, params);
+        child.measure(View.MeasureSpec.makeMeasureSpec(w, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(h, View.MeasureSpec.EXACTLY));
+        child.layout(x, y, x + w, y + h);
+    }
+    @Before public void prepare() {
+        activity = Robolectric.buildActivity(Activity.class).setup().visible().get();
+        content = new FrameLayout(activity); activity.setContentView(content);
+        content.measure(View.MeasureSpec.makeMeasureSpec(1000, View.MeasureSpec.EXACTLY), View.MeasureSpec.makeMeasureSpec(1600, View.MeasureSpec.EXACTLY));
+        content.layout(0, 0, 1000, 1600);
+        viewer = new TestViewer(activity); add(content, viewer, 0, 0, 1000, 1400); viewer.controls = controls;
+        for (int index = -1; index <= 1; index++) {
+            FrameLayout page = new FrameLayout(activity); add(viewer, page, 0, index * 1400, 1000, 1400);
+            TextureView video = new TextureView(activity); add(page, video, 106, 0, 788, 1400);
+            pages.add(page); videos.add(video);
+        }
+    }
+    RectF fullViewport() { RectF out = bounds(viewer); out.bottom = out.top + 1600; return out; }
+    void frame(RectF viewport, boolean crop) {
+        clipping.beginFrame(); renderer.frame(viewer, viewport, content, crop, 1, clipping); clipping.endFrame();
+    }
+    void swipe(float distance) {
+        for (int i = 0; i < pages.size(); i++) {
+            int y = Math.round((i - 1) * 1400 - distance);
+            pages.get(i).layout(0, y, 1000, y + 1400);
+        }
+    }
+    RectF displayedClip(TextureView video) {
+        Rect rect = video.getClipBounds(); assertNotNull(rect);
+        RectF result = new RectF(rect); Matrix global = new Matrix(); video.transformMatrixToGlobal(global); global.mapRect(result); return result;
+    }
+
+
+
+
+
+
+
+
+    FrameLayout rail() {
+        FrameLayout narrow = new FrameLayout(activity); add(pages.get(1), narrow, 0, 0, 800, 1400);
+        FrameLayout rail = new FrameLayout(activity); add(narrow, rail, 620, 300, 80, 440);
+        for (int i = 0; i < 4; i++) {
+            View button = new View(activity); button.setTag(new String[]{"clips_like_button", "clips_comment_button", "clips_share_button", "clips_save_button"}[i]);
+            button.setClickable(true); add(rail, button, 0, i * 100, 80, 60);
+        }
+        return rail;
+    }
+    void controlFrame(boolean inner, boolean enabled) {
+        clipping.beginFrame(); controls.frame(viewer, bounds(viewer), inner, enabled, clipping); clipping.endFrame();
+    }
+    void controlMode(FoldReelsControls.Actions actions) {
+        clipping.beginFrame(); controls.frame(viewer, bounds(viewer), false, true, actions, clipping); clipping.endFrame();
+    }
+    long eventTime = 100;
+    MotionEvent touch(int action, float x, float y) { return MotionEvent.obtain(100, ++eventTime, action, x, y, 0); }
+    void send(int action, float x, float y) { MotionEvent event = touch(action, x, y); viewer.dispatchTouchEvent(event); event.recycle(); if (action == MotionEvent.ACTION_UP) Shadows.shadowOf(Looper.getMainLooper()).idle(); }
+    float[] localCentre(View view) { RectF rect = bounds(view); RectF root = bounds(viewer); return new float[]{rect.centerX() - root.left, rect.centerY() - root.top}; }
+
+
+
+
+
+
+
+
+
+    static final class TestViewer extends FrameLayout {
+        FoldReelsControls controls;
+        final ArrayList<Integer> nativeActions = new ArrayList<>();
+        TestViewer(Context context) { super(context); setClickable(true); }
+        @Override public boolean dispatchTouchEvent(MotionEvent event) {
+            if (controls != null && controls.routeTouch(this, event)) return true;
+            nativeActions.add(event.getActionMasked()); return super.dispatchTouchEvent(event);
+        }
+        @Override public boolean onTouchEvent(MotionEvent event) { return true; }
+    }
+}
