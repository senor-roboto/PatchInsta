+    final FoldReelsControls controls = new FoldReelsControls(FoldReelsRuntimeTest::name);
+    final FoldReelsChrome chrome = new FoldReelsChrome(FoldReelsRuntimeTest::name);
+
+    static String name(View view) { return view.getTag() instanceof String ? (String) view.getTag() : ""; }
+    static RectF bounds(View view) { RectF rect = new RectF(); FoldReelsViews.bounds(view, rect, new Matrix()); return rect; }
