+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.view.View;
+import java.lang.ref.WeakReference;
+import java.util.WeakHashMap;
+
+/** Leases for the bytecode-verified, post-children corner/stroke drawing only.
+ * No Paint, radius, native helper, listener or media state is ever overwritten. */
+final class FoldReelsNativeDecoration {
+    static final String CLASS = "com.instagram.ui.widget.roundedcornerlayout.RoundedCornerFrameLayout";
+    private static final WeakHashMap<View, Lease> leases = new WeakHashMap<>();
+
+    static final class Lease {
+        final WeakReference<View> viewer;
+        boolean enabled;
+        long draws, suppressed;
+        Lease(View viewer) { this.viewer = new WeakReference<>(viewer); }
+        void set(View view, boolean value) {
+            if (enabled == value) return;
+            enabled = value;
+            // The native decoration can be in a cached hardware display list.
+            // Invalidate on BOTH acquisition and release, even when layout is unchanged.
+            view.invalidate();
+        }
+    }
+    static Lease acquire(View view, View viewer) {
+        Lease lease = new Lease(viewer); leases.put(view, lease); return lease;
+    }
+    static void release(View view, Lease lease) {
+        lease.set(view, false);
+        if (leases.get(view) == lease) leases.remove(view);
+    }
+    static boolean skip(View view) {
+        Lease lease = leases.get(view);
+        if (lease == null) return false;
+        lease.draws++;
+        View viewer = lease.viewer.get();
+        boolean skip = lease.enabled && viewer != null && view.isAttachedToWindow()
+                && viewer.isShown() && FoldReelsViews.descendant(view, viewer);
+        if (skip) lease.suppressed++;
+        return skip;
+    }
+    private FoldReelsNativeDecoration() {}
+}
diff --git a/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsPolicy.java b/extensions/instagram/src/main/java/app/morphe/extension/instagram/patches/reels/FoldReelsPolicy.java
