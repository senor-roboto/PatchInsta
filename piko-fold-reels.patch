+        p.preset(false);assertFalse(p.read(false).crop);assertFalse(p.read(false).tabs);assertFalse(p.read(false).edges);assertEquals(FoldReelsMetadata.Mode.FULL,p.read(false).metadata);
+        p.preset(true);assertTrue(p.read(false).crop);assertTrue(p.read(false).tabs);assertTrue(p.read(false).card);assertEquals(FoldReelsControls.Actions.COMMENT_ONLY,p.read(false).actions);
+        assertTrue(p.read(true).crop);assertEquals(1.5f,p.read(true).zoom,.001f);
+    }
+    @Test public void malformedModesAndZoomFallBackToNativeSafeValues(){
+        FoldReelsPreferences p=new FoldReelsPreferences(context);p.put(FoldReelsPreferences.key(false,"actions"),"BAD");p.put(FoldReelsPreferences.key(false,"metadata"),"BAD");p.put(FoldReelsPreferences.key(false,"zoom_v3"),"NaN");
+        assertEquals(FoldReelsControls.Actions.ALL,p.read(false).actions);assertEquals(FoldReelsMetadata.Mode.FULL,p.read(false).metadata);assertEquals(1,p.read(false).zoom,.001f);
