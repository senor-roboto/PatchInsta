+                chip = new TextView(activity); chip.setTextSize(12); chip.setTextColor(Color.WHITE);
+                chip.setGravity(Gravity.CENTER); chip.setPadding(dp(activity, 12), 0, dp(activity, 12), 0);
+                chip.setMinHeight(dp(activity, 48)); chip.setMinWidth(dp(activity, 48));
+                GradientDrawable bg = new GradientDrawable(); bg.setColor(0xB0202020); bg.setCornerRadius(dp(activity, 24));
+                chip.setBackground(bg); chip.setElevation(dp(activity, 4));
+                chip.setContentDescription(str("piko_fold_reels_chip_hint"));
+                chip.setTooltipText(str("piko_fold_reels_chip_hint"));
+                chip.setOnClickListener(v -> {
+                    if (recognized) setCrop(wide(), !SharedPref.getBooleanPref(cropSetting(wide())));
+                    else showLayoutOptions(activity);
+                });
+                chip.setOnLongClickListener(v -> { showLayoutOptions(activity); return true; });
+                content.addView(chip, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, dp(activity, 48), Gravity.TOP | Gravity.RIGHT));
+            }
+            void updateChip(Activity activity, View viewer, boolean crop) {
+                if (chip == null) return;
+                int[] a = new int[2], b = new int[2]; viewer.getLocationOnScreen(a); content.getLocationOnScreen(b);
+                int top = Math.max(dp(activity, 8), a[1] - b[1] + dp(activity, 8));
+                WindowInsets insets = content.getRootWindowInsets();
+                if (Build.VERSION.SDK_INT >= 28 && insets != null && insets.getDisplayCutout() != null)
+                    top = Math.max(top, insets.getDisplayCutout().getSafeInsetTop() + dp(activity, 4));
+                FrameLayout.LayoutParams lp = (FrameLayout.LayoutParams) chip.getLayoutParams();
+                int right = dp(activity, 8);
+                if (lp.topMargin != top || lp.rightMargin != right) {
+                    lp.topMargin = top; lp.rightMargin = right; chip.setLayoutParams(lp);
+                }
+            }
+            void stopPresentation() {
+                renderer.restore(); chrome.restore();
+                Activity activity = owner.get(); if (activity != null) bars.restore(activity);
+                if (chip != null && chip.getVisibility() != View.GONE) chip.setVisibility(View.GONE);
+            }
+            void dispose() {
+                stopPresentation(); Activity activity = owner.get();
+                if (activity != null && observersAttached) {
+                    activity.unregisterComponentCallbacks(this);
+                    ViewTreeObserver observer = activity.getWindow().getDecorView().getViewTreeObserver();
+                    if (observer.isAlive()) observer.removeOnPreDrawListener(this);
+                }
+                if (chip != null && chip.getParent() instanceof ViewGroup) ((ViewGroup) chip.getParent()).removeView(chip);
+                chip = null; content = null; viewers.clear();
+            }
+            @Override public void onConfigurationChanged(Configuration config) { capture(); force = true; }
+            @Override public void onLowMemory() {}
+        }
+    }
+}
