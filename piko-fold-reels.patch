+                    && a.getWidth()>0 && f.getWidth()>0 && height()>0 && height()<=inset*7.5f
+                    && width-a.getWidth()-f.getWidth()-inset*2 >= inset*4;
+        }
+        void frame(View row, float left, float bottom, float width, float inset, View viewer, FoldReelsVisibility visibility, FoldReelsClipping clipping) {
+            View a=avatar.view.get(), n=name.view.get(), f=follow.view.get();
