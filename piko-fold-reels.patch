+                            watcher.captureForeground(); watcher.requestFrame(); dialog.dismiss();
+                        }).setNegativeButton(android.R.string.cancel, null).show();
+    }
+
+    private static void confirmRefresh(Activity activity) {
+        new AlertDialog.Builder(activity).setTitle(str("piko_fold_reels_refresh_now"))
+                .setMessage(str("piko_fold_reels_refresh_warning"))
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(str("piko_fold_reels_refresh_confirm"), (dialog, which) -> {
+                    // The ONLY recreation path: an explicit second confirmation, never a fold or preference.
+                    if (!activity.isFinishing() && !activity.isDestroyed()) activity.recreate();
+                }).show();
+    }
+
+    private static void showDiagnostic(Activity activity) {
+        Watcher.Tracker tracker = watcher.trackers.get(activity);
+        StringBuilder report = new StringBuilder("Fold Reels v4\n");
+        Configuration config = activity.getResources().getConfiguration();
+        report.append("windowDp=").append(config.screenWidthDp).append('x').append(config.screenHeightDp)
+                .append(" densityDpi=").append(config.densityDpi).append(" profile=").append(kind)
+                .append(" override=").append(SharedPref.getStringPref("fold_reels_profile_v3", "auto"))
+                .append(" crop=").append(SharedPref.getBooleanPref(cropSetting(wide())))
+                .append(" zoom=").append(zoom(wide())).append('\n');
