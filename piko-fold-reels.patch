+        }
+    }
+    RectF displayedClip(TextureView video) {
+        Rect rect = video.getClipBounds(); assertNotNull(rect);
+        RectF result = new RectF(rect); Matrix global = new Matrix(); video.transformMatrixToGlobal(global); global.mapRect(result); return result;
+    }
+
+
+
+
+
+
+
+
+    FrameLayout rail() {
