+        TextView text = new TextView(activity); text.setText(report); text.setTextIsSelectable(true);
+        text.setTextSize(11); text.setPadding(dp(activity, 16), 0, dp(activity, 16), 0);
+        ScrollView scroll = new ScrollView(activity); scroll.addView(text);
+        new AlertDialog.Builder(activity).setTitle(str("piko_fold_reels_diagnostic")).setView(scroll)
+                .setPositiveButton(str("piko_fold_reels_copy"), (dialog, which) -> {
