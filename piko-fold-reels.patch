+    @Test public void aParentWithACommentCannotBeHiddenEvenIfItsNameMatchesAnOptionalAction() {
+        FrameLayout parent = new FrameLayout(activity); parent.setTag("clips_share_button_container"); add(pages.get(1), parent, 700, 200, 80, 300);
+        View comment = new View(activity); comment.setTag("clips_comment_button"); add(parent, comment, 0, 0, 80, 60);
