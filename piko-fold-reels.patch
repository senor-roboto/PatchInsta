+                .setMessage(str("piko_fold_reels_refresh_warning"))
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(str("piko_fold_reels_refresh_confirm"), (dialog, which) -> {
+                    // The ONLY recreation path: an explicit second confirmation, never a fold or preference.
+                    if (!activity.isFinishing() && !activity.isDestroyed()) activity.recreate();
+                }).show();
+    }
