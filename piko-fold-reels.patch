@@ -0,0 +1,57 @@
+/* Unofficial Piko derivative. GPL-3.0-or-later; retain the root NOTICE. */
+package app.morphe.extension.instagram.patches.reels;
+
+import android.graphics.Rect;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewParent;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.WeakHashMap;
+
+/** Shared frame leases: video and controls cannot restore each other's ancestor clipping. */
+final class FoldReelsClipping {
+    private final WeakHashMap<ViewGroup, State> states = new WeakHashMap<>();
+    private long frame;
+    void beginFrame() { frame++; }
+    void openPath(View leaf, View boundary) {
+        for (ViewParent p = leaf.getParent(); p instanceof ViewGroup && p != boundary; p = p.getParent()) {
+            ViewGroup group = (ViewGroup) p;
+            State state = states.get(group);
+            if (state == null) { state = new State(group); states.put(group, state); }
+            state.used = frame; state.open(group);
+        }
+    }
+    void endFrame() {
+        for (Iterator<Map.Entry<ViewGroup, State>> it = states.entrySet().iterator(); it.hasNext();) {
+            Map.Entry<ViewGroup, State> e = it.next();
+            if (e.getValue().used != frame || !e.getKey().isAttachedToWindow()) { e.getValue().restore(e.getKey()); it.remove(); }
+        }
+    }
+    void restore() {
+        for (Map.Entry<ViewGroup, State> e : states.entrySet()) e.getValue().restore(e.getKey());
+        states.clear();
+    }
+    private static final class State {
+        final boolean children, padding, outline;
+        Rect bounds;
+        long used;
+        State(ViewGroup group) {
+            children = group.getClipChildren(); padding = group.getClipToPadding();
+            outline = group.getClipToOutline(); bounds = group.getClipBounds();
+        }
+        void open(ViewGroup group) {
+            if (group.getClipChildren()) group.setClipChildren(false);
+            if (group.getClipToPadding()) group.setClipToPadding(false);
+            if (group.getClipToOutline()) group.setClipToOutline(false);
+            Rect current = group.getClipBounds();
+            if (current != null) { bounds = current; group.setClipBounds(null); }
+        }
+        void restore(ViewGroup group) {
+            if (!group.getClipChildren()) group.setClipChildren(children);
+            if (!group.getClipToPadding()) group.setClipToPadding(padding);
+            if (!group.getClipToOutline()) group.setClipToOutline(outline);
+            if (group.getClipBounds() == null) group.setClipBounds(bounds);
+        }
+    }
+}
