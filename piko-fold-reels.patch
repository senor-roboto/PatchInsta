+    }
+    String status() { return "tracked=" + states.size() + " tabs=" + tabsHidden; }
+    void restore() { for (Map.Entry<View, State> e : states.entrySet()) e.getValue().restore(e.getKey()); states.clear(); tabsHidden = false; }
+    private static final class State {
+        int seen, visibility;
+        boolean hide, pane, tab, hid, cleared;
